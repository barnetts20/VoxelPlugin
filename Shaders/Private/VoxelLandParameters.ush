// VoxelLandParameters.ush - The land bake's shader inputs (FVoxelLandShaderParameters in
// VoxelLandGPU.h), for passes that evaluate the density. Include before VoxelLandSample.ush,
// VoxelLandGully.ush (which includes VoxelLandHills.ush, VoxelLandNoise.ush and VoxelLandPeaks.ush)
// and VoxelDensitySample.ush.

#ifndef VOXEL_LAND_PARAMETERS_USH
#define VOXEL_LAND_PARAMETERS_USH

uint LandMode;                          // 0 the noise surface, 1 the terrestrial generator
StructuredBuffer<float> LandHeight;     // VoxelLandSample.ush
StructuredBuffer<float2> LandTanTable;
StructuredBuffer<uint> LandFlow;        // f16 log2 m^2, two cells per word (when LandHasFlow)
StructuredBuffer<uint> LandForm;        // the landform, two cells per word (when LandHasForm)
StructuredBuffer<uint> LandRelief;      // the local relief, four cells per word (when LandHasForm)
StructuredBuffer<uint> LandNoise;       // the peaks' noise set (VoxelLandNoise.ush), two words a texel
uint LandN;
uint LandPad;
uint LandHasFlow;
uint LandHasForm;
float LandCellM;                        // a bake cell's arc at the face centre (m)
uint LandWarpOctaves;                   // per warp component, after the detail octaves
float LandWarpInvNorm;
float LandWarpAmplitude;                // cm
float LandDetailAmplitude;              // cm
float2 LandHeightOffset;                // cm (double-float): sea-level heights to heights above PlanetRadius
float LandGullyStrength;                // VoxelLandGully.ush (0: no gullies)
uint LandGullyOctaves;
float LandGullyFlowGain;
float LandGullyDetail;
uint LandGullySeed;
float LandHillRelief;                   // VoxelLandHills.ush (0: no hills)
float2 LandHillFrequency;               // the finest octave's (cycles per cm, double-float)
uint LandHillOctaves;
uint LandHillSeed;
float LandPeakStrength;                 // VoxelLandPeaks.ush (0: no peaks)
float LandPeakTexelsPerCell;
uint LandPeakSeed;
float LandPeakSpacingM;
float LandPeakReliefM;
float LandPeakReliefStart;              // T4b: the peaks' fade-in over the local relief (m)
float LandPeakReliefEnd;
float LandPeakMeanR;
float LandPeakMeanG;
float LandPeakScaleR;
float LandPeakScaleG;
float LandPeakScaleB;
uint LandNoiseN;                        // VoxelLandNoise.ush: the peaks' set (0: none)
uint LandNoiseMips;
uint LandPeakDetailBase;                // the peaks' detail tile (VoxelLandPeaks.ush, T3e)
uint LandPeakDetailN;
uint LandPeakDetailMips;
float LandPeakDetailTexelsPerCell;      // 0: no detail
float LandPeakDetailMeanR;
float LandPeakDetailMeanG;
float LandPeakDetailScaleR;
float LandPeakDetailScaleG;
float LandPeakDetailFade;
float LandHillTexelsPerCell;            // VoxelLandHillSet.ush (T4a; 0: no set, the procedural hills)
uint LandHillBase;
uint LandHillN;
uint LandHillMips;
float LandHillScaleR;
float LandHillScaleG;
float LandHillScaleB;
float LandHillSpacingM;
float LandHillSwellTexelsPerCell;       // 0: no swells
float LandHillSwellM;
float LandHillSwellScaleG;
float LandHillDetailTexelsPerCell;      // 0: no detail
float LandHillDetailScaleR;
float LandHillDetailScaleG;
float LandHillDetailFade;
float LandHillFoothill;                 // T4b: the hill set's growth in the foothills

#endif // VOXEL_LAND_PARAMETERS_USH
