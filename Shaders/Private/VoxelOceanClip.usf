// VoxelOceanClip.usf - The wave clipmap's waves, once a frame (stages O9k, W1; VoxelOceanClip.ush
// has the layout, VoxelOceanPages.cpp runs it): every texel of every level due, the composed sea
// at its sphere point (VoxelOceanFFTEvaluate: the FFT's bands, the shoaling, the shore field's
// and the coastal field's trains and swash, the drain, the thin water, the foam), as a vertex of
// spacing 2 Spacing and a pixel of footprint Spacing see it. What the shore and the terrain give
// a texel is read from the static layer (VoxelOceanClipStatic.usf), written as the windows reached
// it. The first group's threads also write the levels' info for the material.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelOceanWaves.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelOceanClip.ush"

// The info (VoxelOceanClip.ush) as the material and the vertices read it after this pass.
float4 ClipInfoRows[VOXEL_OCEAN_CLIP_INFO_ROWS];
// The levels this dispatch evaluates (its z: ClipDue[z / 4][z % 4], indices of the levels in use)
// and, per level in use, its current window: the camera in it (texels), the spacing (cm), the
// slot; its origin mod Size.
uint4 ClipDue[4];
uint ClipDueCount;
float4 ClipWindow[VOXEL_OCEAN_CLIP_MAX_LEVELS];
int4 ClipWindowMod[VOXEL_OCEAN_CLIP_MAX_LEVELS];

// The static layer (VoxelOceanClipStatic.usf): 4 slices a slot.
Texture2DArray<float4> ClipStatic;

RWTexture2DArray<float4> ClipDisplacementOut;
RWTexture2DArray<float4> ClipNormalOut;
// Stage W3h: the whitecaps' density (x; y spare), as the foam's in the displacement's w.
RWTexture2DArray<float2> ClipWhitecapOut;
RWTexture2D<float4> ClipInfoOut;

// The material's wave parameters for this frame (FVoxelOceanSurface::UpdateMaterial's), from the
// selection camera, and its textures.
float4 ClipParams;
float4 ClipWave0;
float4 ClipWave1;
float4 ClipWave2;
float3 ClipCenter;
float4 ClipShape;
float4 ClipFFT;
float4 ClipRefHigh;
float4 ClipRefLow;
float4 ClipRotation;
float4 ClipTiles;
float4 ClipStates;
float4 ClipSlopeVar;
Texture2DArray ClipDisplacement;
SamplerState ClipDisplacementSampler;
Texture2DArray ClipDerivatives;
SamplerState ClipDerivativesSampler;
Texture2D ClipCharts;
Texture2DArray ClipFoam;
SamplerState ClipFoamSampler;
uint ClipFoamOn;                    // 0: no foam texture (the waves without foam)
// The rings (stage W2; VoxelOceanRingLayout.ush): x their half side (cells), y and z the morph's
// start and end (cells), w their levels (as many as the rings draw; 0: the tile pages).
float4 ClipRing;

// The rings' vertex spacing at a point (cm; stage W3f), from its plane offset from the camera (cm):
// level i's cell G_i = 2 T_i where the finest square that holds it lies, doubling through the
// morph. A function of the point alone, so every level decides the surf's share of the energy as
// the vertices there see it: the levels agree, and the rings' morph from one to the next doesn't
// switch the sea from the trains to the long bands (the "cliff" at a level's edge near shores).
// (The squares about the camera itself, not the snapped ones: a cell's difference at most, the
// same in every level.)
float VoxelOceanClipRingSpacing(FVoxelOceanClipFrame F, float2 Offset)
{
    const int Count = clamp(min(int(F.Count + 0.5f), int(ClipRing.w + 0.5f)), 0, VOXEL_OCEAN_CLIP_MAX_LEVELS);
    const float D = max(abs(Offset.x), abs(Offset.y));
    float G = 0.0f;
    for (int I = 0; I < VOXEL_OCEAN_CLIP_MAX_LEVELS; I++)
    {
        if (I >= Count) break;
        const FVoxelOceanClipLevel L = VoxelOceanClipLevelOf(ClipInfoRows[VOXEL_OCEAN_CLIP_SHARED_ROWS + VOXEL_OCEAN_CLIP_LEVEL_ROWS * I],
            ClipInfoRows[VOXEL_OCEAN_CLIP_SHARED_ROWS + VOXEL_OCEAN_CLIP_LEVEL_ROWS * I + 1]);
        G = 2.0f * L.Spacing;
        const float Cells = D / max(G, 1.0e-3f);
        if (Cells <= ClipRing.x)
        {
            const bool bOuter = I + 1 >= Count;
            const float Morph = bOuter ? 0.0f : saturate((Cells - ClipRing.y) / max(ClipRing.z - ClipRing.y, 1.0e-3f));
            return G * exp2(Morph);
        }
    }
    // Past the outermost ring (the far sphere): twice its cell.
    return 2.0f * G;
}

[numthreads(8, 8, 1)]
void ClipWaveCS(uint3 Id : SV_DispatchThreadID)
{
    if (Id.z == 0u && Id.y == 0u && Id.x < 8u)
    {
        [loop]
        for (uint R = Id.x; R < (uint)VOXEL_OCEAN_CLIP_INFO_ROWS; R += 8u)
            ClipInfoOut[int2(int(R), 0)] = ClipInfoRows[R];
    }
    if (Id.z >= ClipDueCount) return;
    const uint Index = ClipDue[Id.z >> 2u][Id.z & 3u];
    const FVoxelOceanClipFrame F = VoxelOceanClipFrameOf(ClipInfoRows[0], ClipInfoRows[1], ClipInfoRows[2], ClipInfoRows[3]);
    const uint Size = uint(F.Size + 0.5f);
    if (Index >= uint(VOXEL_OCEAN_CLIP_MAX_LEVELS) || Id.x >= Size || Id.y >= Size) return;
    const float4 Window = ClipWindow[Index];
    const int2 OriginMod = ClipWindowMod[Index].xy;
    const float Spacing = Window.z;
    const int Slot = int(Window.w + 0.5f);
    FVoxelOceanWaveParams W = VoxelOceanMakeWaveParamsFFT(ClipParams, ClipWave0, ClipWave1, ClipWave2, ClipCenter, ClipShape, ClipFFT,
        ClipRefHigh, ClipRefLow, ClipRotation, ClipTiles, ClipStates, ClipSlopeVar);
    // The point from the reference (the selection camera), world axes; its radial.
    const float2 Offset = VoxelOceanClipTexelOffset(Window.xy, Spacing, float(Id.x), float(Id.y));
    const float3 X = VoxelOceanClipPointOf(F, Offset);
    // With the rings, the surf decides by their spacing at the point (at least this level's texel,
    // which it can hold), not by this level's own.
    if (ClipRing.w > 0.5f)
        W.SurfSpacing = max(VoxelOceanClipRingSpacing(F, Offset), Spacing);
    const float3 P = VoxelOceanRotate(W.Rotation, X);
    const float3 Up = normalize(P - W.Center);
    const float3 UpP = VoxelOceanRotateBack(W.Rotation, Up);
    const float3 T1 = normalize(F.E1 - UpP * dot(F.E1, UpP));
    const float3 T2 = cross(UpP, T1);
    // As a vertex of twice the spacing (the displacement) and a pixel of the spacing (the normal).
    const float VertexSpacing = 2.0f * Spacing;
    const float Footprint = Spacing;

    // The texel's toroidal place, its static layer.
    const int2 S = int2((OriginMod.x + int(Id.x)) % int(Size), (OriginMod.y + int(Id.y)) % int(Size));
    const float4 S0 = ClipStatic.Load(int4(S, 4 * Slot, 0));
    const float4 S1 = ClipStatic.Load(int4(S, 4 * Slot + 1, 0));
    const float4 S2 = ClipStatic.Load(int4(S, 4 * Slot + 2, 0));
    const float4 S3 = ClipStatic.Load(int4(S, 4 * Slot + 3, 0));
    const float Depth = S0.x;
    FVoxelOceanWaveInput In = VoxelOceanWaveInput(P, VertexSpacing, Footprint, Depth, W);
    FVoxelOceanShore Shore = VoxelOceanShoreNone();
    if (W.States.x > 0.5f)
    {
        const FVoxelOceanCoastLayout CoastLayout = VoxelOceanCoastLayoutOfTable(ClipCharts, max(int(W.FFT.y), 1));
        Shore.Distance = S0.w;
        Shore.Direction = VoxelOceanRotate(W.Rotation, T1 * S1.x + T2 * S1.y);
        Shore.Slope = S2.x;
        Shore.Coast.A = S2.y;
        Shore.Coast.B = S2.z;
        Shore.Coast.Cover = S2.w;
        Shore.Coast.GradA = T1 * S3.x + T2 * S3.y;
        Shore.Coast.GradB = T1 * S3.z + T2 * S3.w;
        Shore.CoastSeedM = CoastLayout.SeedDepthM;
        Shore.CoastReachM = CoastLayout.ReachM;
    }
    Shore.BedSlope = S0.y;
    Shore.BedDepth = S0.z;
    const float2 Rise = float2(S1.z, S1.w);
    Shore.BedRise = dot(Rise, Rise) > 0.25f ? VoxelOceanRotate(W.Rotation, T1 * Rise.x + T2 * Rise.y) : float3(0.0f, 0.0f, 0.0f);
    In.Shore = Shore;

    FVoxelOceanWaveOutput Out;
    if (W.FFT.x > 0.5f)
    {
        const uint Mask = VOXEL_OCEAN_LOOKUP_ALL | (ClipFoamOn != 0u ? VOXEL_OCEAN_LOOKUP_FOAM : 0u);
        const FVoxelOceanFFTPoint Pt = VoxelOceanFFTEvaluate(P, Up, VertexSpacing, Footprint, Depth, In.Shore, W,
            ClipDisplacement, ClipDisplacementSampler, ClipDerivatives, ClipDerivativesSampler, ClipCharts, ClipFoam, ClipFoamSampler, Mask);
        Out = VoxelOceanFFTOutput(Pt, In, W, Mask);
    }
    else
    {
        Out = VoxelOceanWaves(In, W);
    }
    const int3 C = int3(S, Slot);
    ClipDisplacementOut[C] = float4(VoxelOceanRotateBack(W.Rotation, Out.Displacement), saturate(Out.Foam));
    ClipNormalOut[C] = float4(VoxelOceanRotateBack(W.Rotation, Out.Normal), max(Out.SlopeVariance, 0.0f));
    ClipWhitecapOut[C] = float2(saturate(Out.Whitecap), 0.0f);
}
