// VoxelLandPlates.ush - The plate model of the land bake (Design/LandGen.md section 4): warped
// spherical Voronoi plates with Euler-pole motion, boundary profiles at Earth widths and
// heights, and a crust field with abyss, slope, shelf and plains. A pure function of the
// direction, evaluated once per bake cell (VoxelLandBake.usf on the GPU, VoxelLandBake.cpp on
// the CPU when there is no GPU). Ported from the look-test prototype (landproto/plates.py),
// with the changes of the design: smooth fades where the prototype cut off.
//
// Shared subset (VoxelShaderCompat.h). The C++ side includes it inside a struct whose members
// have the names of the inputs below, so it declares no static data (constants are #defines).
// Include after VoxelDensityCore.ush and VoxelCubeSphere.ush, and after declaring:
//
//   StructuredBuffer<float> LandPlates;   8 floats per plate: seed direction (3), continental
//                                          bias, angular velocity (pole times rate, 3), density
//   uint LandPlateCount;
//   uint LandSeed;
//   float LandRadiusM;                     sea-level radius (m)
//   float LandWidthScale;                  landform widths, times Earth's
//   float LandReliefScale;                 landform heights, times Earth's
//   float LandShelfDepth, LandAbyssDepth;  (m, negative)
//   float LandCoastHeight, LandInteriorHeight;   plains at the coast and deep inland (m)

#ifndef VOXEL_LAND_PLATES_USH
#define VOXEL_LAND_PLATES_USH

#include "VoxelLandAccess.ush"

// The prototype's noise (12 edge gradients) has 1.43 times the standard deviation of
// VoxelGradientNoise; its thresholds and weights were tuned on it.
#define VOXEL_LAND_NOISE_SCALE 1.43f
// Soft plate assignment: weights fall off over this distance past a bisector (m, Earth).
#define VOXEL_LAND_BLEND_M 60000.0f
// Boundaries farther than this (m, Earth) contribute nothing; their contribution fades out
// over the last tenth.
#define VOXEL_LAND_REACH_M 1200000.0f
// Seed salts.
#define VOXEL_LAND_SALT_WARP 0x3a1u
#define VOXEL_LAND_SALT_CRUST 0x5c3u
#define VOXEL_LAND_SALT_TEXTURE 0x7e5u
#define VOXEL_LAND_SALT_FORM 0x9a7u
#define VOXEL_LAND_SALT_PROVINCE 0xb39u
// The landform field (VoxelLandFormAt): hill country comes in provinces of about this size
// (m, Earth widths; the noise's thresholds put a fifth to a quarter of the plains in hill
// country, and a quarter to a half flat, more on larger planets' wide interiors), its
// character varies over about this much; range fronts and ranges by the boundary uplift (m).
#define VOXEL_LAND_FORM_PROVINCE_M 700000.0f
#define VOXEL_LAND_FORM_PROVINCE_LO -0.05f
#define VOXEL_LAND_FORM_PROVINCE_HI 0.25f
#define VOXEL_LAND_FORM_CHARACTER_M 400000.0f
#define VOXEL_LAND_FORM_FRONT_LO 60.0f
#define VOXEL_LAND_FORM_FRONT_HI 300.0f
#define VOXEL_LAND_FORM_RANGE_LO 400.0f
#define VOXEL_LAND_FORM_RANGE_HI 1500.0f
// The sedimentary province (VoxelLandProvinceAt, T4c): each plate's cover (a hash: platforms
// against shields, mostly one or the other), varied by a noise of about this size (m, Earth
// widths), and none in the cores of the belts: gone over this much boundary uplift (m, Earth
// heights). Not less: uplifted plateaus are classic strata country (the Colorado Plateau stands
// about 2 km up), and the sample side hands the ranges to the peaks by their relief anyway.
#define VOXEL_LAND_PROVINCE_M 1000000.0f
#define VOXEL_LAND_PROVINCE_PLATE 0.55f
#define VOXEL_LAND_PROVINCE_BELT_LO 1500.0f
#define VOXEL_LAND_PROVINCE_BELT_HI 3500.0f
// Stored in 6 bits (the material's field texture has no more room: VoxelLandMaterialLayout.ush).
#define VOXEL_LAND_PROVINCE_LEVELS 63.0f

// --- Noise -------------------------------------------------------------------------------

/** fBm of VoxelGradientNoise on a float position (a unit direction times a frequency):
 *  gain 0.5, lacunarity 2, normalised by the amplitude sum and scaled to the prototype's. */
VOXEL_FUNC float VoxelLandFbm(float3 P, float Frequency, uint NumOctaves, uint Seed)
{
    float Sum = 0.0f;
    float Norm = 0.0f;
    float Amplitude = 1.0f;
    float F = Frequency;
    for (uint o = 0u; o < NumOctaves; o++)
    {
        const float3 X = P * F;
        const float3 Floor = float3(floor(X.x), floor(X.y), floor(X.z));
        const uint3 Cell = uint3(asuint(int(Floor.x)), asuint(int(Floor.y)), asuint(int(Floor.z)));
        const FVoxelNoiseSample N = VoxelGradientNoise(Cell, X - Floor, Seed + o * 0x9e3779b9u);
        Sum += Amplitude * N.Value;
        Norm += Amplitude;
        Amplitude *= 0.5f;
        F *= 2.0f;
    }
    return Norm > 0.0f ? Sum / Norm * VOXEL_LAND_NOISE_SCALE : 0.0f;
}

// The profile warp (Design/SurfaceLook.md, T1b): the boundary distance's contours bend by about
// this much (m, Earth widths), over wavelengths from this (m) down to a quarter. Without it a
// belt's flanks are planes between bisectors, and their rivers run straight and parallel.
// Kept small: where the continental warp already nearly folds (its Jacobian's determinant
// falls to 0.007), more warp folds it (a fold mirrors the contours over a sliver): at 30 km
// 0.015% of the sphere, at 50 km 0.05% (Tools/LandSolveHarness/look_harness.cpp, WarpFolds).
#ifndef VOXEL_LAND_PROFILE_WARP_M
#define VOXEL_LAND_PROFILE_WARP_M 30000.0f
#endif
#ifndef VOXEL_LAND_PROFILE_WARP_WAVELENGTH_M
#define VOXEL_LAND_PROFILE_WARP_WAVELENGTH_M 240000.0f
#endif

/** The plates' domain warp: a vector fBm offset of the direction (hides the Voronoi
 *  polygons; the boundary profiles are measured from the warped point too), back on the unit
 *  sphere. Two parts: the continental one (0.12 rad, 2.5 per radian), and the profile warp in
 *  metres at Earth widths, which bends the profiles' contours at the scale of a range. */
VOXEL_FUNC float3 VoxelLandWarp(VOXEL_LAND_ARGS_DECL float3 P)
{
    const float WX = VoxelLandFbm(P + float3(3.1f, 0.0f, 0.0f), 2.5f, 4u, LandSeed + VOXEL_LAND_SALT_WARP + 1u);
    const float WY = VoxelLandFbm(P + float3(0.0f, 7.7f, 0.0f), 2.5f, 4u, LandSeed + VOXEL_LAND_SALT_WARP + 2u);
    const float WZ = VoxelLandFbm(P + float3(0.0f, 0.0f, 1.9f), 2.5f, 4u, LandSeed + VOXEL_LAND_SALT_WARP + 3u);
    float3 Offset = float3(WX, WY, WZ) * 0.12f;
    if (VOXEL_LAND_PROFILE_WARP_M > 0.0f)
    {
        const float Frequency = LandRadiusM / (VOXEL_LAND_PROFILE_WARP_WAVELENGTH_M * max(LandWidthScale, 0.01f));
        const float Amount = VOXEL_LAND_PROFILE_WARP_M * max(LandWidthScale, 0.01f) / max(LandRadiusM, 1.0f);
        const float DX = VoxelLandFbm(P + float3(5.3f, 1.1f, 0.0f), Frequency, 3u, LandSeed + VOXEL_LAND_SALT_WARP + 4u);
        const float DY = VoxelLandFbm(P + float3(0.0f, 2.9f, 6.1f), Frequency, 3u, LandSeed + VOXEL_LAND_SALT_WARP + 5u);
        const float DZ = VoxelLandFbm(P + float3(8.3f, 0.0f, 4.7f), Frequency, 3u, LandSeed + VOXEL_LAND_SALT_WARP + 6u);
        Offset = Offset + float3(DX, DY, DZ) * Amount;
    }
    return normalize(P + Offset);
}

// --- Plates ------------------------------------------------------------------------------

VOXEL_FUNC float3 VoxelLandPlateSeed(VOXEL_LAND_ARGS_DECL uint Plate)
{
    return float3(VOXEL_LAND_PLATE(Plate * 8u), VOXEL_LAND_PLATE(Plate * 8u + 1u), VOXEL_LAND_PLATE(Plate * 8u + 2u));
}

VOXEL_FUNC float VoxelLandPlateBias(VOXEL_LAND_ARGS_DECL uint Plate)
{
    return VOXEL_LAND_PLATE(Plate * 8u + 3u);
}

VOXEL_FUNC float3 VoxelLandPlateOmega(VOXEL_LAND_ARGS_DECL uint Plate)
{
    return float3(VOXEL_LAND_PLATE(Plate * 8u + 4u), VOXEL_LAND_PLATE(Plate * 8u + 5u), VOXEL_LAND_PLATE(Plate * 8u + 6u));
}

VOXEL_FUNC float VoxelLandPlateDensity(VOXEL_LAND_ARGS_DECL uint Plate)
{
    return VOXEL_LAND_PLATE(Plate * 8u + 7u);
}

/** The plate whose seed is nearest the warped direction W. */
VOXEL_FUNC uint VoxelLandNearestPlate(VOXEL_LAND_ARGS_DECL float3 W)
{
    uint Best = 0u;
    float BestDot = -2.0f;
    for (uint q = 0u; q < LandPlateCount; q++)
    {
        const float D = dot(W, VoxelLandPlateSeed(VOXEL_LAND_ARGS q));
        if (D > BestDot)
        {
            BestDot = D;
            Best = q;
        }
    }
    return Best;
}

/** Crust value before the threshold: the plate's continental tendency plus low-frequency
 *  noise, so coasts don't follow plate edges. The bake's threshold is the quantile of this
 *  over the sphere that leaves the continental fraction above it. */
VOXEL_FUNC float VoxelLandRawCrust(VOXEL_LAND_ARGS_DECL float3 P, uint Plate)
{
    return 0.45f * VoxelLandPlateBias(VOXEL_LAND_ARGS Plate) + VoxelLandFbm(P, 1.6f, 5u, LandSeed + VOXEL_LAND_SALT_CRUST);
}

/** A plate's sedimentary cover, 0 (a shield: crystalline basement at the surface) .. 1 (a
 *  platform or basin: flat-lying sedimentary rock), from a hash of the plate and the seed; most
 *  plates lean one way (smoothstep of a uniform value). */
VOXEL_FUNC float VoxelLandPlateCover(VOXEL_LAND_ARGS_DECL uint Plate)
{
    const float U = float(VoxelHash(uint3(Plate, 0u, 0u), LandSeed + VOXEL_LAND_SALT_PROVINCE) >> 8u) * (1.0f / 16777216.0f);
    return smoothstep(0.2f, 0.8f, U);
}

/** Continental fraction 0..1 of direction P as plate Plate's crust. */
VOXEL_FUNC float VoxelLandCrust(VOXEL_LAND_ARGS_DECL float3 P, uint Plate, float Threshold)
{
    return saturate((VoxelLandRawCrust(VOXEL_LAND_ARGS P, Plate) - Threshold) / 0.08f + 0.5f);
}

/** The crust the boundary profiles weigh their pairings by: the raw crust's two coarsest octaves
 *  (normalised as the full five, so its threshold crossing follows the continents' outline).
 *  The full crust's finer octaves draw the coastline; with them in the weights, a coastline
 *  crossing a belt cut its uplift (up to 5.5 km) off within a few kilometres, a cliff into the
 *  sea where the range ended (Design/SurfaceLook.md, T3f). With the outline alone a belt tapers
 *  over tens of kilometres and runs on past a fine-scale coastline as headlands and islands. */
VOXEL_FUNC float VoxelLandBeltCrust(VOXEL_LAND_ARGS_DECL float3 P, uint Plate, float Threshold)
{
    float Sum = 0.0f;
    float Amplitude = 1.0f;
    float F = 1.6f;
    for (uint o = 0u; o < 2u; o++)
    {
        const float3 X = P * F;
        const float3 Floor = float3(floor(X.x), floor(X.y), floor(X.z));
        const uint3 Cell = uint3(asuint(int(Floor.x)), asuint(int(Floor.y)), asuint(int(Floor.z)));
        const FVoxelNoiseSample N = VoxelGradientNoise(Cell, X - Floor, LandSeed + VOXEL_LAND_SALT_CRUST + o * 0x9e3779b9u);
        Sum += Amplitude * N.Value;
        Amplitude *= 0.5f;
        F *= 2.0f;
    }
    // The five octaves' norm: 1 + 1/2 + 1/4 + 1/8 + 1/16.
    const float Raw = 0.45f * VoxelLandPlateBias(VOXEL_LAND_ARGS Plate) + Sum * (1.0f / 1.9375f) * VOXEL_LAND_NOISE_SCALE;
    return saturate((Raw - Threshold) / 0.08f + 0.5f);
}

/** Hypsometry from the continental fraction: abyss, slope, shelf, plains rising inland
 *  (bimodal, like Earth's). Continuous in C. Below the shelf, the depth follows the larger of
 *  C and the continents' outline (CO, VoxelLandBeltCrust): the coastline's fine octaves move
 *  the shore, but the continental slope only where the outline turns oceanic too, so bays and
 *  fine-scale shores stand on shelf, and a range the shore cuts runs out over shallow water
 *  instead of dropping kilometres to the abyss within a cell (Design/SurfaceLook.md, T3f). */
VOXEL_FUNC float VoxelLandBaseElevation(VOXEL_LAND_ARGS_DECL float C, float CO)
{
    if (C >= 0.5f)
        return LandCoastHeight + (LandInteriorHeight - LandCoastHeight) * (C - 0.5f) * 2.0f;
    if (C >= 0.42f)
        return LandShelfDepth + (LandCoastHeight - LandShelfDepth) * (C - 0.42f) / 0.08f;
    const float D = max(C, min(CO, 0.42f));
    if (D >= 0.25f)
    {
        const float T = smoothstep(0.25f, 0.42f, D);
        return LandAbyssDepth + (LandShelfDepth - LandAbyssDepth) * T;
    }
    return LandAbyssDepth - 600.0f * LandReliefScale * (0.25f - D) / 0.25f;
}

VOXEL_FUNC float VoxelLandGauss(float X, float Mu, float W)
{
    const float T = (X - Mu) / W;
    return exp(-T * T);
}

struct FVoxelLandProfile
{
    float Up;      // uplift (m, >= 0)
    float Down;    // depression (m, >= 0)
    uint Class;    // 0 none, 1 collision, 2 arc range, 3 trench, 4 island arc, 5 rift, 6 ridge
};

/** Elevation change at Dist (m, on the point's own side) from a boundary with convergence
 *  Conv (positive toward each other), own crust C1 and the other side's C2. The four crust
 *  pairings blend by smooth crust weights, and the strength ramps in smoothly from zero
 *  convergence, so nothing switches or creases. Earth widths (km) times LandWidthScale, heights (m) times
 *  LandReliefScale. */
VOXEL_FUNC FVoxelLandProfile VoxelLandBoundaryProfile(VOXEL_LAND_ARGS_DECL float Dist, float Conv, float C1, float C2, float OwnDensity, float OtherDensity)
{
    const float Km = Dist / (1000.0f * LandWidthScale);
    // Strength from the convergence rate; quadratic near zero, so a profile fades in and out
    // with zero slope where the convergence changes sign (no crease along that line).
    const float S = smoothstep(0.0f, 1.2f, abs(Conv));
    const float W1 = smoothstep(0.35f, 0.65f, C1);
    const float W2 = smoothstep(0.35f, 0.65f, C2);
    const float WCC = W1 * W2;
    const float WCO = W1 * (1.0f - W2);
    const float WOC = (1.0f - W1) * W2;
    const float WOO = (1.0f - W1) * (1.0f - W2);

    FVoxelLandProfile Out;
    Out.Up = 0.0f;
    Out.Down = 0.0f;
    Out.Class = 0u;
    if (Conv > 0.0f)
    {
        // Convergent: collision belt and plateau, an Andes-like range over a trench, the
        // trench, and an island arc (ocean-ocean: the denser plate subducts).
        const float Collision = 5500.0f * VoxelLandGauss(Km, 60.0f, 110.0f) + 1800.0f * VoxelLandGauss(Km, 250.0f, 200.0f);
        const float Arc = 4500.0f * VoxelLandGauss(Km, 180.0f, 90.0f) + 1200.0f * VoxelLandGauss(Km, 320.0f, 160.0f);
        const float Trench = 3500.0f * VoxelLandGauss(Km, 45.0f, 35.0f);
        const float Island = 3800.0f * VoxelLandGauss(Km, 150.0f, 45.0f);
        const float Sub = OwnDensity > OtherDensity ? 1.0f : 0.0f;
        Out.Up = S * (WCC * Collision + WCO * Arc + WOO * (1.0f - Sub) * Island);
        Out.Down = S * (WOC * Trench + WOO * Sub * Trench);
        // The dominant pairing (first of equals, as the prototype's argmax).
        uint K = 0u;
        float Best = WCC;
        if (WCO > Best) { Best = WCO; K = 1u; }
        if (WOC > Best) { Best = WOC; K = 2u; }
        if (WOO > Best) { Best = WOO; K = 3u; }
        Out.Class = K == 3u && Sub > 0.5f ? 3u : K + 1u;
    }
    else
    {
        // Divergent: a continental rift (graben with shoulders), or a mid-ocean ridge.
        const float RiftDown = 1200.0f * VoxelLandGauss(Km, 0.0f, 35.0f);
        const float RiftUp = 900.0f * VoxelLandGauss(Km, 70.0f, 45.0f);
        const float RidgeUp = 2200.0f * VoxelLandGauss(Km, 0.0f, 300.0f);
        const float RidgeDown = 400.0f * VoxelLandGauss(Km, 0.0f, 12.0f);
        Out.Up = S * (WCC * RiftUp + (1.0f - W1) * RidgeUp);
        Out.Down = S * (WCC * RiftDown + (1.0f - W1) * RidgeDown);
        Out.Class = WCC > (1.0f - W1) ? 5u : 6u;
        if (S < 0.04f)
            Out.Class = 0u;
    }
    Out.Up *= LandReliefScale;
    Out.Down *= LandReliefScale;
    return Out;
}

struct FVoxelLandOwnParts
{
    float Crust;
    float Outline;   // VoxelLandBeltCrust
    float Up;
    float Down;
    uint Class;
};

/** As plate Own's point (unwarped P, warped W): its crust, and every neighbouring boundary's
 *  profile, uplifts and depressions combined by a soft maximum (p = 4). */
VOXEL_FUNC FVoxelLandOwnParts VoxelLandPartsForOwn(VOXEL_LAND_ARGS_DECL float3 P, float3 W, uint Own, float Threshold)
{
    const float3 SeedOwn = VoxelLandPlateSeed(VOXEL_LAND_ARGS Own);
    const float T1 = acos(clamp(dot(W, SeedOwn), -1.0f, 1.0f));
    const float C1 = VoxelLandCrust(VOXEL_LAND_ARGS P, Own, Threshold);
    const float B1 = VoxelLandBeltCrust(VOXEL_LAND_ARGS P, Own, Threshold);
    const float3 V1 = cross(VoxelLandPlateOmega(VOXEL_LAND_ARGS Own), P);
    const float Reach = VOXEL_LAND_REACH_M * max(LandWidthScale, 1.0f);

    float Up4 = 0.0f;
    float Down4 = 0.0f;
    float Best = 50.0f;   // a boundary class only where its profile is at least this tall (m)
    uint Class = 0u;
    for (uint q = 0u; q < LandPlateCount; q++)
    {
        if (q == Own) continue;
        const float3 SeedQ = VoxelLandPlateSeed(VOXEL_LAND_ARGS q);
        const float TQ = acos(clamp(dot(W, SeedQ), -1.0f, 1.0f));
        const float Dist = 0.5f * (TQ - T1) * LandRadiusM;   // positive on Own's side
        if (abs(Dist) >= Reach) continue;
        const float Fade = 1.0f - smoothstep(0.9f * Reach, Reach, abs(Dist));

        // The bisector's normal in the tangent plane at P, toward q.
        float3 N = SeedQ - SeedOwn;
        N = N - P * dot(N, P);
        const float NL = length(N);
        if (NL < 1.0e-12f) continue;
        N = N * (1.0f / NL);
        const float Conv = dot(V1 - cross(VoxelLandPlateOmega(VOXEL_LAND_ARGS q), P), N);

        // The other side's crust, at the point mirrored across the bisector.
        const float3 M = normalize(P + N * (2.0f * Dist / LandRadiusM));
        const float B2 = VoxelLandBeltCrust(VOXEL_LAND_ARGS M, q, Threshold);

        const FVoxelLandProfile Profile = VoxelLandBoundaryProfile(VOXEL_LAND_ARGS max(Dist, 0.0f), Conv, B1, B2, VoxelLandPlateDensity(VOXEL_LAND_ARGS Own), VoxelLandPlateDensity(VOXEL_LAND_ARGS q));
        const float Up = Profile.Up * Fade;
        const float Down = Profile.Down * Fade;
        Up4 += Up * Up * Up * Up;
        Down4 += Down * Down * Down * Down;
        if (Up + Down > Best)
        {
            Best = Up + Down;
            Class = Profile.Class;
        }
    }

    FVoxelLandOwnParts Out;
    Out.Crust = C1;
    Out.Outline = B1;
    Out.Up = sqrt(sqrt(Up4));
    Out.Down = sqrt(sqrt(Down4));
    Out.Class = Class;
    return Out;
}

struct FVoxelLandElevation
{
    float Base;    // hypsometry of the crust plus low-relief texture (m)
    float Up;      // boundary uplift (m)
    float Down;    // boundary depression (m)
    float Crust;   // continental fraction 0..1
    float Cover;   // the plates' sedimentary cover (VoxelLandPlateCover), blended as the crust
    uint Class;    // dominant boundary class of the nearest plate
    uint Plate;    // nearest plate
};

/** The plate fields of direction P (unit). The point's plate is a soft assignment over the
 *  three nearest plates, each weighted by how far past its bisector the point lies, less the
 *  fourth's weight, so nothing jumps where the nearest plates change order. */
VOXEL_FUNC FVoxelLandElevation VoxelLandElevationAt(VOXEL_LAND_ARGS_DECL float3 P, float Threshold)
{
    const float3 W = VoxelLandWarp(VOXEL_LAND_ARGS P);

    // The four nearest plates (largest dot); only the fourth's distance is needed.
    uint K0 = 0u, K1 = 0u, K2 = 0u;
    float D0 = -3.0f, D1 = -3.0f, D2 = -3.0f, D3 = -3.0f;
    for (uint q = 0u; q < LandPlateCount; q++)
    {
        const float D = dot(W, VoxelLandPlateSeed(VOXEL_LAND_ARGS q));
        if (D > D0) { D3 = D2; D2 = D1; K2 = K1; D1 = D0; K1 = K0; D0 = D; K0 = q; }
        else if (D > D1) { D3 = D2; D2 = D1; K2 = K1; D1 = D; K1 = q; }
        else if (D > D2) { D3 = D2; D2 = D; K2 = q; }
        else if (D > D3) { D3 = D; }
    }
    const float T0 = acos(clamp(D0, -1.0f, 1.0f));
    const float Scale = 0.5f * LandRadiusM / (VOXEL_LAND_BLEND_M * LandWidthScale);
    // The floor every kept weight is measured from: the fourth plate's weight (zero when there
    // are fewer than four), and at least 1e-3 so far plates are skipped without a jump.
    float Floor = 1.0e-3f;
    if (LandPlateCount >= 4u)
    {
        const float X3 = (acos(clamp(D3, -1.0f, 1.0f)) - T0) * Scale;
        Floor = max(Floor, exp(-X3 * X3));
    }

    float WSum = 0.0f;
    float Crust = 0.0f;
    float Outline = 0.0f;
    float Up = 0.0f;
    float Down = 0.0f;
    float Cover = 0.0f;
    uint Class = 0u;
    for (uint r = 0u; r < 3u && r < LandPlateCount; r++)
    {
        const uint K = r == 0u ? K0 : (r == 1u ? K1 : K2);
        const float DK = r == 0u ? D0 : (r == 1u ? D1 : D2);
        const float X = (acos(clamp(DK, -1.0f, 1.0f)) - T0) * Scale;
        const float Weight = exp(-X * X) - Floor;
        if (Weight <= 0.0f) continue;
        const FVoxelLandOwnParts Parts = VoxelLandPartsForOwn(VOXEL_LAND_ARGS P, W, K, Threshold);
        Crust += Weight * Parts.Crust;
        Outline += Weight * Parts.Outline;
        Up += Weight * Parts.Up;
        Down += Weight * Parts.Down;
        Cover += Weight * VoxelLandPlateCover(VOXEL_LAND_ARGS K);
        if (r == 0u)
            Class = Parts.Class;
        WSum += Weight;
    }

    FVoxelLandElevation Out;
    if (WSum <= 1.0e-6f)
    {
        // Four plates equidistant at one point (a measure-zero case): the nearest alone.
        const FVoxelLandOwnParts Parts = VoxelLandPartsForOwn(VOXEL_LAND_ARGS P, W, K0, Threshold);
        Crust = Parts.Crust;
        Outline = Parts.Outline;
        Up = Parts.Up;
        Down = Parts.Down;
        Cover = VoxelLandPlateCover(VOXEL_LAND_ARGS K0);
        Class = Parts.Class;
        WSum = 1.0f;
    }
    Out.Crust = Crust / WSum;
    Out.Up = Up / WSum;
    Out.Down = Down / WSum;
    Out.Cover = Cover / WSum;
    Out.Class = Class;
    Out.Plate = K0;
    // Low-relief continental texture, and abyssal hills (weaker), blended across the coast.
    const float TextureWeight = lerp(0.4f, 1.0f, smoothstep(0.45f, 0.55f, Out.Crust));
    Out.Base = VoxelLandBaseElevation(VOXEL_LAND_ARGS Out.Crust, Outline / WSum)
        + 250.0f * LandReliefScale * TextureWeight * VoxelLandFbm(P, 6.0f, 5u, LandSeed + VOXEL_LAND_SALT_TEXTURE);
    return Out;
}

/** The landform at direction P (unit) whose plate fields are E (Design/SurfaceLook.md, T2): the
 *  hilliness H (0 flat plains .. 1 hill country) and the character C (0 smooth, rolling ..
 *  1 rough-topped), for the hills layer (VoxelLandHills.ush) and the erosion's plains relief
 *  (VoxelLandSolve.ush).
 *   - Provinces: hill country and flat plains alternate in regions of several hundred
 *     kilometres (a low-frequency noise), rolling ground between.
 *   - Range fronts: where the boundary uplift starts (a hundred to a few hundred metres, rift
 *     shoulders too) the plains are hillier: foothills.
 *   - Inside the ranges (uplift above about a kilometre) a middling value: the peaks layer
 *     (T3) shapes them.
 *   - Low coastal plains are flatter.
 *  The character follows its own noise, rougher toward the ranges. */
VOXEL_FUNC float2 VoxelLandFormAt(VOXEL_LAND_ARGS_DECL float3 P, FVoxelLandElevation E)
{
    const float Height = E.Base + E.Up - E.Down;
    const float Width = max(LandWidthScale, 0.01f);
    const float Mountain = smoothstep(VOXEL_LAND_FORM_RANGE_LO, VOXEL_LAND_FORM_RANGE_HI, E.Up);
    const float Front = smoothstep(VOXEL_LAND_FORM_FRONT_LO, VOXEL_LAND_FORM_FRONT_HI, E.Up) * (1.0f - Mountain);
    const float Province = smoothstep(VOXEL_LAND_FORM_PROVINCE_LO, VOXEL_LAND_FORM_PROVINCE_HI,
        VoxelLandFbm(P, LandRadiusM / (VOXEL_LAND_FORM_PROVINCE_M * Width), 3u, LandSeed + VOXEL_LAND_SALT_FORM));
    const float Plains = saturate(Province + 0.6f * Front * (1.0f - Province));
    const float Coast = lerp(0.4f, 1.0f, smoothstep(30.0f, 400.0f, Height));
    const float Hilliness = lerp(Plains, 0.45f, Mountain) * Coast;
    const float Character = saturate(0.5f + 2.0f * VoxelLandFbm(P, LandRadiusM / (VOXEL_LAND_FORM_CHARACTER_M * Width), 3u,
        LandSeed + VOXEL_LAND_SALT_FORM + 1u) + 0.3f * Front + 0.3f * Mountain);
    return float2(Hilliness, Character);
}

/** The sedimentary province at direction P (unit) whose plate fields are E (Design/NonMountainLand.md,
 *  T4c): 0 crystalline .. 1 flat-lying sedimentary rock, where the strata set (mesas, cuestas,
 *  badlands) replaces the hills (VoxelLandHillSet.ush; the sample side picks the share of the
 *  land by a threshold on this). Platforms and basins away from the active belts:
 *   - each plate's cover (a shield or a platform), blended across the plates as the crust;
 *   - a noise of about a thousand kilometres, so a plate's interior varies;
 *   - none in the belts' cores (boundary uplift from 1.5 to 3.5 km at Earth heights), where
 *     the great ranges are (lower belts keep it: the sample side hands their relief to the
 *     peaks by the local relief).
 *  The sea's cells get a value too (the sample side fades every layer out at the coast). */
VOXEL_FUNC float VoxelLandProvinceAt(VOXEL_LAND_ARGS_DECL float3 P, FVoxelLandElevation E)
{
    const float Width = max(LandWidthScale, 0.01f);
    const float Noise = saturate(0.5f + VoxelLandFbm(P, LandRadiusM / (VOXEL_LAND_PROVINCE_M * Width), 3u, LandSeed + VOXEL_LAND_SALT_PROVINCE));
    const float Cover = VOXEL_LAND_PROVINCE_PLATE * E.Cover + (1.0f - VOXEL_LAND_PROVINCE_PLATE) * Noise;
    const float Relief = max(LandReliefScale, 0.01f);
    return Cover * (1.0f - smoothstep(VOXEL_LAND_PROVINCE_BELT_LO * Relief, VOXEL_LAND_PROVINCE_BELT_HI * Relief, E.Up));
}

/** Packs a province (FVoxelLandBake::Province: 0 .. 63; VoxelLandUnpackProvince reads it). */
VOXEL_FUNC uint VoxelLandPackProvince(float Province)
{
    return uint(saturate(Province) * VOXEL_LAND_PROVINCE_LEVELS + 0.5f);
}

/** Packs a landform (FVoxelLandBake::Form: the hilliness in the low byte, the character in the
 *  high byte; VoxelLandUnpackForm reads it). */
VOXEL_FUNC uint VoxelLandPackForm(float2 Form)
{
    return uint(saturate(Form.x) * 255.0f + 0.5f) | (uint(saturate(Form.y) * 255.0f + 0.5f) << 8u);
}

/** Packs a cell's attributes: crust fraction (8 bits), boundary class (3 bits at bit 8). */
VOXEL_FUNC uint VoxelLandPackAttr(float Crust, uint Class)
{
    return uint(saturate(Crust) * 255.0f + 0.5f) | ((Class & 7u) << 8u);
}

#endif // VOXEL_LAND_PLATES_USH
