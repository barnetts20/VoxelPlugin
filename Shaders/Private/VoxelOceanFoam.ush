// VoxelOceanFoam.ush - The ocean's foam (stage W3v; Design/OceanWaves.md section 47): GodotOceanWaves'
// foam (2Retr0, its fft_unpack.glsl, water.gdshader and wave_generator.gd; Tessendorf's foam), run
// where a clipmap ocean runs it (Crest: a foam simulation on the wave clipmap's levels). Shared
// subset (VoxelShaderCompat.h): the wave clipmap's step (VoxelOceanClip.usf), the waves' evaluation
// (VoxelOceanWaves.ush: the fresh foam without a history), the own pass (VoxelOceanPixelClip.ush,
// VoxelOceanSurfacePass.usf) and the checks (Tools/OceanHarness/foam_check.cpp) run it.
//
// THE RULE (Godot's, per texel and frame): where the surface is compressed past the whitecap
// threshold (its area ratio J = det(I + chop grad D) under Whitecap), foam grows by how far past it
// is; everywhere it decays exponentially; it stays within 0 and 1 / 0.75:
//   dFoam/dt = max(Whitecap - J, 0) Grow - Decay Foam,
// integrated exactly over each step (Godot adds Grow dt and multiplies by e^(-Decay dt): the same to
// first order, but its steady state moves with the frame rate; this one's doesn't):
//   Foam' = Foam e^(-Decay dt) + Source (Grow / Decay) (1 - e^(-Decay dt)),
// with Godot's rates from its one handle, the foam amount A (wave_generator.gd): Grow = 7.5 A and
// Decay = 1.15 max(0.5, 10 - A) per second. A crest breaking again and again builds a patch that
// thins as it fades; a single one leaves a trail.
// DRAWN (water.gdshader): smoothstep(0, 1, 0.75 Foam), the share of the surface white.
//
// WHERE (unlike Godot): Godot keeps the foam in each cascade's own tile, from that cascade's own J:
// its cascades each hold the whole spectrum from their tile down, so each one's J is nearly the
// surface's. Ours split the spectrum into four bands of wavelength (each holds its own, so their sum
// is the sea): a band's J alone seldom comes near the threshold (on the emulated cascades under 1%
// of any band's texels fall under 0.75, against a few percent of the summed surface's; foam_check),
// and where it does it isn't where the sea's crests break. So the rule runs on the wave clipmap's levels
// (world space: the composed sea's J at each texel, as Crest's foam does), the surf's breaking fed
// into the same buffer (the bores' faces, their short wake and the swash's edge: Source below).
// Without a buffer (the material without the clipmap, the underwater pass), the fresh foam: the
// rule's steady state for the compression now, Source Grow / Decay.

#ifndef VOXEL_OCEAN_FOAM_USH
#define VOXEL_OCEAN_FOAM_USH

#ifndef VOXEL_FUNC
#define VOXEL_FUNC
#endif

// Godot's gain on the foam before its smoothstep (water.gdshader's foam_factor).
#define VOXEL_OCEAN_FOAM_GAIN 0.75f
// Godot's rates per unit of the foam amount (wave_generator.gd: foam_grow_rate, foam_decay_rate).
#define VOXEL_OCEAN_FOAM_GROW_PER_AMOUNT 7.5f
#define VOXEL_OCEAN_FOAM_DECAY_SCALE 1.15f
#define VOXEL_OCEAN_FOAM_DECAY_FROM 10.0f
#define VOXEL_OCEAN_FOAM_DECAY_LEAST 0.5f
// The most foam a texel holds: 1 / GAIN, so foam built up all the way draws solid. (Godot clamps
// each cascade's foam to 1 and sums its foamy cascades, which reach past 1 / 0.75 together; ours is
// one buffer.)
#define VOXEL_OCEAN_FOAM_MAX (1.0f / VOXEL_OCEAN_FOAM_GAIN)

// The rule's rates (per second) for a foam amount (Godot's 0 to 10).
VOXEL_FUNC float VoxelOceanFoamGrowRate(float Amount)
{
    return VOXEL_OCEAN_FOAM_GROW_PER_AMOUNT * max(Amount, 0.0f);
}

VOXEL_FUNC float VoxelOceanFoamDecayRate(float Amount)
{
    return VOXEL_OCEAN_FOAM_DECAY_SCALE * max(VOXEL_OCEAN_FOAM_DECAY_LEAST, VOXEL_OCEAN_FOAM_DECAY_FROM - max(Amount, 0.0f));
}

// The compression past the threshold (Godot's foam_factor before its rate): J the area ratio.
VOXEL_FUNC float VoxelOceanFoamSource(float J, float Whitecap)
{
    return max(Whitecap - J, 0.0f);
}

// One step: Keep = e^(-Decay dt), GrowDt = (Grow / Decay) (1 - Keep) (the exact step's growth per
// unit of source; Grow dt to first order, Godot's); Source the open sea's compression past the
// threshold plus the surf's foam (0 to 1). Within 0 and VOXEL_OCEAN_FOAM_MAX.
VOXEL_FUNC float VoxelOceanFoamStep(float Foam, float Source, float GrowDt, float Keep)
{
    return clamp(Foam * Keep + max(Source, 0.0f) * GrowDt, 0.0f, VOXEL_OCEAN_FOAM_MAX);
}

// The rule's steady state under a constant source (Source Grow / Decay, at most 1): the fresh foam
// where there is no buffer, a new texel's start, the whitecaps (the breaking now). FreshGain: Grow /
// Decay.
VOXEL_FUNC float VoxelOceanFoamFresh(float Source, float FreshGain)
{
    return clamp(max(Source, 0.0f) * FreshGain, 0.0f, VOXEL_OCEAN_FOAM_MAX);
}

// The drawn foam (0 to 1): Godot's smoothstep(0, 1, 0.75 Foam).
VOXEL_FUNC float VoxelOceanFoamDrawn(float Foam)
{
    const float X = clamp(VOXEL_OCEAN_FOAM_GAIN * Foam, 0.0f, 1.0f);
    return X * X * (3.0f - 2.0f * X);
}

#endif // VOXEL_OCEAN_FOAM_USH
