// VoxelUnderwaterPass.usf - The underwater pass (FVoxelUnderwaterViewExtension): for every pixel
// of a view's rect, the scene colour seen through the water (VoxelUnderwater.ush), written to a
// copy of the scene colour. Runs ahead of depth of field, after the atmosphere's composite.
//
// With the FFT model a first pass (UnderwaterMapCS) writes the surface map around the view's
// camera (VoxelUnderwaterMap.ush): one thread per grid point, the wave hook's inversion with the
// level's texel as its footprint. UnderwaterCS then reads it.
//
// The foam (stage O9c): the map pass also writes the foam of the surface above each point (the
// inversion's last lookup reads the foam too, VOXEL_OCEAN_LOOKUP_FOAM, at the converged point)
// into a second array; UnderwaterCS covers what the ray sees through the surface by it
// (VoxelUnderwater.ush, step 6).
//
// The shore (stage O8): the map's waves shoal and slow as the drawn surface's do, with the depth
// from the ocean's depth probe (VoxelOceanDepthProbe.h: nested grids of the terrain's depth around
// the selection camera, read bilinearly, blended across levels; deep water past them) and the
// shore field's texture.
//
// The pixel's ray comes from the view's jittered clip space (the depth buffer's), through
// UnderwaterClipToCamera: clip to view, then the view's rotation back to world axes, so a point
// comes out relative to the view's camera. That clip space is linear in device z along a pixel,
// so the near plane (device z 1, reversed z) and the scene point (the depth buffer's device z)
// are the same transform; device z 0 (the sky) has no finite point.
//
// Parameter names must match FVoxelUnderwaterParameters exactly.

#include "/Engine/Private/Common.ush"

// The surface map (VoxelUnderwaterMap.ush): read by UnderwaterCS, written by UnderwaterMapCS.
Texture2DArray<float> UnderwaterMap;
RWTexture2DArray<float> UnderwaterMapOut;
// Per level: the anchor from the camera (xyz) and the texel (w); the plane's axes. The level count
// comes from the compile environment (VoxelUnderwaterMap::Levels).
#ifndef VOXEL_UNDERWATER_MAP_LEVELS
#define VOXEL_UNDERWATER_MAP_LEVELS 5
#endif
float4 UnderwaterMapAnchor[VOXEL_UNDERWATER_MAP_LEVELS];
float4 UnderwaterMapE1[VOXEL_UNDERWATER_MAP_LEVELS];
float4 UnderwaterMapE2[VOXEL_UNDERWATER_MAP_LEVELS];

#define VOXEL_UNDERWATER_MAP_LOAD(Level, X, Y) UnderwaterMap.Load(int4(X, Y, Level, 0))
// The foam map (stage O9c): read by UnderwaterCS, written by UnderwaterMapCS; the foam's colour
// as the ray sees it from below (rgb, linear scene units before exposure; a: 0 off).
Texture2DArray<float> UnderwaterFoamMap;
RWTexture2DArray<float> UnderwaterFoamMapOut;
float4 UnderwaterFoamColor;
#define VOXEL_UNDERWATER_MAP_FOAM_LOAD(Level, X, Y) UnderwaterFoamMap.Load(int4(X, Y, Level, 0))
#define VOXEL_UNDERWATER_FOAM_COLOR float4(UnderwaterFoamColor.rgb * View.PreExposure, UnderwaterFoamColor.a)
#define VOXEL_UNDERWATER_MAP_ANCHOR(Level) UnderwaterMapAnchor[Level].xyz
#define VOXEL_UNDERWATER_MAP_TEXEL(Level) UnderwaterMapAnchor[Level].w
#define VOXEL_UNDERWATER_MAP_E1(Level) UnderwaterMapE1[Level].xyz
#define VOXEL_UNDERWATER_MAP_E2(Level) UnderwaterMapE2[Level].xyz

// The shore (stage O8): the depth probe (levels: the anchor from the camera, world axes, and the
// spacing in w; the plane's axes), UnderwaterProbeOn 0 without one. Ahead of the wave hook: its
// inversion reads the depth at each step's point through it (VOXEL_OCEAN_HEIGHT_DEPTH).
StructuredBuffer<float> UnderwaterProbe;
float4 UnderwaterProbeAnchor[4];
float4 UnderwaterProbeE1[4];
float4 UnderwaterProbeE2[4];
uint UnderwaterProbeOn;

// VOXEL_OCEAN_DEEP (VoxelOceanWaves.ush, included below).
#define VOXEL_UNDERWATER_PROBE_DEEP 1.0e30f

// The depth probe's grids (VoxelOceanDepthProbe.h: 4 levels of 64^2).
#define VOXEL_UNDERWATER_PROBE_LEVELS 4
#define VOXEL_UNDERWATER_PROBE_SIZE 64
// The bed's unknown slope and the least known one (VOXEL_OCEAN_BED_UNKNOWN,
// VOXEL_OCEAN_SURF_BED_KNOWN; stage O9b2).
#define VOXEL_UNDERWATER_BED_UNKNOWN (-1.0e4f)
#define VOXEL_UNDERWATER_BED_KNOWN (-1000.0f)
// A level fades out over its last texels (as the map's levels).
#define VOXEL_UNDERWATER_PROBE_BLEND 4.0f

// The probe's plane Plane (0 the depth the waves feel, cm; 1 the bed's slope, stage O9b2) at X
// (from the camera): the finest probe level covering it, blended outward at each level's edge;
// Outside past them (or without a probe). A slope next to an unknown one (VOXEL_OCEAN_BED_UNKNOWN)
// is unknown.
float VoxelUnderwaterProbeAt(float3 X, uint Plane, float Outside)
{
    if (UnderwaterProbeOn == 0u) return Outside;
    const uint PlaneBase = Plane * uint(VOXEL_UNDERWATER_PROBE_LEVELS * VOXEL_UNDERWATER_PROBE_SIZE * VOXEL_UNDERWATER_PROBE_SIZE);
    float Depth = 0.0f;
    float Rest = 1.0f;
    const float Centre = 0.5f * float(VOXEL_UNDERWATER_PROBE_SIZE) - 0.5f;
    const float Last = float(VOXEL_UNDERWATER_PROBE_SIZE) - 1.0f;
    [loop]
    for (int Level = 0; Level < VOXEL_UNDERWATER_PROBE_LEVELS; Level++)
    {
        const float3 D = X - UnderwaterProbeAnchor[Level].xyz;
        const float Spacing = UnderwaterProbeAnchor[Level].w;
        const float2 P = float2(dot(D, UnderwaterProbeE1[Level].xyz) / Spacing + Centre, dot(D, UnderwaterProbeE2[Level].xyz) / Spacing + Centre);
        const float Cover = saturate(min(min(P.x, P.y), min(Last - P.x, Last - P.y)) / VOXEL_UNDERWATER_PROBE_BLEND);
        if (Cover <= 0.0f) continue;
        const float2 B = floor(P);
        const int2 T = int2(B);
        const float2 F = P - B;
        const uint Base = PlaneBase + uint(Level) * uint(VOXEL_UNDERWATER_PROBE_SIZE * VOXEL_UNDERWATER_PROBE_SIZE);
        const uint Row = uint(VOXEL_UNDERWATER_PROBE_SIZE);
        const uint I00 = Base + uint(T.y) * Row + uint(T.x);
        const float D00 = UnderwaterProbe[I00];
        const float D10 = UnderwaterProbe[I00 + 1u];
        const float D01 = UnderwaterProbe[I00 + Row];
        const float D11 = UnderwaterProbe[I00 + Row + 1u];
        if (Plane != 0u && min(min(D00, D10), min(D01, D11)) <= VOXEL_UNDERWATER_BED_KNOWN) return VOXEL_UNDERWATER_BED_UNKNOWN;
        Depth += Rest * Cover * lerp(lerp(D00, D10, F.x), lerp(D01, D11, F.x), F.y);
        Rest *= 1.0f - Cover;
        if (Rest <= 0.0f) break;
    }
    // Past every level: Outside; in the coarsest level's fading ring, its value alone.
    if (Rest >= 1.0f) return Outside;
    return Depth / (1.0f - Rest);
}

// The depth the waves feel (cm) at X: deep (VOXEL_OCEAN_DEEP) past the probe.
float VoxelUnderwaterProbeDepth(float3 X)
{
    return VoxelUnderwaterProbeAt(X, 0u, VOXEL_UNDERWATER_PROBE_DEEP);
}

// The bed's slope at X (stage O9b2): unknown past the probe.
float VoxelUnderwaterProbeBed(float3 X)
{
    return VoxelUnderwaterProbeAt(X, 1u, VOXEL_UNDERWATER_BED_UNKNOWN);
}

#define VOXEL_OCEAN_HEIGHT_DEPTH(X, Depth) VoxelUnderwaterProbeDepth(X)
#define VOXEL_OCEAN_HEIGHT_BED(X, Bed) VoxelUnderwaterProbeBed(X)

#include "/Plugin/VoxelPlugin/Private/VoxelUnderwater.ush"

Texture2D<float4> UnderwaterSceneColor;
Texture2D<float> UnderwaterSceneDepth;
uint2 UnderwaterViewMin;
uint2 UnderwaterViewSize;
float4x4 UnderwaterClipToCamera;

float3 UnderwaterCenter;
float2 UnderwaterSphere;
float UnderwaterWaveAmplitude;
float4 UnderwaterWave0;
float4 UnderwaterWave1;
float4 UnderwaterWave2;
float4 UnderwaterShape;
// The FFT model (VoxelOceanWaves.ush, FVoxelOceanWaveParams; zero without it).
float4 UnderwaterFFT;
float4 UnderwaterRefHigh;
float4 UnderwaterRefLow;
float4 UnderwaterRotation;
float4 UnderwaterTiles;
float4 UnderwaterStates;
float4 UnderwaterSlopeVar;
Texture2DArray UnderwaterDisplacement;
SamplerState UnderwaterDisplacementSampler;
Texture2DArray UnderwaterDerivatives;
SamplerState UnderwaterDerivativesSampler;
Texture2D UnderwaterCharts;
// The shore (stage O8): the shore field's texture (the depth probe's parameters are above).
Texture2DArray UnderwaterShore;
// The open sea's foam (stage O9c: the cascades' VoxelOceanFoam), for the map pass; UnderwaterFoamOn
// 0: no foam (the foam map holds zeros).
Texture2DArray UnderwaterFoam;
SamplerState UnderwaterFoamSampler;
uint UnderwaterFoamOn;
// The shore field's texel-space expansion around this view's camera (VoxelOceanShore.ush).
float4 UnderwaterShoreFrame[7];

float3 UnderwaterAbsorption;
float3 UnderwaterScattering;
float3 UnderwaterLight;
float4 UnderwaterMeniscus;

RWTexture2D<float4> UnderwaterOutput;

FVoxelOceanWaveParams VoxelUnderwaterWaveParams()
{
    return VoxelOceanMakeWaveParamsFFT(float4(0.0f, 0.0f, UnderwaterWaveAmplitude, 0.0f),
        UnderwaterWave0, UnderwaterWave1, UnderwaterWave2, UnderwaterCenter, UnderwaterShape,
        UnderwaterFFT, UnderwaterRefHigh, UnderwaterRefLow, UnderwaterRotation, UnderwaterTiles, UnderwaterStates, UnderwaterSlopeVar);
}

// One map point per thread: x, y the grid point, z the level. Its surface height above the
// sphere along its radial (the inversion with the level's texel as footprint, the probe's depth
// there and the shore field; the last lookup the displacement only).
[numthreads(VOXEL_UNDERWATER_THREADS, VOXEL_UNDERWATER_THREADS, 1)]
void UnderwaterMapCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= uint2(VOXEL_UNDERWATER_MAP_SIZE, VOXEL_UNDERWATER_MAP_SIZE)) || DispatchThreadId.z >= VOXEL_UNDERWATER_MAP_LEVELS) return;
    const int Level = int(DispatchThreadId.z);
    const float Texel = UnderwaterMapAnchor[Level].w;
    const float3 X = VoxelUnderwaterMapPoint(UnderwaterMapAnchor[Level].xyz, Texel, UnderwaterMapE1[Level].xyz, UnderwaterMapE2[Level].xyz,
        int(DispatchThreadId.x), int(DispatchThreadId.y));
    const FVoxelOceanWaveParams Waves = VoxelUnderwaterWaveParams();
    const FVoxelOceanShoreFrame Frame = VoxelOceanShoreFrameFrom(UnderwaterShoreFrame[0], UnderwaterShoreFrame[1], UnderwaterShoreFrame[2],
        UnderwaterShoreFrame[3], UnderwaterShoreFrame[4], UnderwaterShoreFrame[5], UnderwaterShoreFrame[6]);
    // The last lookup reads the foam too (stage O9c): the foam of the surface above X, at the
    // converged point, with the level's texel as footprint. Stage W3p: and the whitecaps (the
    // breaking crests and the surf's bores), which need the surface's slopes (the full lookup).
    const uint Mask = UnderwaterFoamOn != 0u ? (VOXEL_OCEAN_LOOKUP_ALL | VOXEL_OCEAN_LOOKUP_FOAM) : VOXEL_OCEAN_LOOKUP_DISPLACEMENT;
    FVoxelOceanWaveOutput Surface;
    const float Above = VoxelOceanHeightAtFFTShore(X, UnderwaterSphere, Waves, UnderwaterDisplacement, UnderwaterDisplacementSampler,
        UnderwaterDerivatives, UnderwaterDerivativesSampler, UnderwaterCharts, UnderwaterShore, UnderwaterFoam, UnderwaterFoamSampler, Frame,
        VoxelUnderwaterProbeDepth(X), Mask, Texel, Surface);
    const float Height = VoxelOceanSphereHeight(X, UnderwaterSphere.x, UnderwaterSphere.y, normalize(-Waves.Center));
    UnderwaterMapOut[DispatchThreadId] = Height - Above;
    UnderwaterFoamMapOut[DispatchThreadId] = UnderwaterFoamOn != 0u ? max(Surface.Foam, Surface.Whitecap) : 0.0f;
}

[numthreads(VOXEL_UNDERWATER_THREADS, VOXEL_UNDERWATER_THREADS, 1)]
void UnderwaterCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (any(DispatchThreadId.xy >= UnderwaterViewSize)) return;
    const uint2 Pixel = UnderwaterViewMin + DispatchThreadId.xy;
    const float4 Scene = UnderwaterSceneColor[Pixel];
    const float DeviceZ = UnderwaterSceneDepth[Pixel];

    // The pixel centre in clip space (y up).
    const float2 UV = (float2(DispatchThreadId.xy) + 0.5f) / float2(UnderwaterViewSize);
    const float2 Clip = float2(2.0f * UV.x - 1.0f, 1.0f - 2.0f * UV.y);

    // The near plane's point and the scene's, from the camera.
    const float4 NearH = mul(float4(Clip, 1.0f, 1.0f), UnderwaterClipToCamera);
    const float4 SceneH = mul(float4(Clip, DeviceZ, 1.0f), UnderwaterClipToCamera);
    const float NearLength = max(length(NearH.xyz), 1.0e-20f);
    const float3 Dir = NearH.xyz / NearLength;
    const float NearDistance = NearLength / max(NearH.w, 1.0e-20f);
    const float SceneDistance = SceneH.w > 0.0f ? length(SceneH.xyz) / SceneH.w : VOXEL_UNDERWATER_FAR;

    // The water's light and the meniscus in the scene colour's (pre-exposed) units.
    const float PreExposure = View.PreExposure;
    const FVoxelOceanWaveParams Waves = VoxelUnderwaterWaveParams();
    const float3 Color = VoxelUnderwaterColor(Scene.rgb, Dir, NearDistance, SceneDistance, UnderwaterSphere, Waves,
        UnderwaterDisplacement, UnderwaterDisplacementSampler, UnderwaterDerivatives, UnderwaterDerivativesSampler, UnderwaterCharts,
        UnderwaterAbsorption, UnderwaterScattering, UnderwaterLight * PreExposure,
        float4(UnderwaterMeniscus.rgb * PreExposure, UnderwaterMeniscus.w));
    UnderwaterOutput[Pixel] = float4(Color, Scene.a);
}
