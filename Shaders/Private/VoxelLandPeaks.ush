// VoxelLandPeaks.ush - The peaks layer of the terrestrial generator (Design/SurfaceLook.md, T3,
// reworked in T3d to the surface paradigm: one lookup of a baked set): summits, aretes, faces and
// the valleys between them on the bake's mountains, below its resolution. The bake alone rounds
// every range off at its cells (1.5 km on a 1,000 km planet, 10 km on Earth): its crests are
// smooth and its summits merge.
//
// The shape: one B-spline lookup (VoxelLandNoise.ush) of the `peaks` set
// (Design/NoiseTiles2D_Addendum2.md): a periodic mountain tile eroded offline, so its peaks sit
// at valley junctions, its faces at threshold slopes. Its channels:
//   R  the eroded height, hard (crystalline) rock: steep, sharp aretes
//   G  the same tile eroded as soft (sedimentary) rock: rounded summits and ridges
//   B  R blurred (the gullies' steering: they run down it)
//   A  R's flow accumulation (not read yet)
// The landform's character blends R and G (they share their valleys and peaks). Heights are in
// the set's mip-0 texels, so placing a texel at TexelM metres keeps the simulated slopes;
// LandPeakStrength scales that. Zero-mean (each channel's mean over mip 0 is subtracted; box
// mips keep it): summits rise above the bake's crest, valleys cut below it, and a coarse mip
// (a coarse footprint) flattens towards zero.
//
// The amplitude: the set's own relief (m) x LandPeakStrength, on mountains only (local relief
// from LandPeakReliefStart to LandPeakReliefEnd, 500 to 1500 m by default), never more than the bake's local relief (smaller ranges get gentler
// peaks), on the crests and upper slopes (faded out as the drainage gathers: valleys keep the
// bake's floors), and inland.
//
// The detail (T3e; N1: the planet's detail set): the set holds about a massif spacing's texels
// over 128, so its finest valleys are hundreds of metres across and closer up it's smooth
// B-spline lumps. A second lookup, of the pack's detail set (a `detail*` set, or the generated
// stand-in in its layout: Design/NoiseTiles2D_Handoff.md section 6; hard rock its G, a ridged
// multifractal, soft rock its R, an fbm, each scaled on the CPU to texel heights at a fixed RMS
// slope) at its own finer placement and turn, adds to the shape: the same character blend, the
// same amplitude (so it lives where the peaks do), its height over the peaks' relief fixed on
// the CPU (LandPeakDetailScaleHard, Soft) so strength 1 keeps its own slopes. Band-limited by
// its own mip level (coarser than the set's rule), faded out over the levels below
// LandPeakDetailFade (where its coarsest octave averages away) and skipped beyond.
//
// The lattice: face-local like the gullies' (VoxelLandGully.ush): the set's texel coordinate is
// the face's angle from its centre in cells (an integer and a fraction) times the set's texels
// per cell, turned by one of 8 angles per face (exactly: VoxelDFTwoProd), and each face picks
// one of the tile's 8 orientations and an offset. Within 3 bake cells of a face edge the faces'
// lookups blend, and the gradient includes the blend weights' own slope.
//
// Shared subset (VoxelShaderCompat.h). Included by VoxelLandGully.ush (after VoxelLandSample.ush
// and VoxelLandNoise.ush); its inputs, declared by the host:
//
//   float LandPeakStrength;       the height over the set's own (1: its simulated slopes; 0: none)
//   float LandPeakTexelsPerCell;  the set's mip-0 texels per bake cell (0: no peaks)
//   uint LandPeakSeed;
//   float LandPeakSpacingM;       the set's massif spacing (m): the steering's wavelength
//   float LandPeakReliefM;        the larger of R's and G's ranges (decode Max - Min) in metres
//   float LandPeakReliefStart;    the local relief (m) over which they fade in (T4b: settings)
//   float LandPeakReliefEnd;
//   float LandPeakMeanR;          R's and G's means over mip 0 (unit values)
//   float LandPeakMeanG;
//   float LandPeakScaleR;         R's, G's and B's ranges over the larger of R's and G's
//   float LandPeakScaleG;
//   float LandPeakScaleB;
//   uint LandNoiseN, LandNoiseMips;  the set's chain (at the buffer's start; VoxelLandNoise.ush's
//                                    LandNoise holds it)
//   uint LandDetailBase;             the detail set's chain: its first texel in LandNoise,
//   uint LandDetailN;                size and mips
//   uint LandDetailMips;
//   float LandPeakDetailTexelsPerCell;  its mip-0 texels per bake cell (0: no detail)
//   float LandDetailMeanHard;        its G's (hard rock) and R's (soft rock) means over mip 0
//   float LandDetailMeanSoft;        (unit values)
//   float LandPeakDetailScaleHard;   their unit values to the shape's unit (strength x range x
//   float LandPeakDetailScaleSoft;   texel over the peaks' relief)
//   float LandPeakDetailFade;        the mip level by which it has faded out
//   float LandGullyStrength; uint LandGullyOctaves;   whether the gullies read the steering
//                                    (VoxelLandGully.ush's; without them it isn't looked up)
//
// THE GLACIAL LAYER (stage T5d, Design/LandClimate.md): the `glacial` set (the peaks' layout: R the
// bedrock carved by ice, troughs, cirques, horns and fjord beds; G the ice surface over it; B R
// blurred, A its flow) takes the peaks' place where the climate snapshot puts glaciers, now or at
// the last glacial maximum (LandGlacialCooling C colder): the share carved, Past, from the
// glacier's equilibrium line at the bake's height (VoxelLandClimateGlacierMargin). The two layers'
// amplitudes go by 1 - Past and Past over the root of their squares (the variance kept through
// the switch); the glacial layer's R (bare bedrock) gives way to G (the ice) by the share iced now,
// Now (its character, with its gradient through the bake's slope: the ice line runs along the
// contours). Its amplitude is the peaks' rule from the glacial set's relief, with a lower coast
// fade (troughs reach the sea: fjords). Its inputs:
//   LandClimate, LandHasClimate, LandClimateLapse   the climate (VoxelLandClimateAccess.ush)
//   float LandGlacialTexelsPerCell;  the set's mip-0 texels per bake cell (0: none)
//   uint LandGlacialBase, LandGlacialN, LandGlacialMips;   its chain in LandNoise
//   float LandGlacialScaleR, LandGlacialScaleG, LandGlacialScaleB;   as the peaks'
//   float LandGlacialMeanR, LandGlacialMeanG;
//   float LandGlacialReliefM;        its larger range in metres
//   float LandGlacialStrength;       its height scale
//   uint LandGlacialSeed;
//   float LandGlacialSpacingM;       its trough spacing (the steering's wavelength)
//   float LandGlacialCooling;        C: the glacial maximum's cooling
//   float LandGlacialDetailScaleHard, LandGlacialDetailScaleSoft;   the peaks' detail set over its
//                                    relief (at the peaks' detail placement and fade)

#ifndef VOXEL_LAND_PEAKS_USH
#define VOXEL_LAND_PEAKS_USH

#include "VoxelLandAccess.ush"
#include "VoxelLandClimateAccess.ush"

#ifndef VOXEL_LOOP
#define VOXEL_LOOP [loop]
#endif

// The local relief (m) over which the peaks fade in (mountains, not plains) is
// LandPeakReliefStart .. LandPeakReliefEnd since T4b (default 500 .. 1500; T3 used 250 .. 900).
// The drainage (log2 m^2 above a cell's own area) over which they fade out: crests and upper
// slopes keep them, valleys (from about 45 cells' drainage) keep the bake's floors.
#define VOXEL_LAND_PEAK_CREST_START 1.5f
#define VOXEL_LAND_PEAK_CREST_END 5.5f
// The bake height (m) over which they fade in from the coast.
#define VOXEL_LAND_PEAK_COAST_START 2.0f
#define VOXEL_LAND_PEAK_COAST_END 40.0f
// The face blend band (bake cells), as the gullies'.
#define VOXEL_LAND_PEAK_BAND_CELLS 3.0f
// The detail's mip level against the footprint (0.5: texels about 1.4 footprints), and the levels
// over which it fades out below LandPeakDetailFade (spread so no mesh level change takes much of
// it at once; T3e's 1024 tile at 400 m: its RMS height 10 m at a 1 m footprint, 9 at 25 m, 4 at
// 50 m, 0.4 at 100 m, 0 from 150 m; a 2048 set's fade level is one higher, its texels half the
// size, so the same in metres). Plain defines: every host must use the same.
#define VOXEL_LAND_PEAK_DETAIL_LEVEL_BIAS 0.5f
#define VOXEL_LAND_PEAK_DETAIL_FADE_LEVELS 3.0f
// T5d: the glacial layer's half-width (C) about the equilibrium line (the shares' ramps), and the
// bake height (m) over which it fades in from the coast (from sea level, not the peaks' 2 m: its
// troughs reach the sea, fjords; over a little more, its walls being taller).
#define VOXEL_LAND_GLACIAL_WIDTH 2.0f
#define VOXEL_LAND_GLACIAL_COAST_START 0.0f
#define VOXEL_LAND_GLACIAL_COAST_END 50.0f

/** The peaks at a point: Unit the shape (zero-mean, within -1 .. 1 over the larger of R's and
 *  G's ranges, plus the detail's: VoxelLand::PeakReach; Height = Unit x AmplitudeM),
 *  AmplitudeM (m), Gradient the shape's gradient times the amplitude (m/m, a tangent vector: the
 *  amplitude's own change left out, as the hills'), Steer the blurred channel's gradient times
 *  the amplitude (the gullies run down that), Curve its local curvature (1/m: large at the
 *  aretes and the valleys, where the steering turns) and Lambda the massif spacing (m), for the
 *  gullies (VoxelLandGully.ush: they fade where their steering turns within their wavelength). */
struct FVoxelLandPeaks
{
    float Unit;
    float AmplitudeM;
    float3 Gradient;
    float3 Steer;
    float Curve;
    float Lambda;
};

/** Whether the planet has peaks (a set, a placement, a landform). */
VOXEL_FUNC bool VoxelLandPeaksOn(VOXEL_LAND_ARGS_DECL float Dummy)
{
    return LandPeakStrength > 0.0f && LandPeakTexelsPerCell > 0.0f && LandNoiseN != 0u && LandHasForm != 0u;
}

/** The amplitude (m) from the local relief (m), the drainage (log2 m^2; used when LandHasFlow)
 *  and the bake height (m). */
VOXEL_FUNC float VoxelLandPeakAmplitude(VOXEL_LAND_ARGS_DECL float Relief, float Flow, float Bake)
{
    float A = LandPeakStrength * min(LandPeakReliefM, Relief) * smoothstep(LandPeakReliefStart, LandPeakReliefEnd, Relief)
        * smoothstep(VOXEL_LAND_PEAK_COAST_START, VOXEL_LAND_PEAK_COAST_END, Bake);
    if (LandHasFlow != 0u)
        A *= 1.0f - smoothstep(VOXEL_LAND_PEAK_CREST_START, VOXEL_LAND_PEAK_CREST_END, Flow - 2.0f * log2(LandCellM));
    return max(A, 0.0f);
}

/** A face axis's coordinate in bake cells from the face centre, (J + 0.5 - N / 2) + Frac, as an
 *  exact half-integer (a float holding it) and the fraction. */
struct FVoxelLandPeakCoord
{
    float Whole;
    float Part;
};

VOXEL_FUNC FVoxelLandPeakCoord VoxelLandPeakCoordAt(VOXEL_LAND_ARGS_DECL FVoxelLandAxis Axis)
{
    FVoxelLandPeakCoord Out;
    Out.Whole = float(2 * Axis.Cell + 1 - int(LandN)) * 0.5f;
    Out.Part = Axis.Frac;
    return Out;
}

/** A face's lattice rotation (cos, sin of 0.37 + 1.13 i + 0.618 i^2), as literals so every host
 *  uses the same floats (they multiply large numbers exactly: VoxelDFTwoProd). */
VOXEL_FUNC float2 VoxelLandPeakRotation(uint Index)
{
    if (Index == 0u) return float2(0.932327330f, 0.361615419f);
    if (Index == 1u) return float2(-0.520301223f, 0.853982806f);
    if (Index == 2u) return float2(0.379828602f, -0.925056875f);
    if (Index == 3u) return float2(-0.994723022f, 0.102597110f);
    if (Index == 4u) return float2(-0.597863436f, 0.801597953f);
    if (Index == 5u) return float2(-0.867247880f, 0.497876555f);
    if (Index == 6u) return float2(-0.432379663f, -0.901691675f);
    return float2(0.650245965f, 0.759723723f);
}

/** RU x CU + RV x CV (cells times texels per cell: texels) as an integer and a fraction: the
 *  whole parts' products exact, so the texel is right at any distance from the face centre. */
VOXEL_FUNC FVoxelLandNoiseAxis VoxelLandPeakRotated(FVoxelLandPeakCoord CU, FVoxelLandPeakCoord CV, float RU, float RV)
{
    const float2 L = VoxelDFAdd(VoxelDFAdd(VoxelDFTwoProd(RU, CU.Whole), VoxelDFTwoProd(RV, CV.Whole)),
        float2(RU * CU.Part + RV * CV.Part, 0.0f));
    const FVoxelLatticeSplit Split = VoxelDFLatticeSplit(L);
    FVoxelLandNoiseAxis Out;
    Out.I = Split.Cell;
    Out.F = Split.Frac;
    return Out;
}

/** A baked set's layer (T4a: the peaks' lookup made general, so the hills take it too): which
 *  chain, its placement (mip-0 texels per bake cell; a texel is LandCellM over that), the seed
 *  and salts of the faces' turns, orientations and offsets, R's and G's means and R's, G's and
 *  B's scales (unit values to the layer's unit), R's and G's means over mip 0 for the face blend
 *  (BlendMeanR, BlendMeanG: unit values; as MeanR and MeanG for a zero-mean layer, the peaks'),
 *  the mip level against the footprint (texels about 2^-LevelBias footprints), and the detail
 *  set's (DetailTexelsPerCell 0: none; its means and scales hard rock's, G, and soft rock's, R). */
struct FVoxelLandSetLayer
{
    FVoxelLandNoiseSetRef Set;
    float TexelsPerCell;
    uint Seed;
    uint Kind;              // the faces' hash: uint3(Face, Kind, Salt)
    uint SaltA;
    uint SaltB;
    float MeanR;
    float MeanG;
    float ScaleR;
    float ScaleG;
    float ScaleB;
    float BlendMeanR;
    float BlendMeanG;
    float LevelBias;
    FVoxelLandNoiseSetRef DetailSet;
    float DetailTexelsPerCell;
    uint DetailKind;
    float DetailMeanHard;
    float DetailMeanSoft;
    float DetailScaleHard;
    float DetailScaleSoft;
    float DetailFade;
};

/** Whether the set layers' steering is read: the gullies' only (N1b: without them the layers
 *  skip their steering channel). */
VOXEL_FUNC bool VoxelLandSetSteers(VOXEL_LAND_ARGS_DECL float Dummy)
{
    return LandGullyStrength > 0.0f && LandGullyOctaves != 0u;
}

/** One face's lookup: the shape (over the larger range) and its gradient and steering (covectors per m
 *  along the face's angles times the radius), and the steering's curvature (per m^2). */
struct FVoxelLandPeakFace
{
    float Unit;
    float HardMinusSoft;    // the shape's derivative in the character
    float GU;
    float GV;
    float SU;
    float SV;
    float Curve;
};

VOXEL_FUNC FVoxelLandPeakFace VoxelLandSetFaceAt(VOXEL_LAND_ARGS_DECL FVoxelLandSetLayer L, uint Face, FVoxelLandAxis U, FVoxelLandAxis V, float Character,
    float Footprint, bool bShape)
{
    const float TexelM = LandCellM / L.TexelsPerCell;
    const float InvTexel = 1.0f / TexelM;
    const uint H = VoxelHash(uint3(Face, L.Kind, L.SaltA), L.Seed);
    const uint H2 = VoxelHash(uint3(Face, L.Kind, L.SaltB), L.Seed);
    // The face's coordinates in the set's texels, turned by the face's angle.
    const FVoxelLandPeakCoord CU = VoxelLandPeakCoordAt(VOXEL_LAND_ARGS U);
    const FVoxelLandPeakCoord CV = VoxelLandPeakCoordAt(VOXEL_LAND_ARGS V);
    const float2 Rot = VoxelLandPeakRotation(H >> 29u);
    const float RX = Rot.x * L.TexelsPerCell;
    const float RY = Rot.y * L.TexelsPerCell;
    const FVoxelLandNoiseAxis AU = VoxelLandPeakRotated(CU, CV, RX, -RY);
    const FVoxelLandNoiseAxis AV = VoxelLandPeakRotated(CU, CV, RY, RX);
    // The mip whose texels are about 2^-LevelBias footprints (the peaks: half).
    const float Level = max(log2(max(Footprint, 1.0f) / (TexelM * 100.0f)) + L.LevelBias, 0.0f);
    // Without the shape, only the steering channel (half the texels: its words alone); without
    // the gullies (the steering's only reader), R and G alone (N1b: half the loads).
    const bool bSteer = VoxelLandSetSteers(VOXEL_LAND_ARGS 0.0f);
    const FVoxelLandNoise N = VoxelLandNoiseAt(VOXEL_LAND_ARGS L.Set, AU, AV, H & 7u, H >> 3u, H2, Level,
        bShape ? (bSteer ? VOXEL_LAND_NOISE_WANT_HESSIAN_B : 0u) : (VOXEL_LAND_NOISE_WANT_ONLY_B | VOXEL_LAND_NOISE_WANT_HESSIAN_B));
    // Hard rock (rough character) to soft (smooth), over the larger range.
    const float C = saturate(Character);
    const float Hard = (N.R - L.MeanR) * L.ScaleR;
    const float Soft = (N.G - L.MeanG) * L.ScaleG;
    const float DU = lerp(N.GU * L.ScaleG, N.RU * L.ScaleR, C);
    const float DV = lerp(N.GV * L.ScaleG, N.RV * L.ScaleR, C);
    FVoxelLandPeakFace Out;
    Out.Unit = bShape ? lerp(Soft, Hard, C) : 0.0f;
    Out.HardMinusSoft = bShape ? Hard - Soft : 0.0f;
    // Back to the face's axes (the rotation's transpose), per m.
    Out.GU = bShape ? (Rot.x * DU + Rot.y * DV) * InvTexel : 0.0f;
    Out.GV = bShape ? (-Rot.y * DU + Rot.x * DV) * InvTexel : 0.0f;
    const float BU = N.BU * L.ScaleB;
    const float BV = N.BV * L.ScaleB;
    Out.SU = (Rot.x * BU + Rot.y * BV) * InvTexel;
    Out.SV = (-Rot.y * BU + Rot.x * BV) * InvTexel;
    Out.Curve = sqrt(N.BUU * N.BUU + 2.0f * N.BUV * N.BUV + N.BVV * N.BVV) * L.ScaleB * (InvTexel * InvTexel);
    if (bShape && L.DetailTexelsPerCell > 0.0f)
    {
        // The detail: its own texel, mip level, turn, orientation and offset.
        const float DetailTexelM = LandCellM / L.DetailTexelsPerCell;
        // Coarser than the set's rule (texels about half the footprint): the detail set is dense
        // in octaves down to its finest, so half-footprint texels pass wavelengths the footprint
        // can't hold (T3e's tile at the cache's 64 m level: normal p99 15 deg with the set's
        // rule, 3 with this).
        const float DetailLevel = max(log2(max(Footprint, 1.0f) / (DetailTexelM * 100.0f)) + VOXEL_LAND_PEAK_DETAIL_LEVEL_BIAS, 0.0f);
        const float Fade = 1.0f - smoothstep(L.DetailFade - VOXEL_LAND_PEAK_DETAIL_FADE_LEVELS, L.DetailFade, DetailLevel);
        if (Fade > 0.0f)
        {
            const uint HD = VoxelHash(uint3(Face, L.DetailKind, 0x64657461u), L.Seed);
            const uint HD2 = VoxelHash(uint3(Face, L.DetailKind, 0x61746564u), L.Seed);
            const float2 DRot = VoxelLandPeakRotation(HD >> 29u);
            const float DRX = DRot.x * L.DetailTexelsPerCell;
            const float DRY = DRot.y * L.DetailTexelsPerCell;
            const FVoxelLandNoiseAxis DAU = VoxelLandPeakRotated(CU, CV, DRX, -DRY);
            const FVoxelLandNoiseAxis DAV = VoxelLandPeakRotated(CU, CV, DRY, DRX);
            // R and G alone (no steering: the gullies keep to the set's): hard rock the set's G
            // (ridged), soft rock its R (fbm).
            const FVoxelLandNoise D = VoxelLandNoiseAt(VOXEL_LAND_ARGS L.DetailSet, DAU, DAV, HD & 7u, HD >> 3u, HD2, DetailLevel, 0u);
            const float SH = L.DetailScaleHard * Fade;
            const float SS = L.DetailScaleSoft * Fade;
            const float DHard = (D.G - L.DetailMeanHard) * SH;
            const float DSoft = (D.R - L.DetailMeanSoft) * SS;
            const float DDU = lerp(D.RU * SS, D.GU * SH, C);
            const float DDV = lerp(D.RV * SS, D.GV * SH, C);
            const float DInv = 1.0f / DetailTexelM;
            Out.Unit += lerp(DSoft, DHard, C);
            Out.HardMinusSoft += DHard - DSoft;
            Out.GU += (DRot.x * DDU + DRot.y * DDV) * DInv;
            Out.GV += (-DRot.y * DDU + DRot.x * DDV) * DInv;
        }
    }
    return Out;
}

/** VoxelLandFaceRamp's derivative in S. */
VOXEL_FUNC float VoxelLandFaceRampSlope(float S, float Band)
{
    const float X = (1.0f + Band - abs(S)) / (2.0f * Band);
    if (X <= 0.0f || X >= 1.0f) return 0.0f;
    const float D = 30.0f * X * X * (X - 1.0f) * (X - 1.0f);
    return S < 0.0f ? D / (2.0f * Band) : -D / (2.0f * Band);
}

/** A face covector (per m along its angles times the radius) as a tangent vector. */
VOXEL_FUNC float3 VoxelLandFaceVector(FVoxelLandFaceFrame Frame, float CU, float CV)
{
    return Frame.TU * (Frame.GUU * CU + Frame.GUV * CV) + Frame.TV * (Frame.GUV * CU + Frame.GVV * CV);
}

VOXEL_FUNC FVoxelLandPeaks VoxelLandPeaksNone()
{
    FVoxelLandPeaks Out;
    Out.Unit = 0.0f;
    Out.AmplitudeM = 0.0f;
    Out.Gradient = float3(0.0f, 0.0f, 0.0f);
    Out.Steer = float3(0.0f, 0.0f, 0.0f);
    Out.Curve = 0.0f;
    Out.Lambda = 0.0f;
    return Out;
}

/** A set layer at the sea-level sphere point P (double-float, cm) with amplitude AmplitudeM (m,
 *  above 0) and the character (hard and soft rock blend by it; CharacterGradient its gradient,
 *  per m, a tangent vector at P), band-limited to Footprint (cm): one lookup (two or three near a
 *  face edge, where the faces' lookups blend and the gradient includes the weights' own slope).
 *  bShape (a constant) false gives only the steering and its curvature (Unit and Gradient
 *  zero), from the steering channel alone: what the differenced terms need. Lambda is Out's.
 *
 *  The face blend (N1b) keeps the variance: the faces' tiles are independent, so their weighted
 *  mean would flatten the layer by up to 30% along every cube edge (the seams seen since T3d).
 *  The faces' units blend about the layer's mean M (its channels' means, BlendMeanR and G,
 *  through the character's blend: 0 for the zero-mean peaks) over the root of the weights'
 *  squares: Unit = M + sum W (U - M) / sqrt(sum W^2). One face (W 1) gives its own unit exactly.
 *  Near an edge the unit can reach sqrt(2) (at a corner sqrt(3)) of one face's range about M,
 *  where both faces' tiles are extreme together (VoxelLand::ShapeFor's bounds take it); the
 *  steering blends the same way, the curvature (a magnitude) as a weighted mean. */
VOXEL_FUNC FVoxelLandPeaks VoxelLandSetLayerDF(VOXEL_LAND_ARGS_DECL FVoxelLandSetLayer L, float2 PX, float2 PY, float2 PZ, float Character,
    float3 CharacterGradient, float AmplitudeM, float Lambda, float Footprint, bool bShape)
{
    FVoxelLandPeaks Out = VoxelLandPeaksNone();
    Out.AmplitudeM = AmplitudeM;
    Out.Lambda = Lambda;
    // Neither the shape nor the steering wanted: the amplitude alone.
    if (!bShape && !VoxelLandSetSteers(VOXEL_LAND_ARGS 0.0f)) return Out;

    const float Band = 2.0f * VOXEL_LAND_PEAK_BAND_CELLS / float(LandN);
    // The face coordinate's change per m along the face's angles: 4 / (pi R), R = 2 N cell / pi.
    const float DSDX = 2.0f / (float(LandN) * LandCellM);
    float WSum = 0.0f;
    float W2Sum = 0.0f;   // sum of W^2
    float USum = 0.0f;
    float3 GSum = float3(0.0f, 0.0f, 0.0f);    // sum of W grad U + U grad W
    float3 WGrad = float3(0.0f, 0.0f, 0.0f);   // sum of grad W
    float3 WWGrad = float3(0.0f, 0.0f, 0.0f);  // sum of W grad W
    float3 SSum = float3(0.0f, 0.0f, 0.0f);
    float CSum = 0.0f;
    float DSum = 0.0f;    // sum of W (hard - soft)
    VOXEL_LOOP
    for (uint Axis = 0u; Axis < 3u; Axis++)
    {
        const float2 PN = VoxelLandPick(PX, PY, PZ, Axis);
        if (PN.x == 0.0f) continue;
        const bool bNegative = PN.x < 0.0f;
        const uint Face = Axis * 2u + (bNegative ? 1u : 0u);
        const float2 Den = bNegative ? float2(-PN.x, -PN.y) : PN;
        const float2 AU = VoxelDFDiv(VoxelLandPick(PX, PY, PZ, VoxelCubeUAxis(Face)), Den);
        const float2 AV = VoxelDFDiv(VoxelLandPick(PX, PY, PZ, VoxelCubeVAxis(Face)), Den);
        const float S = atan(AU.x) * VOXEL_LAND_INV_QUARTER_PI;
        const float T = atan(AV.x) * VOXEL_LAND_INV_QUARTER_PI;
        const float RS = VoxelLandFaceRamp(S, Band);
        const float RT = VoxelLandFaceRamp(T, Band);
        const float W = RS * RT;
        if (W <= 0.0f) continue;
        const FVoxelLandPeakFace F = VoxelLandSetFaceAt(VOXEL_LAND_ARGS L, Face, VoxelLandAxisAt(VOXEL_LAND_ARGS AU, S), VoxelLandAxisAt(VOXEL_LAND_ARGS AV, T),
            Character, Footprint, bShape);
        const FVoxelLandFaceFrame Frame = VoxelLandFaceFrameAt(Face, AU.x, AV.x);
        const float WU = VoxelLandFaceRampSlope(S, Band) * RT * DSDX;
        const float WV = RS * VoxelLandFaceRampSlope(T, Band) * DSDX;
        USum += W * F.Unit;
        WSum += W;
        W2Sum += W * W;
        GSum = GSum + VoxelLandFaceVector(Frame, W * F.GU + F.Unit * WU, W * F.GV + F.Unit * WV);
        WGrad = WGrad + VoxelLandFaceVector(Frame, WU, WV);
        WWGrad = WWGrad + VoxelLandFaceVector(Frame, W * WU, W * WV);
        SSum = SSum + VoxelLandFaceVector(Frame, W * F.SU, W * F.SV);
        CSum += W * F.Curve;
        DSum += W * F.HardMinusSoft;
    }
    if (WSum <= 0.0f) return Out;
    // Q = sqrt(sum W^2), K = sum W / Q (1 on one face).
    const float InvQ = 1.0f / sqrt(W2Sum);
    const float InvQ3 = InvQ * InvQ * InvQ;
    const float K = WSum * InvQ;
    // The layer's mean through the character's blend (inside 0 .. 1: VoxelLandSetFaceAt
    // saturates it), and its change in the character.
    const float C = saturate(Character);
    const float MeanHard = (L.BlendMeanR - L.MeanR) * L.ScaleR;
    const float MeanSoft = (L.BlendMeanG - L.MeanG) * L.ScaleG;
    const float M = bShape ? lerp(MeanSoft, MeanHard, C) : 0.0f;
    // Unit = M (1 - K) + sum W U / Q; its gradient: - M grad K + grad (sum W U) / Q - sum W U
    // grad Q / Q^2, with grad K = sum grad W / Q - sum W sum W grad W / Q^3 and grad Q = sum W
    // grad W / Q; plus the character's change, (MeanHard - MeanSoft)(1 - K) + sum W (hard - soft)
    // / Q.
    Out.Unit = M * (1.0f - K) + USum * InvQ;
    const float CharacterSlope = (Character > 0.0f && Character < 1.0f) ? (MeanHard - MeanSoft) * (1.0f - K) + DSum * InvQ : 0.0f;
    const float3 KGrad = WGrad * InvQ - WWGrad * (WSum * InvQ3);
    Out.Gradient = ((GSum * InvQ - WWGrad * (USum * InvQ3)) - KGrad * M + CharacterGradient * CharacterSlope) * Out.AmplitudeM;
    Out.Steer = SSum * (InvQ * Out.AmplitudeM);
    Out.Curve = CSum * (Out.AmplitudeM / WSum);
    return Out;
}

/** The peaks' layer (the set's chain at the buffer's start; the pack's detail set). */
VOXEL_FUNC FVoxelLandSetLayer VoxelLandPeakLayer(VOXEL_LAND_ARGS_DECL float Dummy)
{
    FVoxelLandSetLayer L;
    L.Set = VoxelLandNoiseSetOf(0u, LandNoiseN, LandNoiseMips);
    L.TexelsPerCell = LandPeakTexelsPerCell;
    L.Seed = LandPeakSeed;
    L.Kind = 0u;
    L.SaltA = 0x7065616bu;
    L.SaltB = 0x6b616570u;
    L.MeanR = LandPeakMeanR;
    L.MeanG = LandPeakMeanG;
    L.ScaleR = LandPeakScaleR;
    L.ScaleG = LandPeakScaleG;
    L.ScaleB = LandPeakScaleB;
    // Zero-mean: the blend's mean is 0.
    L.BlendMeanR = LandPeakMeanR;
    L.BlendMeanG = LandPeakMeanG;
    L.LevelBias = -1.0f;
    L.DetailSet = VoxelLandNoiseSetOf(LandDetailBase, LandDetailN, LandDetailMips);
    L.DetailTexelsPerCell = LandPeakDetailTexelsPerCell;
    L.DetailKind = 1u;
    L.DetailMeanHard = LandDetailMeanHard;
    L.DetailMeanSoft = LandDetailMeanSoft;
    L.DetailScaleHard = LandPeakDetailScaleHard;
    L.DetailScaleSoft = LandPeakDetailScaleSoft;
    L.DetailFade = LandPeakDetailFade;
    return L;
}

/** T5d: smoothstep(E0, E1, X)'s derivative in X (VoxelLandCarve.ush's VoxelLandSmoothSlope, which comes later). */
VOXEL_FUNC float VoxelLandGlacialFadeSlope(float E0, float E1, float X)
{
    const float T = saturate((X - E0) / (E1 - E0));
    return 6.0f * T * (1.0f - T) / (E1 - E0);
}

/** T5d: whether the planet has the glacial layer (a set, a placement, the peaks, a climate). */
VOXEL_FUNC bool VoxelLandGlacialOn(VOXEL_LAND_ARGS_DECL float Dummy)
{
    return LandGlacialTexelsPerCell > 0.0f && LandGlacialStrength > 0.0f && LandGlacialN != 0u && LandHasClimate != 0u;
}

/** T5d: the glacial layer's amplitude (m): the peaks' rule (VoxelLandPeakAmplitude) from its own
 *  relief, faded in from the coast lower. */
VOXEL_FUNC float VoxelLandGlacialAmplitude(VOXEL_LAND_ARGS_DECL float Relief, float Flow, float Bake)
{
    float A = LandGlacialStrength * min(LandGlacialReliefM, Relief) * smoothstep(LandPeakReliefStart, LandPeakReliefEnd, Relief)
        * smoothstep(VOXEL_LAND_GLACIAL_COAST_START, VOXEL_LAND_GLACIAL_COAST_END, Bake);
    if (LandHasFlow != 0u)
        A *= 1.0f - smoothstep(VOXEL_LAND_PEAK_CREST_START, VOXEL_LAND_PEAK_CREST_END, Flow - 2.0f * log2(LandCellM));
    return max(A, 0.0f);
}

/** T5d: the glacial shares at a unit direction and bake height (m): Past, carved (glaciers now or
 *  at the glacial maximum); Now, iced now (at most Past); their changes per m of height. */
struct FVoxelLandGlacialSite
{
    float Past;
    float Now;
    float PastSlope;
    float NowSlope;
};

VOXEL_FUNC FVoxelLandGlacialSite VoxelLandGlacialSiteAt(VOXEL_LAND_ARGS_DECL float3 Dir, float Bake)
{
    const FVoxelLandClimateCell Cell = VoxelLandClimateCellAt(VOXEL_LAND_ARGS VoxelLandClimateTapsOf(Dir));
    const float Margin = VoxelLandClimateGlacierMargin(Cell, LandClimateLapse, Bake, 0.0f);
    const float W = VOXEL_LAND_GLACIAL_WIDTH;
    FVoxelLandGlacialSite Out;
    Out.Now = VoxelLandClimateRamp(-W, W, Margin);
    Out.Past = VoxelLandClimateRamp(-W, W, Margin + max(LandGlacialCooling, 0.0f));
    // The ramps' slopes (6 t (1 - t) over their width) times the margin's change with the height.
    const float DMargin = Bake > 0.0f ? LandClimateLapse * 0.001f / (2.0f * W) : 0.0f;
    const float TN = saturate((Margin + W) / (2.0f * W));
    const float TP = saturate((Margin + max(LandGlacialCooling, 0.0f) + W) / (2.0f * W));
    Out.NowSlope = 6.0f * TN * (1.0f - TN) * DMargin;
    Out.PastSlope = 6.0f * TP * (1.0f - TP) * DMargin;
    return Out;
}

/** T5d: the glacial layer (its chain in the pack; the peaks' detail set and placement). */
VOXEL_FUNC FVoxelLandSetLayer VoxelLandGlacialLayer(VOXEL_LAND_ARGS_DECL float Dummy)
{
    FVoxelLandSetLayer L;
    L.Set = VoxelLandNoiseSetOf(LandGlacialBase, LandGlacialN, LandGlacialMips);
    L.TexelsPerCell = LandGlacialTexelsPerCell;
    L.Seed = LandGlacialSeed;
    L.Kind = 7u;
    L.SaltA = 0x676c6163u;
    L.SaltB = 0x63616c67u;
    L.MeanR = LandGlacialMeanR;
    L.MeanG = LandGlacialMeanG;
    L.ScaleR = LandGlacialScaleR;
    L.ScaleG = LandGlacialScaleG;
    L.ScaleB = LandGlacialScaleB;
    // Zero-mean, as the peaks.
    L.BlendMeanR = LandGlacialMeanR;
    L.BlendMeanG = LandGlacialMeanG;
    L.LevelBias = -1.0f;
    L.DetailSet = VoxelLandNoiseSetOf(LandDetailBase, LandDetailN, LandDetailMips);
    L.DetailTexelsPerCell = LandGlacialDetailScaleHard > 0.0f || LandGlacialDetailScaleSoft > 0.0f ? LandPeakDetailTexelsPerCell : 0.0f;
    L.DetailKind = 8u;
    L.DetailMeanHard = LandDetailMeanHard;
    L.DetailMeanSoft = LandDetailMeanSoft;
    L.DetailScaleHard = LandGlacialDetailScaleHard;
    L.DetailScaleSoft = LandGlacialDetailScaleSoft;
    L.DetailFade = LandPeakDetailFade;
    return L;
}

/** The peaks at the sea-level sphere point P (double-float, cm) with the bake's landform Form
 *  (its character shapes them), local relief Relief (m), drainage Flow (log2 m^2) and height Bake
 *  (m), band-limited to Footprint (cm): one lookup of the set (two near a face edge).
 *  CharacterGradient: the character's gradient (per m, a tangent vector at P), for the shape's
 *  change with it (hard and soft rock blend by it). bShape (a constant) false gives only the
 *  amplitude, the steering and its curvature (Unit and Gradient zero), from the steering channel
 *  alone: what the differenced terms need. */
VOXEL_FUNC FVoxelLandPeaks VoxelLandPeaksShapeDF(VOXEL_LAND_ARGS_DECL float2 PX, float2 PY, float2 PZ, float2 Form, float3 CharacterGradient, float Relief,
    float Flow, float Bake, float3 BakeGradient, float Footprint, bool bShape)
{
    FVoxelLandPeaks Out = VoxelLandPeaksNone();
    if (!VoxelLandPeaksOn(VOXEL_LAND_ARGS 0.0f)) return Out;
    const float AmplitudeM = VoxelLandPeakAmplitude(VOXEL_LAND_ARGS Relief, Flow, Bake);
    // T5d: the glacial layer in the peaks' place where the climate has had glaciers.
    const float GlacialM = VoxelLandGlacialOn(VOXEL_LAND_ARGS 0.0f) ? VoxelLandGlacialAmplitude(VOXEL_LAND_ARGS Relief, Flow, Bake) : 0.0f;
    float AP = AmplitudeM;
    float AG = 0.0f;
    float DAP = 0.0f;
    float DAG = 0.0f;
    float Now = 0.0f;
    float NowSlope = 0.0f;
    if (GlacialM > 0.0f)
    {
        const FVoxelLandGlacialSite G = VoxelLandGlacialSiteAt(VOXEL_LAND_ARGS normalize(float3(PX.x, PY.x, PZ.x)), Bake);
        if (G.Past > 0.0f)
        {
            // The two layers by 1 - Past and Past, the variance kept (each its own at 0 and 1).
            const float InvQ = 1.0f / sqrt((1.0f - G.Past) * (1.0f - G.Past) + G.Past * G.Past);
            AP = AmplitudeM * (1.0f - G.Past) * InvQ;
            AG = GlacialM * G.Past * InvQ;
            // Their changes per m of height: through the switch (d/dP of (1 - P) / Q and P / Q are
            // -P / Q^3 and (1 - P) / Q^3), and through their coast fades, which differ (each
            // amplitude over its fade, times the fade's slope; 0 where the fade is).
            const float InvQ3 = InvQ * InvQ * InvQ;
            const float CP = smoothstep(VOXEL_LAND_PEAK_COAST_START, VOXEL_LAND_PEAK_COAST_END, Bake);
            const float CG = smoothstep(VOXEL_LAND_GLACIAL_COAST_START, VOXEL_LAND_GLACIAL_COAST_END, Bake);
            DAP = -AmplitudeM * G.Past * InvQ3 * G.PastSlope
                + (CP > 0.0f ? AP / CP * VoxelLandGlacialFadeSlope(VOXEL_LAND_PEAK_COAST_START, VOXEL_LAND_PEAK_COAST_END, Bake) : 0.0f);
            DAG = GlacialM * (1.0f - G.Past) * InvQ3 * G.PastSlope
                + (CG > 0.0f ? AG / CG * VoxelLandGlacialFadeSlope(VOXEL_LAND_GLACIAL_COAST_START, VOXEL_LAND_GLACIAL_COAST_END, Bake) : 0.0f);
            Now = G.Now;
            NowSlope = G.NowSlope;
        }
    }
    if (AP + AG <= 0.0f)
    {
        Out.AmplitudeM = AP + AG;
        return Out;
    }
    // One call site for both layers (each call inlines the whole layer: the shaders' size). The
    // glacial layer: bare bedrock (R, the character's hard end) to the ice (G) by the share iced
    // now, the ice line along the bake's contours.
    FVoxelLandPeaks Single = VoxelLandPeaksNone();
    uint Count = 0u;
    float USum = 0.0f;
    float LSum = 0.0f;
    float UP = 0.0f;
    float UG = 0.0f;
    VOXEL_LOOP
    for (uint Layer = 0u; Layer < 2u; Layer++)
    {
        const float A = Layer == 0u ? AP : AG;
        if (A <= 0.0f) continue;
        FVoxelLandSetLayer L = VoxelLandPeakLayer(VOXEL_LAND_ARGS 0.0f);
        float Character = Form.y;
        float3 CharacterGrad = CharacterGradient;
        float Lambda = LandPeakSpacingM;
        if (Layer != 0u)
        {
            L = VoxelLandGlacialLayer(VOXEL_LAND_ARGS 0.0f);
            Character = 1.0f - Now;
            CharacterGrad = BakeGradient * (-NowSlope);
            Lambda = LandGlacialSpacingM;
        }
        const FVoxelLandPeaks R = VoxelLandSetLayerDF(VOXEL_LAND_ARGS L, PX, PY, PZ, Character, CharacterGrad, A, Lambda, Footprint, bShape);
        if (Layer == 0u) UP = R.Unit;
        else UG = R.Unit;
        Single = R;
        Count++;
        USum += R.Unit * A;
        LSum += R.Lambda * A;
        Out.Gradient = Out.Gradient + R.Gradient;
        Out.Steer = Out.Steer + R.Steer;
        Out.Curve += R.Curve;
    }
    // One layer (no glacial layer here, or only it): that layer's own (exactly the peaks' without
    // the glacial set; the switch's correction below vanishes then).
    if (Count == 1u) return Single;
    Out.AmplitudeM = AP + AG;
    const float InvA = 1.0f / Out.AmplitudeM;
    Out.Unit = USum * InvA;
    Out.Lambda = LSum * InvA;
    // The gradient leaves the amplitude's own change out (the hosts add Unit times it, as for every
    // layer); through the switch the two layers' amplitudes change apart, which Unit times their
    // sum's change misses: (UP - Unit) dAP + (UG - Unit) dAG, along the bake's slope.
    if (bShape)
        Out.Gradient = Out.Gradient + BakeGradient * ((UP - Out.Unit) * DAP + (UG - Out.Unit) * DAG);
    return Out;
}

VOXEL_FUNC FVoxelLandPeaks VoxelLandPeaksDF(VOXEL_LAND_ARGS_DECL float2 PX, float2 PY, float2 PZ, float2 Form, float Relief, float Flow, float Bake,
    float Footprint)
{
    return VoxelLandPeaksShapeDF(VOXEL_LAND_ARGS PX, PY, PZ, Form, float3(0.0f, 0.0f, 0.0f), Relief, Flow, Bake, float3(0.0f, 0.0f, 0.0f), Footprint, true);
}

#endif // VOXEL_LAND_PEAKS_USH
