// VoxelLandMaterialAccessEnd.ush - Ends VoxelLandMaterialAccess.ush's scalar macros (the names of
// the global shaders' land inputs: LandN, PlanetRadius, ...) once the land code's functions are
// defined, so the rest of the material (or the harness's other hosts) keeps its own meaning of
// those names. The accessors and VOXEL_LAND_ARGS stay: they name only the land code's arguments.

#undef LandN
#undef LandPad
#undef LandHasFlow
#undef LandCellM
#undef LandGullyStrength
#undef LandGullyOctaves
#undef LandGullyFlowGain
#undef LandGullyDetail
#undef LandGullySeed
#undef LandHillRelief
#undef LandHillFrequency
#undef LandHillOctaves
#undef LandHillSeed
#undef LandHasForm
#undef LandPeakStrength
#undef LandPeakTexelsPerCell
#undef LandPeakSeed
#undef LandPeakSpacingM
#undef LandPeakReliefM
#undef LandPeakReliefStart
#undef LandPeakReliefEnd
#undef LandPeakMeanR
#undef LandPeakMeanG
#undef LandPeakScaleR
#undef LandPeakScaleG
#undef LandPeakScaleB
#undef LandNoiseN
#undef LandNoiseMips
#undef LandPeakDetailBase
#undef LandPeakDetailN
#undef LandPeakDetailMips
#undef LandPeakDetailTexelsPerCell
#undef LandPeakDetailMeanR
#undef LandPeakDetailMeanG
#undef LandPeakDetailScaleR
#undef LandPeakDetailScaleG
#undef LandPeakDetailFade
#undef LandHillBase
#undef LandHillN
#undef LandHillMips
#undef LandHillTexelsPerCell
#undef LandHillScaleR
#undef LandHillScaleG
#undef LandHillScaleB
#undef LandHillSpacingM
#undef LandHillSwellTexelsPerCell
#undef LandHillSwellM
#undef LandHillSwellScaleG
#undef LandHillDetailTexelsPerCell
#undef LandHillDetailScaleR
#undef LandHillDetailScaleG
#undef LandHillDetailFade
#undef LandHillFoothill
#undef LandMode
#undef LandWarpOctaves
#undef LandWarpInvNorm
#undef LandWarpAmplitude
#undef LandDetailAmplitude
#undef LandHeightOffset
#undef ContinentOctaves
#undef MountainOctaves
#undef DetailOctaves
#undef InvNormDetail
#undef PlanetRadius
#undef NoiseAmplitude
#undef RidgeGain
#undef SlopeDamping
#undef InvNormContinent
#undef InvNormMountain
#undef HalfFinest
#undef ContinentWeight
#undef MountainWeight
#undef MountainStart
#undef MountainBlend
#undef DetailWeight
