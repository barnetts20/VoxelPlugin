// VoxelBrickMesherPasses.ush - The passes of the GPU stitched brick mesher, one function per
// compute pass taking the thread index. Shared subset (VoxelShaderCompat.h): the C++ tests run
// the same passes in sequence. The dispatcher is VoxelBrickMesherGPU.cpp.
//
// Per batch of bricks, in order:
//   Sample (mode 0)   density on each brick's own lattice (points -2..N+1)
//   Edges             minimal edges of the brick's level that it emits; marks their cells
//   Request (mode 0)  edge ends of marked cells off the own lattice, into a per-brick hash
//   Sample (mode 1)   those points
//   Request (mode 1)  gradient points of crossed edges off the own lattice
//   Sample (mode 1)   those points
//   Solve             one vertex per marked cell
//   Triangles         faces to triangles (a quad, or a triangle where a coarser cell covers
//                     two quadrants)
// All densities come from one function in one pass, so a point shared by two bricks gets the
// same value in both.
//
// Inputs, declared by the includer after VoxelBrickStitch.ush (which defines
// FVoxelMesherBrick), besides those of VoxelDensitySample.ush and VoxelEditSample.ush:
//   StructuredBuffer<FVoxelMesherBrick> Bricks;
//   int CellsPerBrick; uint NumBricks; uint HashSize (power of two); uint FaceCap;
//   uint VertexCap; uint TriangleCap; float FinestCell; float MinFootprint;
//   RWStructuredBuffer<float> Dense;        NumBricks * (N+4)^3
//   RWStructuredBuffer<uint> HashKeys;      NumBricks * HashSize, 0 = empty
//   RWStructuredBuffer<uint> HashValues;    density bits, 0xffffffff until sampled
//   RWStructuredBuffer<uint> SlotState;     NumBricks * slots, 1 = cell needs a vertex
//   RWStructuredBuffer<uint> SlotVertex;    vertex index, 0xffffffff = none
//   RWStructuredBuffer<uint> Faces;         NumBricks * FaceCap * 4 cell slots (bit 31 of the
//                                           first: flip)
//   RWStructuredBuffer<uint> Counters;      per brick: faces, vertices, triangles, error bits
//   RWStructuredBuffer<float> Vertices;     NumBricks * VertexCap * 6 (position cm from the
//                                           brick min, normal)
//   RWStructuredBuffer<uint> Indices;       NumBricks * TriangleCap * 3

#ifndef VOXEL_BRICK_MESHER_PASSES_USH
#define VOXEL_BRICK_MESHER_PASSES_USH

static const uint VoxelMesherErrorFaces = 1u;
static const uint VoxelMesherErrorHash = 2u;
static const uint VoxelMesherErrorMissing = 4u;
static const uint VoxelMesherErrorVertices = 8u;
static const uint VoxelMesherErrorTriangles = 16u;
static const uint VoxelMesherUnsampled = 0xffffffffu;
static const uint VoxelMesherNone = 0xffffffffu;

VOXEL_FUNC FVoxelStitchBrick VoxelMesherStitchBrick(uint B)
{
    const FVoxelMesherBrick Brick = Bricks[B];
    FVoxelStitchBrick S;
    S.N = CellsPerBrick;
    S.LevelsLo = Brick.LevelsLo;
    S.LevelsHi = Brick.LevelsHi;
    S.Meshed = Brick.Meshed;
    return S;
}

VOXEL_FUNC uint VoxelMesherDenseSide() { return uint(CellsPerBrick + 4); }
VOXEL_FUNC uint VoxelMesherDenseTotal() { const uint D = VoxelMesherDenseSide(); return D * D * D; }
VOXEL_FUNC uint VoxelMesherOwnSide() { return uint(CellsPerBrick + 2); }
VOXEL_FUNC uint VoxelMesherCoarseSide() { return uint(CellsPerBrick / 2 + 2); }
VOXEL_FUNC uint VoxelMesherOwnSlots() { const uint S = VoxelMesherOwnSide(); return S * S * S; }
VOXEL_FUNC uint VoxelMesherNumSlots() { const uint T = VoxelMesherCoarseSide(); return VoxelMesherOwnSlots() + T * T * T; }

// Slot of a cell this brick may solve: its own level's cells -1..N, or coarser cells around it.
VOXEL_FUNC uint VoxelMesherSlotOf(FVoxelStitchCell C)
{
    if (C.Level == 0)
    {
        const uint S = VoxelMesherOwnSide();
        return (uint(C.Min.z / 2 + 1) * S + uint(C.Min.y / 2 + 1)) * S + uint(C.Min.x / 2 + 1);
    }
    const uint T = VoxelMesherCoarseSide();
    return VoxelMesherOwnSlots() + (uint(C.Min.z / 4 + 1) * T + uint(C.Min.y / 4 + 1)) * T + uint(C.Min.x / 4 + 1);
}

VOXEL_FUNC FVoxelStitchCell VoxelMesherCellOf(uint Slot)
{
    FVoxelStitchCell C;
    if (Slot < VoxelMesherOwnSlots())
    {
        const uint S = VoxelMesherOwnSide();
        C.Level = 0;
        C.Size = 2;
        C.Min = int3(2 * (int(Slot % S) - 1), 2 * (int((Slot / S) % S) - 1), 2 * (int(Slot / (S * S)) - 1));
        return C;
    }
    const uint T = VoxelMesherCoarseSide();
    const uint R = Slot - VoxelMesherOwnSlots();
    C.Level = 1;
    C.Size = 4;
    C.Min = int3(4 * (int(R % T) - 1), 4 * (int((R / T) % T) - 1), 4 * (int(R / (T * T)) - 1));
    return C;
}

VOXEL_FUNC bool VoxelMesherIsDense(int3 P)
{
    const int Hi = 2 * CellsPerBrick + 2;
    return ((P.x | P.y | P.z) & 1) == 0 && P.x >= -4 && P.y >= -4 && P.z >= -4 && P.x <= Hi && P.y <= Hi && P.z <= Hi;
}

VOXEL_FUNC uint VoxelMesherDenseIndex(uint B, int3 P)
{
    const uint D = VoxelMesherDenseSide();
    return B * VoxelMesherDenseTotal() + (uint((P.z + 4) / 2) * D + uint((P.y + 4) / 2)) * D + uint((P.x + 4) / 2);
}

// 10 bits per axis, offset 256: points -8..2N+8 fit for N up to 250 (the dispatcher allows 64).
VOXEL_FUNC uint VoxelMesherKey(int3 P)
{
    return (uint(P.x + 256) | (uint(P.y + 256) << 10u) | (uint(P.z + 256) << 20u)) + 1u;
}

VOXEL_FUNC int3 VoxelMesherKeyPoint(uint Key)
{
    const uint K = Key - 1u;
    return int3(int(K & 1023u) - 256, int((K >> 10u) & 1023u) - 256, int((K >> 20u) & 1023u) - 256);
}

VOXEL_FUNC uint VoxelMesherHashStart(uint Key)
{
    return ((Key * 2654435761u) >> 12u) & (HashSize - 1u);
}

VOXEL_FUNC void VoxelMesherRequest(uint B, int3 P)
{
    if (VoxelMesherIsDense(P)) return;
    const uint Key = VoxelMesherKey(P);
    uint H = VoxelMesherHashStart(Key);
    for (uint i = 0u; i < HashSize; i++)
    {
        uint Previous = 0u;
        InterlockedCompareExchange(HashKeys[B * HashSize + H], 0u, Key, Previous);
        if (Previous == 0u || Previous == Key) return;
        H = (H + 1u) & (HashSize - 1u);
    }
    InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorHash);
}

// Density at a lattice point of brick B (own lattice or requested and sampled).
VOXEL_FUNC float VoxelMesherSampleAt(uint B, int3 P)
{
    if (VoxelMesherIsDense(P)) return Dense[VoxelMesherDenseIndex(B, P)];
    const uint Key = VoxelMesherKey(P);
    uint H = VoxelMesherHashStart(Key);
    for (uint i = 0u; i < HashSize; i++)
    {
        const uint Stored = HashKeys[B * HashSize + H];
        if (Stored == Key)
        {
            const uint Value = HashValues[B * HashSize + H];
            if (Value != VoxelMesherUnsampled) return asfloat(Value);
            break;
        }
        if (Stored == 0u) break;
        H = (H + 1u) & (HashSize - 1u);
    }
    InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorMissing);
    return 0.0f;
}

// Central-difference gradient direction (unnormalised; the scale is common to both ends of
// an edge and cancels).
VOXEL_FUNC float3 VoxelMesherGradient(uint B, int3 P, int Step)
{
    return float3(
        VoxelMesherSampleAt(B, P + int3(Step, 0, 0)) - VoxelMesherSampleAt(B, P - int3(Step, 0, 0)),
        VoxelMesherSampleAt(B, P + int3(0, Step, 0)) - VoxelMesherSampleAt(B, P - int3(0, Step, 0)),
        VoxelMesherSampleAt(B, P + int3(0, 0, Step)) - VoxelMesherSampleAt(B, P - int3(0, 0, Step)));
}

VOXEL_FUNC int3 VoxelMesherLatticeIndex(uint B, int3 P)
{
    const FVoxelMesherBrick Brick = Bricks[B];
    const int Scale = int(1u << uint(Brick.Level));
    return int3(Brick.MinIndex.x + P.x * Scale, Brick.MinIndex.y + P.y * Scale, Brick.MinIndex.z + P.z * Scale);
}

// The density of a point, band-limited to the cell size of the leaf owning it, with edits.
VOXEL_FUNC float VoxelMesherDensity(uint B, int3 P)
{
    const int Owner = VoxelStitchOwnerLevel(VoxelMesherStitchBrick(B), P.x, P.y, P.z);
    const float Footprint = max(ldexp(FinestCell, Bricks[B].Level + Owner), MinFootprint);
    const int3 Index = VoxelMesherLatticeIndex(B, P);
    return VoxelSampleDensityDF(Index.x, Index.y, Index.z, Footprint) + VoxelEditDelta(Index.x, Index.y, Index.z);
}

// Mode 0: the own lattice of every brick. Mode 1: requested points not sampled yet.
// The density is evaluated at a single call site: two inlined copies could be compiled with
// different rounding (fused multiply-adds), and a point sampled on one brick's lattice and on
// another brick's hash must get the same value.
VOXEL_FUNC void VoxelMesherSamplePass(uint Id, uint Mode)
{
    uint B = 0u;
    int3 P = int3(0, 0, 0);
    if (Mode == 0u)
    {
        if (Id >= NumBricks * VoxelMesherDenseTotal()) return;
        B = Id / VoxelMesherDenseTotal();
        const uint I = Id % VoxelMesherDenseTotal();
        const uint D = VoxelMesherDenseSide();
        P = int3(2 * int(I % D) - 4, 2 * int((I / D) % D) - 4, 2 * int(I / (D * D)) - 4);
    }
    else
    {
        if (Id >= NumBricks * HashSize) return;
        const uint Key = HashKeys[Id];
        if (Key == 0u || HashValues[Id] != VoxelMesherUnsampled) return;
        B = Id / HashSize;
        P = VoxelMesherKeyPoint(Key);
    }

    const float Density = VoxelMesherDensity(B, P);

    if (Mode == 0u)
        Dense[Id] = Density;
    else
        HashValues[Id] = asuint(Density);
}

// One candidate edge of a brick's level touching the brick: lower end at cells 0..N-1 along
// it, 0..N across. Emits it when it is minimal and this brick owns it (MeshBrickStitched).
VOXEL_FUNC void VoxelMesherEdgesPass(uint Id)
{
    const uint N = uint(CellsPerBrick);
    const uint PerAxis = N * (N + 1u) * (N + 1u);
    if (Id >= NumBricks * 3u * PerAxis) return;
    const uint B = Id / (3u * PerAxis);
    uint R = Id % (3u * PerAxis);
    const int Axis = int(R / PerAxis);
    R = R % PerAxis;
    const int A = (Axis + 1) % 3;
    const int AB = (Axis + 2) % 3;
    int3 Lo = VoxelSetAxis(int3(0, 0, 0), Axis, 2 * int(R % N));
    Lo = VoxelSetAxis(Lo, A, 2 * int((R / N) % (N + 1u)));
    Lo = VoxelSetAxis(Lo, AB, 2 * int(R / (N * (N + 1u))));
    const int3 Hi = VoxelAddAxis(Lo, Axis, 2);

    const float D0 = Dense[VoxelMesherDenseIndex(B, Lo)];
    const float D1 = Dense[VoxelMesherDenseIndex(B, Hi)];
    if ((D0 < 0.0f) == (D1 < 0.0f)) return;

    // The four cells around the edge: (+A,+B), (-A,+B), (-A,-B), (+A,-B). The owner is the
    // meshed brick of this level that sorts last (z, then y, then x) among theirs.
    const FVoxelStitchBrick Brick = VoxelMesherStitchBrick(B);
    uint Slots[4];
    int3 Owner = int3(-2, -2, -2);
    for (int c = 0; c < 4; c++)
    {
        float3 Probe = VoxelAddAxisF(VoxelToFloat3(Lo), Axis, 1.0f);
        Probe = VoxelAddAxisF(Probe, A, (c == 1 || c == 2) ? -VoxelProbeOffset : VoxelProbeOffset);
        Probe = VoxelAddAxisF(Probe, AB, c >= 2 ? -VoxelProbeOffset : VoxelProbeOffset);
        const FVoxelStitchCell Cell = VoxelStitchCellAt(Brick, Probe);
        if (Cell.Level < 0) return;
        const int3 Block = int3(VoxelStitchBlockOf(Cell.Min.x, CellsPerBrick), VoxelStitchBlockOf(Cell.Min.y, CellsPerBrick), VoxelStitchBlockOf(Cell.Min.z, CellsPerBrick));
        const bool bLater = Block.z > Owner.z || (Block.z == Owner.z && (Block.y > Owner.y || (Block.y == Owner.y && Block.x > Owner.x)));
        if (Cell.Level == 0 && bLater && VoxelStitchIsMeshed(Brick, VoxelStitchDirection(Block.x, Block.y, Block.z)))
            Owner = Block;
        Slots[c] = VoxelMesherSlotOf(Cell);
    }
    if (Owner.x != 0 || Owner.y != 0 || Owner.z != 0) return;

    uint Face = 0u;
    InterlockedAdd(Counters[B * 4u], 1u, Face);
    if (Face >= FaceCap)
    {
        InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorFaces);
        return;
    }
    const uint Base = (B * FaceCap + Face) * 4u;
    Faces[Base] = Slots[0] | (D0 < 0.0f ? 0x80000000u : 0u);
    Faces[Base + 1u] = Slots[1];
    Faces[Base + 2u] = Slots[2];
    Faces[Base + 3u] = Slots[3];
    for (int k = 0; k < 4; k++)
        SlotState[B * VoxelMesherNumSlots() + Slots[k]] = 1u;
}

// Mode 0: the ends of every edge of a marked cell. Mode 1: the gradient points of its crossed
// edges. Points on the own lattice are skipped.
VOXEL_FUNC void VoxelMesherRequestPass(uint Id, uint Mode)
{
    if (Id >= NumBricks * VoxelMesherNumSlots() || SlotState[Id] == 0u) return;
    const uint B = Id / VoxelMesherNumSlots();
    const FVoxelStitchBrick Brick = VoxelMesherStitchBrick(B);
    const FVoxelStitchCell Cell = VoxelMesherCellOf(Id % VoxelMesherNumSlots());
    VOXEL_LOOP
    for (int s = 0; s < 48; s++)
    {
        const FVoxelStitchEdge E = VoxelStitchCellEdge(Brick, Cell, s);
        if (!E.Valid) continue;
        const int3 Hi = VoxelAddAxis(E.Lo, E.Axis, E.Length);
        if (Mode == 0u)
        {
            VoxelMesherRequest(B, E.Lo);
            VoxelMesherRequest(B, Hi);
            continue;
        }
        if ((VoxelMesherSampleAt(B, E.Lo) < 0.0f) == (VoxelMesherSampleAt(B, Hi) < 0.0f)) continue;
        VOXEL_LOOP
        for (int Axis = 0; Axis < 3; Axis++)
        {
            const int3 Step = VoxelSetAxis(int3(0, 0, 0), Axis, E.Length);
            VoxelMesherRequest(B, E.Lo + Step);
            VoxelMesherRequest(B, E.Lo - Step);
            VoxelMesherRequest(B, Hi + Step);
            VoxelMesherRequest(B, Hi - Step);
        }
    }
}

// The vertex of a marked cell: QEF over the crossings of its minimal edges.
VOXEL_FUNC void VoxelMesherSolvePass(uint Id)
{
    if (Id >= NumBricks * VoxelMesherNumSlots() || SlotState[Id] == 0u) return;
    const uint B = Id / VoxelMesherNumSlots();
    const FVoxelStitchBrick Brick = VoxelMesherStitchBrick(B);
    const FVoxelStitchCell Cell = VoxelMesherCellOf(Id % VoxelMesherNumSlots());
    const float S = float(Cell.Size);

    FVoxelQef Q = VoxelQefBegin();
    VOXEL_LOOP
    for (int s = 0; s < 48; s++)
    {
        const FVoxelStitchEdge E = VoxelStitchCellEdge(Brick, Cell, s);
        if (!E.Valid) continue;
        const int3 Hi = VoxelAddAxis(E.Lo, E.Axis, E.Length);
        const float D0 = VoxelMesherSampleAt(B, E.Lo);
        const float D1 = VoxelMesherSampleAt(B, Hi);
        if ((D0 < 0.0f) == (D1 < 0.0f)) continue;

        const float Denominator = D0 - D1;
        const float T = abs(Denominator) < 1.0e-12f ? 0.5f : saturate(D0 / Denominator);
        const float3 P = VoxelAddAxisF(VoxelToFloat3(E.Lo - Cell.Min), E.Axis, T * float(E.Length)) / S;

        const float3 G0 = VoxelMesherGradient(B, E.Lo, E.Length);
        const float3 G1 = VoxelMesherGradient(B, Hi, E.Length);
        float3 Normal = G0 + (G1 - G0) * T;
        const float NormalLengthSq = dot(Normal, Normal);
        if (NormalLengthSq > 1.0e-8f)
            Normal = Normal / sqrt(NormalLengthSq);
        else
        {
            const int3 Index = VoxelMesherLatticeIndex(B, E.Lo);
            const float3 Radial = float3(float(Index.x), float(Index.y), float(Index.z));
            Normal = Radial / max(length(Radial), 1.0e-6f);
        }
        Q = VoxelQefAdd(Q, P, Normal);
    }
    if (Q.Count == 0) return;

    const float3 Local = VoxelToFloat3(Cell.Min) + VoxelQefVertex(Q) * S;
    float3 VertexNormal = Q.NormalSum;
    const float VertexLengthSq = dot(VertexNormal, VertexNormal);
    if (VertexLengthSq > 1.0e-8f)
        VertexNormal = VertexNormal / sqrt(VertexLengthSq);
    else
    {
        const int3 Index = VoxelMesherLatticeIndex(B, int3(Cell.Min.x, Cell.Min.y, Cell.Min.z));
        const float3 Radial = float3(float(Index.x), float(Index.y), float(Index.z));
        VertexNormal = Radial / max(length(Radial), 1.0e-6f);
    }

    uint V = 0u;
    InterlockedAdd(Counters[B * 4u + 1u], 1u, V);
    if (V >= VertexCap)
    {
        InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorVertices);
        return;
    }
    const float Unit = ldexp(FinestCell, Bricks[B].Level - 1);
    const uint Base = (B * VertexCap + V) * 6u;
    Vertices[Base] = Local.x * Unit;
    Vertices[Base + 1u] = Local.y * Unit;
    Vertices[Base + 2u] = Local.z * Unit;
    Vertices[Base + 3u] = VertexNormal.x;
    Vertices[Base + 4u] = VertexNormal.y;
    Vertices[Base + 5u] = VertexNormal.z;
    SlotVertex[Id] = V;
}

VOXEL_FUNC float3 VoxelMesherVertexPosition(uint B, uint V)
{
    const uint Base = (B * VertexCap + V) * 6u;
    return float3(Vertices[Base], Vertices[Base + 1u], Vertices[Base + 2u]);
}

VOXEL_FUNC void VoxelMesherEmitTriangle(uint B, uint VA, uint VB, uint VC, bool bFlip)
{
    uint T = 0u;
    InterlockedAdd(Counters[B * 4u + 2u], 1u, T);
    if (T >= TriangleCap)
    {
        InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorTriangles);
        return;
    }
    const uint Base = (B * TriangleCap + T) * 3u;
    Indices[Base] = VA;
    Indices[Base + 1u] = bFlip ? VC : VB;
    Indices[Base + 2u] = bFlip ? VB : VC;
}

VOXEL_FUNC float3 VoxelSafeNormalize(float3 V)
{
    const float L = length(V);
    return L > 1.0e-20f ? V / L : float3(0.0f, 0.0f, 0.0f);
}

// One face: the vertices of its four cells, deduplicated around the ring, as one or two
// triangles with the octree mesher's split choice and winding.
VOXEL_FUNC void VoxelMesherTrianglesPass(uint Id)
{
    if (Id >= NumBricks * FaceCap) return;
    const uint B = Id / FaceCap;
    const uint F = Id % FaceCap;
    if (F >= min(Counters[B * 4u], FaceCap)) return;

    const uint Base = Id * 4u;
    const bool bFlip = (Faces[Base] & 0x80000000u) != 0u;
    uint Ring[4];
    int Count = 0;
    bool bValid = true;
    for (int c = 0; c < 4; c++)
    {
        const uint Slot = Faces[Base + uint(c)] & 0x7fffffffu;
        const uint V = SlotVertex[B * VoxelMesherNumSlots() + Slot];
        bValid = bValid && V != VoxelMesherNone;
        if (Count == 0 || Ring[Count - 1] != V)
        {
            Ring[Count] = V;
            Count += 1;
        }
    }
    if (Count > 1 && Ring[Count - 1] == Ring[0]) Count -= 1;
    if (!bValid || Count < 3) return;

    if (Count == 3)
    {
        VoxelMesherEmitTriangle(B, Ring[0], Ring[1], Ring[2], bFlip);
        return;
    }
    const float3 P0 = VoxelMesherVertexPosition(B, Ring[0]);
    const float3 P1 = VoxelMesherVertexPosition(B, Ring[1]);
    const float3 P2 = VoxelMesherVertexPosition(B, Ring[2]);
    const float3 P3 = VoxelMesherVertexPosition(B, Ring[3]);
    const float FoldA = dot(VoxelSafeNormalize(cross(P1 - P0, P2 - P0)), VoxelSafeNormalize(cross(P2 - P0, P3 - P0)));
    const float FoldB = dot(VoxelSafeNormalize(cross(P1 - P0, P3 - P0)), VoxelSafeNormalize(cross(P2 - P1, P3 - P1)));
    if (FoldB > FoldA)
    {
        VoxelMesherEmitTriangle(B, Ring[0], Ring[1], Ring[3], bFlip);
        VoxelMesherEmitTriangle(B, Ring[1], Ring[2], Ring[3], bFlip);
    }
    else
    {
        VoxelMesherEmitTriangle(B, Ring[0], Ring[1], Ring[2], bFlip);
        VoxelMesherEmitTriangle(B, Ring[0], Ring[2], Ring[3], bFlip);
    }
}

#endif // VOXEL_BRICK_MESHER_PASSES_USH
