// VoxelBrickMesherPasses.ush - The passes of the GPU stitched brick mesher, one function per
// compute pass taking the thread index. Shared subset (VoxelShaderCompat.h): the C++ tests run
// the same passes in sequence. The dispatcher is VoxelBrickMesherGPU.cpp.
//
// Per batch of bricks, in order:
//   Sample (mode 0)   density on each brick's own lattice (points 0..N)
//   Edges             minimal edges of the brick's level that it emits; marks their cells
//   Request (mode 0)  edge ends of marked cells off the own lattice, into a per-brick hash
//   Sample (mode 1)   those points
//   Request (mode 1)  gradient points of crossed edges off the own lattice
//   Sample (mode 1)   those points
//   Solve             one vertex per marked cell; marks the cell's parent and grandparent
//                     (morph targets)
//   Triangles         faces to triangles (a quad, or a triangle where a coarser cell covers
//                     two quadrants)
//   TargetRequest (0) edge ends of marked targets, into a second hash with their level
//   Sample (mode 2)   those points, at that level's footprint
//   TargetRequest (2) a coarser target without a crossing marks its neighbours on the
//                     surface's side, and their parents
//   TargetRequest (3) edge ends of those
//   Sample (mode 2)   those points
//   TargetRequest (1) gradient points of their crossed edges (of every corner, coarser
//                     targets)
//   Sample (mode 2)   those points
//   TargetSolve       each target's vertex, as the brick of its level solves it once the
//                     finer leaves around it have merged (its frame)
//   VertexTargets     each vertex's parent target, that target's own target, its
//                     unstitched position, and the coarser levels' normals at it and at
//                     its parent target
// All densities come from one function in one pass, so a point shared by two bricks gets the
// same value in both, and a parent vertex here equals that cell's vertex in the coarser brick.
//
// Morph targets (geomorphing, chained): a vertex of a cell of level l carries the target of
// level l + 1 (its parent cell's vertex) and that vertex's own target of level l + 2. The
// terrain material (VoxelMorph.ush) blends the vertex toward what the parent level draws at
// that moment, lerp(parent, grandparent, its blend), so a split or a merge shows the same
// surface whatever the parent's blend (Design/MeshingEngine.md section 4 B). A cell next to
// finer leaves is solved from their edges (stitched); it also carries its unstitched solve,
// toward which it blends as the finer level morphs into its own, so it shows that solve when
// the finer leaves merge (section 4 F). Normals blend toward the coarser level's normal field
// at the vertex's unstitched position and reach the parent's normal only as the vertex
// reaches the parent: every vertex of a parent cell shares that normal, so blending straight
// to it would make each parent cell one flat patch.
//
// Inputs, declared by the includer after VoxelBrickStitch.ush (which defines
// FVoxelMesherBrick), besides those of VoxelDensitySample.ush and VoxelEditSample.ush:
//   StructuredBuffer<FVoxelMesherBrick> Bricks;   (Frame: see VoxelMesherTargetFrame)
//   int CellsPerBrick; uint NumBricks; uint HashSize (power of two); uint FaceCap;
//   uint VertexCap; uint TriangleCap; float FinestCell; float MinFootprint;
//   RWStructuredBuffer<float> Dense;        NumBricks * (N+1)^3
//   RWStructuredBuffer<uint> HashKeys;      NumBricks * HashSize, 0 = empty (cleared)
//   RWStructuredBuffer<uint> HashValues;    density bits, 0xffffffff until sampled; not
//                                           cleared: set where a key is taken
//   RWStructuredBuffer<uint> SlotState;     NumBricks * slots, 1 = cell needs a vertex (cleared)
//   RWStructuredBuffer<uint> SlotVertex;    vertex index, 0xffffffff = none; not cleared: set
//                                           where a slot is marked
//   RWStructuredBuffer<uint> Faces;         NumBricks * FaceCap * 4 cell slots (bit 31 of the
//                                           first: flip)
//   RWStructuredBuffer<uint> Counters;      per brick: faces, vertices, triangles, error bits
//   RWStructuredBuffer<float> Vertices;     NumBricks * VertexCap * VoxelMesherVertexStride:
//                                           position cm from the brick min, normal, parent
//                                           target position and normal, grandparent target
//                                           position and normal, unstitched position and
//                                           normal, level of the cell relative to the brick
//                                           (0 or 1), the debug colour (0xRRGGBB as an exact
//                                           float, VoxelLandDebug.ush), the next level's
//                                           normal field at the unstitched position and the
//                                           level after's at the parent target
//   RWStructuredBuffer<uint> Indices;       NumBricks * TriangleCap * 3
//   uint TargetHashSize (power of two);
//   RWStructuredBuffer<uint> TargetState;   NumBricks * targets: 1 needed, 2 solved, 3 no
//                                           crossing (VoxelMesherTargetFor), 4 needed as a
//                                           neighbour of a target without a crossing
//   RWStructuredBuffer<float> TargetData;   NumBricks * targets * 6: vertex (units), normal
//   RWStructuredBuffer<uint> TargetHashKeys, TargetHashValues;   NumBricks * TargetHashSize,
//                                           as HashKeys and HashValues

#ifndef VOXEL_BRICK_MESHER_PASSES_USH
#define VOXEL_BRICK_MESHER_PASSES_USH

static const uint VoxelMesherErrorFaces = 1u;
static const uint VoxelMesherErrorHash = 2u;
static const uint VoxelMesherErrorMissing = 4u;
static const uint VoxelMesherErrorVertices = 8u;
static const uint VoxelMesherErrorTriangles = 16u;
static const uint VoxelMesherUnsampled = 0xffffffffu;
static const uint VoxelMesherNone = 0xffffffffu;
static const uint VoxelMesherVertexStride = 32u;

VOXEL_FUNC FVoxelStitchBrick VoxelMesherStitchBrick(uint B)
{
    const FVoxelMesherBrick Brick = Bricks[B];
    FVoxelStitchBrick S;
    S.N = CellsPerBrick;
    S.LevelsLo = Brick.LevelsLo;
    S.LevelsHi = Brick.LevelsHi;
    S.Meshed = Brick.Meshed;
    return S;
}

// The own lattice, points 0..N. Points around it (neighbour cells, gradient points at the
// faces) are requested and sampled only where a crossing needs them.
VOXEL_FUNC uint VoxelMesherDenseSide() { return uint(CellsPerBrick + 1); }
VOXEL_FUNC uint VoxelMesherDenseTotal() { const uint D = VoxelMesherDenseSide(); return D * D * D; }
VOXEL_FUNC uint VoxelMesherOwnSide() { return uint(CellsPerBrick + 2); }
VOXEL_FUNC uint VoxelMesherCoarseSide() { return uint(CellsPerBrick / 2 + 2); }
VOXEL_FUNC uint VoxelMesherOwnSlots() { const uint S = VoxelMesherOwnSide(); return S * S * S; }
VOXEL_FUNC uint VoxelMesherNumSlots() { const uint T = VoxelMesherCoarseSide(); return VoxelMesherOwnSlots() + T * T * T; }

// Slot of a cell this brick may solve: its own level's cells -1..N, or coarser cells around it.
VOXEL_FUNC uint VoxelMesherSlotOf(FVoxelStitchCell C)
{
    if (C.Level == 0)
    {
        const uint S = VoxelMesherOwnSide();
        return (uint(C.Min.z / 2 + 1) * S + uint(C.Min.y / 2 + 1)) * S + uint(C.Min.x / 2 + 1);
    }
    const uint T = VoxelMesherCoarseSide();
    return VoxelMesherOwnSlots() + (uint(C.Min.z / 4 + 1) * T + uint(C.Min.y / 4 + 1)) * T + uint(C.Min.x / 4 + 1);
}

VOXEL_FUNC FVoxelStitchCell VoxelMesherCellOf(uint Slot)
{
    FVoxelStitchCell C;
    if (Slot < VoxelMesherOwnSlots())
    {
        const uint S = VoxelMesherOwnSide();
        C.Level = 0;
        C.Size = 2;
        C.Min = int3(2 * (int(Slot % S) - 1), 2 * (int((Slot / S) % S) - 1), 2 * (int(Slot / (S * S)) - 1));
        return C;
    }
    const uint T = VoxelMesherCoarseSide();
    const uint R = Slot - VoxelMesherOwnSlots();
    C.Level = 1;
    C.Size = 4;
    C.Min = int3(4 * (int(R % T) - 1), 4 * (int((R / T) % T) - 1), 4 * (int(R / (T * T)) - 1));
    return C;
}

VOXEL_FUNC uint VoxelMesherHashStartOf(uint Key, uint Size)
{
    return ((Key * 2654435761u) >> 12u) & (Size - 1u);
}

VOXEL_FUNC uint VoxelMesherHashStart(uint Key)
{
    return VoxelMesherHashStartOf(Key, HashSize);
}

// Morph targets: set K (0..3) holds cells of level +K (2^(K+1) units) around the brick. Own
// cells have their parent in set 1 and grandparent in set 2; coarse cells in sets 2 and 3. A
// cell next to finer leaves also has its unstitched solve, own cells in set 0, coarse cells
// in set 1. Sets 1 to 3 reach two cells past the brick, so that a target in the first ring
// has its neighbours (TargetRequest mode 2) in every brick that needs it. Set 0 holds only
// the own cells that can touch a neighbour brick: those within two cells of a face
// (indices -1, 0, N - 1 and N), the shell of the (N + 2)^3 cube around its (N - 2)^3 core.
VOXEL_FUNC uint VoxelMesherTargetSide(int K) { return uint((CellsPerBrick >> K) + (K == 0 ? 2 : 4)); }
VOXEL_FUNC uint VoxelMesherShellCore() { return uint(CellsPerBrick - 2); }

VOXEL_FUNC uint VoxelMesherTargetSetSize(int K)
{
    const uint S = VoxelMesherTargetSide(K);
    const uint M = VoxelMesherShellCore();
    return K == 0 ? S * S * S - M * M * M : S * S * S;
}

VOXEL_FUNC uint VoxelMesherTargetBase(int K)
{
    uint Base = 0u;
    for (int k = 0; k < K; k++)
        Base += VoxelMesherTargetSetSize(k);
    return Base;
}

VOXEL_FUNC uint VoxelMesherNumTargets() { return VoxelMesherTargetBase(4); }

// True if set C.Level holds cell C.
VOXEL_FUNC bool VoxelMesherTargetInSet(FVoxelStitchCell C)
{
    const int R = C.Level == 0 ? 1 : 2;
    const int Last = (CellsPerBrick >> C.Level) + R - 1;
    const int X = C.Min.x / C.Size;
    const int Y = C.Min.y / C.Size;
    const int Z = C.Min.z / C.Size;
    if (X < -R || Y < -R || Z < -R || X > Last || Y > Last || Z > Last) return false;
    const int Lo = 1;
    const int Hi = CellsPerBrick - 2;
    return C.Level > 0 || !(X >= Lo && X <= Hi && Y >= Lo && Y <= Hi && Z >= Lo && Z <= Hi);
}

// The target holding cell C itself (its level 0..3), which its set must hold.
VOXEL_FUNC uint VoxelMesherTargetSlot(FVoxelStitchCell C)
{
    const uint S = VoxelMesherTargetSide(C.Level);
    const int R = C.Level == 0 ? 1 : 2;
    const uint U = uint(C.Min.x / C.Size + R);
    const uint V = uint(C.Min.y / C.Size + R);
    const uint W = uint(C.Min.z / C.Size + R);
    const uint Cube = (W * S + V) * S + U;
    if (C.Level > 0) return VoxelMesherTargetBase(C.Level) + Cube;
    // Shell: less the core cells before it (core indices 2..N - 1 here).
    const uint M = VoxelMesherShellCore();
    const uint Hi = uint(CellsPerBrick - 1);
    uint Before = M * M * uint(clamp(int(W) - 2, 0, int(M)));
    if (W >= 2u && W <= Hi)
    {
        Before += M * uint(clamp(int(V) - 2, 0, int(M)));
        if (V >= 2u && V <= Hi) Before += uint(clamp(int(U) - 2, 0, int(M)));
    }
    return Cube - Before;
}

// The target holding the parent of a cell of level C.Level (0..2).
VOXEL_FUNC FVoxelStitchCell VoxelMesherParentCell(FVoxelStitchCell C)
{
    FVoxelStitchCell Parent;
    Parent.Level = C.Level + 1;
    Parent.Size = 2 * C.Size;
    Parent.Min = int3(VoxelFloorTo(C.Min.x, Parent.Size), VoxelFloorTo(C.Min.y, Parent.Size), VoxelFloorTo(C.Min.z, Parent.Size));
    return Parent;
}

VOXEL_FUNC uint VoxelMesherTargetOf(FVoxelStitchCell C)
{
    return VoxelMesherTargetSlot(VoxelMesherParentCell(C));
}

// The cell of a target slot.
VOXEL_FUNC FVoxelStitchCell VoxelMesherTargetCell(uint Target)
{
    int K = 0;
    uint R = Target;
    for (int k = 0; k < 3; k++)
    {
        const uint Size = VoxelMesherTargetSetSize(k);
        if (K == k && R >= Size)
        {
            R -= Size;
            K = k + 1;
        }
    }
    const uint S = VoxelMesherTargetSide(K);
    uint U = R % S;
    uint V = (R / S) % S;
    uint W = R / (S * S);
    if (K == 0)
    {
        // Shell planes 2..N - 1 hold rows 0, 1, N and N + 1 whole, and four cells of the others.
        const uint M = VoxelMesherShellCore();
        const uint N = uint(CellsPerBrick);
        const uint Plane = S * S;
        const uint Ring = Plane - M * M;
        uint P = R;
        if (R < 2u * Plane)
        {
            W = R / Plane;
            P = R % Plane;
        }
        else if (R < 2u * Plane + M * Ring)
        {
            W = 2u + (R - 2u * Plane) / Ring;
            P = (R - 2u * Plane) % Ring;
        }
        else
        {
            W = N + (R - 2u * Plane - M * Ring) / Plane;
            P = (R - 2u * Plane - M * Ring) % Plane;
        }
        U = P % S;
        V = P / S;
        if (W >= 2u && W < N && P >= 2u * S)
        {
            if (P < 2u * S + 4u * M)
            {
                V = 2u + (P - 2u * S) / 4u;
                const uint Q = (P - 2u * S) % 4u;
                U = Q < 2u ? Q : N + Q - 2u;
            }
            else
            {
                V = N + (P - 2u * S - 4u * M) / S;
                U = (P - 2u * S - 4u * M) % S;
            }
        }
    }
    const int Shift = K == 0 ? 1 : 2;
    FVoxelStitchCell C;
    C.Level = K;
    C.Size = int(2u << uint(K));
    C.Min = int3(C.Size * (int(U) - Shift), C.Size * (int(V) - Shift), C.Size * (int(W) - Shift));
    return C;
}

// Target points are multiples of 2 units; the key holds P / 2 (8 bits per axis, offset 32:
// room for -64..446, which holds the points' -48..2N+48 for N up to 64) and the level the point
// is sampled at.
VOXEL_FUNC uint VoxelMesherTargetKey(int3 P, int Tag)
{
    return (uint(P.x / 2 + 32) | (uint(P.y / 2 + 32) << 8u) | (uint(P.z / 2 + 32) << 16u) | (uint(Tag) << 24u)) + 1u;
}

VOXEL_FUNC int3 VoxelMesherTargetKeyPoint(uint Key)
{
    const uint K = Key - 1u;
    return int3(2 * (int(K & 255u) - 32), 2 * (int((K >> 8u) & 255u) - 32), 2 * (int((K >> 16u) & 255u) - 32));
}

// How a target cell is solved (its frame): as the brick of its level solves it with every
// finer leaf around it at that level, so the solve is the one that brick draws once the finer
// leaves have merged. A target of a coarser level (K >= 1) has no coarser neighbour within
// reach (the tree is balanced), so it is solved alone, at its level. An own cell (K = 0) keeps
// the coarser neighbours brick B has.
struct FVoxelMesherFrame
{
    FVoxelStitchBrick Brick;   // N and neighbour levels, relative to the frame's brick
    int3 Origin;               // its min corner, units of brick B
    int Scale;                 // its unit, in units of brick B (2^K)
    int K;
};

VOXEL_FUNC FVoxelMesherFrame VoxelMesherTargetFrame(uint B, FVoxelStitchCell T)
{
    FVoxelMesherFrame F;
    F.K = T.Level;
    F.Scale = int(1u << uint(T.Level));
    F.Brick.N = CellsPerBrick;
    F.Brick.Meshed = 0u;
    if (F.K > 0)
    {
        // Every direction at the frame's level; the cell anywhere inside it.
        F.Brick.LevelsLo = 0x55555555u;
        F.Brick.LevelsHi = 0x55555555u;
        F.Origin = T.Min;
        return F;
    }
    // Brick B's levels with finer neighbours (0) raised to its own (1).
    const FVoxelStitchBrick Own = VoxelMesherStitchBrick(B);
    F.Brick.LevelsLo = Own.LevelsLo | ((~Own.LevelsLo >> 1u) & ~Own.LevelsLo & 0x55555555u);
    F.Brick.LevelsHi = Own.LevelsHi | ((~Own.LevelsHi >> 1u) & ~Own.LevelsHi & 0x55555555u);
    F.Origin = int3(0, 0, 0);
    return F;
}

// True if a cell of brick B's level touches a finer leaf (its stitched solve then differs
// from its unstitched one).
VOXEL_FUNC bool VoxelMesherTouchesFiner(uint B, FVoxelStitchCell C)
{
    const FVoxelStitchBrick Brick = VoxelMesherStitchBrick(B);
    for (int c = 0; c < 8; c++)
    {
        const int X = (c & 1) != 0 ? C.Min.x + C.Size : C.Min.x - 1;
        const int Y = (c & 2) != 0 ? C.Min.y + C.Size : C.Min.y - 1;
        const int Z = (c & 4) != 0 ? C.Min.z + C.Size : C.Min.z - 1;
        if (VoxelStitchOwnerLevel(Brick, X, Y, Z) < 0) return true;
    }
    return false;
}

// The level (relative to brick B) a point of a target's frame is sampled at: its owner's.
VOXEL_FUNC int VoxelMesherFrameTag(FVoxelMesherFrame F, int3 P)
{
    return F.K + VoxelStitchOwnerLevel(F.Brick, (P.x - F.Origin.x) / F.Scale, (P.y - F.Origin.y) / F.Scale, (P.z - F.Origin.z) / F.Scale);
}

// Edge Slot (0..47) of a target cell in its frame (VoxelStitchCellEdge), in units of brick B.
VOXEL_FUNC FVoxelStitchEdge VoxelMesherFrameEdge(FVoxelMesherFrame F, FVoxelStitchCell T, int Slot)
{
    FVoxelStitchCell C;
    C.Level = 0;
    C.Size = 2;
    C.Min = int3((T.Min.x - F.Origin.x) / F.Scale, (T.Min.y - F.Origin.y) / F.Scale, (T.Min.z - F.Origin.z) / F.Scale);
    FVoxelStitchEdge E = VoxelStitchCellEdge(F.Brick, C, Slot);
    E.Lo = int3(E.Lo.x * F.Scale + F.Origin.x, E.Lo.y * F.Scale + F.Origin.y, E.Lo.z * F.Scale + F.Origin.z);
    E.Length = E.Length * F.Scale;
    return E;
}

VOXEL_FUNC int VoxelMesherTargetKeyTag(uint Key)
{
    return int(((Key - 1u) >> 24u) & 255u);
}

// The thread that takes a slot marks its value unsampled (the values buffer is not cleared);
// a slot taken earlier keeps the value it was given.
VOXEL_FUNC void VoxelMesherTargetRequest(uint B, int3 P, int Tag)
{
    const uint Key = VoxelMesherTargetKey(P, Tag);
    uint H = VoxelMesherHashStartOf(Key, TargetHashSize);
    for (uint i = 0u; i < TargetHashSize; i++)
    {
        uint Previous = 0u;
        InterlockedCompareExchange(TargetHashKeys[B * TargetHashSize + H], 0u, Key, Previous);
        if (Previous == 0u)
        {
            TargetHashValues[B * TargetHashSize + H] = VoxelMesherUnsampled;
            return;
        }
        if (Previous == Key) return;
        H = (H + 1u) & (TargetHashSize - 1u);
    }
    InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorHash);
}

VOXEL_FUNC float VoxelMesherTargetSampleAt(uint B, int3 P, int Tag)
{
    const uint Key = VoxelMesherTargetKey(P, Tag);
    uint H = VoxelMesherHashStartOf(Key, TargetHashSize);
    for (uint i = 0u; i < TargetHashSize; i++)
    {
        const uint Stored = TargetHashKeys[B * TargetHashSize + H];
        if (Stored == Key)
        {
            const uint Value = TargetHashValues[B * TargetHashSize + H];
            if (Value != VoxelMesherUnsampled) return asfloat(Value);
            break;
        }
        if (Stored == 0u) break;
        H = (H + 1u) & (TargetHashSize - 1u);
    }
    InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorMissing);
    return 0.0f;
}

// A target point's density, at its owner's level in the frame.
VOXEL_FUNC float VoxelMesherFrameSample(uint B, FVoxelMesherFrame F, int3 P)
{
    return VoxelMesherTargetSampleAt(B, P, VoxelMesherFrameTag(F, P));
}

VOXEL_FUNC float3 VoxelMesherTargetGradient(uint B, FVoxelMesherFrame F, int3 P, int Step)
{
    return float3(
        VoxelMesherFrameSample(B, F, P + int3(Step, 0, 0)) - VoxelMesherFrameSample(B, F, P - int3(Step, 0, 0)),
        VoxelMesherFrameSample(B, F, P + int3(0, Step, 0)) - VoxelMesherFrameSample(B, F, P - int3(0, Step, 0)),
        VoxelMesherFrameSample(B, F, P + int3(0, 0, Step)) - VoxelMesherFrameSample(B, F, P - int3(0, 0, Step)));
}

// A target cell's corner densities in its frame (corner c at bit 0 x, bit 1 y, bit 2 z).
struct FVoxelMesherCorners
{
    float D[8];
};

VOXEL_FUNC FVoxelMesherCorners VoxelMesherTargetCorners(uint B, FVoxelMesherFrame F, FVoxelStitchCell T)
{
    FVoxelMesherCorners C;
    for (int c = 0; c < 8; c++)
        C.D[c] = VoxelMesherFrameSample(B, F, T.Min + int3((c & 1) * T.Size, ((c >> 1) & 1) * T.Size, (c >> 2) * T.Size));
    return C;
}

// The way from a cell without a crossing toward the surface: its trilinear field's slope at
// the centre, signed to point toward zero (solid is negative). Zero for a cell with a crossing.
VOXEL_FUNC float3 VoxelMesherSurfaceDirection(FVoxelMesherCorners C)
{
    const bool bInside = C.D[0] < 0.0f;
    for (int c = 1; c < 8; c++)
    {
        if ((C.D[c] < 0.0f) != bInside) return float3(0.0f, 0.0f, 0.0f);
    }
    const float3 G = float3(
        (C.D[1] - C.D[0]) + (C.D[3] - C.D[2]) + (C.D[5] - C.D[4]) + (C.D[7] - C.D[6]),
        (C.D[2] - C.D[0]) + (C.D[3] - C.D[1]) + (C.D[6] - C.D[4]) + (C.D[7] - C.D[5]),
        (C.D[4] - C.D[0]) + (C.D[5] - C.D[1]) + (C.D[6] - C.D[2]) + (C.D[7] - C.D[3]));
    return bInside ? G : -G;
}

// The neighbours toward the surface (-1, 0 or 1 per axis): the axes along which the field
// falls toward zero at least a third as fast as along the steepest.
VOXEL_FUNC int3 VoxelMesherSurfaceSide(float3 Dir)
{
    const float Steepest = max(abs(Dir.x), max(abs(Dir.y), abs(Dir.z)));
    if (Steepest <= 0.0f) return int3(0, 0, 0);
    const float Min = Steepest / 3.0f;
    return int3(
        abs(Dir.x) >= Min ? (Dir.x > 0.0f ? 1 : -1) : 0,
        abs(Dir.y) >= Min ? (Dir.y > 0.0f ? 1 : -1) : 0,
        abs(Dir.z) >= Min ? (Dir.z > 0.0f ? 1 : -1) : 0);
}

// Neighbour k (0..3) of a cell toward the surface: its faces from the steepest, then the
// diagonal. Level -1 where there is no such neighbour.
VOXEL_FUNC FVoxelStitchCell VoxelMesherSurfaceNeighbour(FVoxelStitchCell T, float3 Dir, int k)
{
    const int3 Side = VoxelMesherSurfaceSide(Dir);
    const float AX = abs(Dir.x);
    const float AY = abs(Dir.y);
    const float AZ = abs(Dir.z);
    const int A0 = AX >= AY && AX >= AZ ? 0 : (AY >= AZ ? 1 : 2);
    const int A1 = A0 == 0 ? (AY >= AZ ? 1 : 2) : (A0 == 1 ? (AX >= AZ ? 0 : 2) : (AX >= AY ? 0 : 1));
    const int Axis = k == 0 ? A0 : (k == 1 ? A1 : 3 - A0 - A1);
    const int NumSides = (Side.x != 0 ? 1 : 0) + (Side.y != 0 ? 1 : 0) + (Side.z != 0 ? 1 : 0);
    const int3 Off = k < 3 ? VoxelSetAxis(int3(0, 0, 0), Axis, VoxelAxis(Side, Axis)) : Side;
    FVoxelStitchCell X = T;
    X.Min = int3(T.Min.x + Off.x * T.Size, T.Min.y + Off.y * T.Size, T.Min.z + Off.z * T.Size);
    if ((k < 3 && VoxelAxis(Side, Axis) == 0) || (k == 3 && NumSides < 2)) X.Level = -1;
    return X;
}

// Marks cell C of its set as needed by a neighbour (state 4), if the set holds it.
VOXEL_FUNC void VoxelMesherMarkNeighbourTarget(uint B, FVoxelStitchCell C)
{
    if (!VoxelMesherTargetInSet(C)) return;
    uint Previous = 0u;
    InterlockedCompareExchange(TargetState[B * VoxelMesherNumTargets() + VoxelMesherTargetSlot(C)], 0u, 4u, Previous);
}

VOXEL_FUNC bool VoxelMesherIsDense(int3 P)
{
    const int Hi = 2 * CellsPerBrick;
    return ((P.x | P.y | P.z) & 1) == 0 && P.x >= 0 && P.y >= 0 && P.z >= 0 && P.x <= Hi && P.y <= Hi && P.z <= Hi;
}

VOXEL_FUNC uint VoxelMesherDenseIndex(uint B, int3 P)
{
    const uint D = VoxelMesherDenseSide();
    return B * VoxelMesherDenseTotal() + (uint(P.z / 2) * D + uint(P.y / 2)) * D + uint(P.x / 2);
}

// 10 bits per axis, offset 256: points -8..2N+8 fit for N up to 379 (the dispatcher allows 64).
VOXEL_FUNC uint VoxelMesherKey(int3 P)
{
    return (uint(P.x + 256) | (uint(P.y + 256) << 10u) | (uint(P.z + 256) << 20u)) + 1u;
}

VOXEL_FUNC int3 VoxelMesherKeyPoint(uint Key)
{
    const uint K = Key - 1u;
    return int3(int(K & 1023u) - 256, int((K >> 10u) & 1023u) - 256, int((K >> 20u) & 1023u) - 256);
}

// As VoxelMesherTargetRequest: the thread that takes a slot marks its value unsampled.
VOXEL_FUNC void VoxelMesherRequest(uint B, int3 P)
{
    if (VoxelMesherIsDense(P)) return;
    const uint Key = VoxelMesherKey(P);
    uint H = VoxelMesherHashStart(Key);
    for (uint i = 0u; i < HashSize; i++)
    {
        uint Previous = 0u;
        InterlockedCompareExchange(HashKeys[B * HashSize + H], 0u, Key, Previous);
        if (Previous == 0u)
        {
            HashValues[B * HashSize + H] = VoxelMesherUnsampled;
            return;
        }
        if (Previous == Key) return;
        H = (H + 1u) & (HashSize - 1u);
    }
    InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorHash);
}

// Density at a lattice point of brick B (own lattice or requested and sampled).
VOXEL_FUNC float VoxelMesherSampleAt(uint B, int3 P)
{
    if (VoxelMesherIsDense(P)) return Dense[VoxelMesherDenseIndex(B, P)];
    const uint Key = VoxelMesherKey(P);
    uint H = VoxelMesherHashStart(Key);
    for (uint i = 0u; i < HashSize; i++)
    {
        const uint Stored = HashKeys[B * HashSize + H];
        if (Stored == Key)
        {
            const uint Value = HashValues[B * HashSize + H];
            if (Value != VoxelMesherUnsampled) return asfloat(Value);
            break;
        }
        if (Stored == 0u) break;
        H = (H + 1u) & (HashSize - 1u);
    }
    InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorMissing);
    return 0.0f;
}

// Central-difference gradient direction (unnormalised; the scale is common to both ends of
// an edge and cancels).
VOXEL_FUNC float3 VoxelMesherGradient(uint B, int3 P, int Step)
{
    return float3(
        VoxelMesherSampleAt(B, P + int3(Step, 0, 0)) - VoxelMesherSampleAt(B, P - int3(Step, 0, 0)),
        VoxelMesherSampleAt(B, P + int3(0, Step, 0)) - VoxelMesherSampleAt(B, P - int3(0, Step, 0)),
        VoxelMesherSampleAt(B, P + int3(0, 0, Step)) - VoxelMesherSampleAt(B, P - int3(0, 0, Step)));
}

VOXEL_FUNC int3 VoxelMesherLatticeIndex(uint B, int3 P)
{
    const FVoxelMesherBrick Brick = Bricks[B];
    const int Scale = int(1u << uint(Brick.Level));
    return int3(Brick.MinIndex.x + P.x * Scale, Brick.MinIndex.y + P.y * Scale, Brick.MinIndex.z + P.z * Scale);
}

// The density of a point band-limited to the cell size of level Level, with edits.
VOXEL_FUNC float VoxelMesherDensity(uint B, int3 P, int Level)
{
    const float Footprint = max(ldexp(FinestCell, Level), MinFootprint);
    const int3 Index = VoxelMesherLatticeIndex(B, P);
    return VoxelEditApply(Index.x, Index.y, Index.z, Footprint, VoxelSampleDensityDF(Index.x, Index.y, Index.z, Footprint));
}

// Mode 0: the own lattice of every brick. Mode 1: requested points not sampled yet. Points
// are band-limited to the cell size of the leaf owning them. Mode 2: requested target
// points, band-limited to the level they were requested at.
// The density is evaluated at a single call site: two inlined copies could be compiled with
// different rounding (fused multiply-adds), and a point sampled on one brick's lattice and on
// another brick's hash must get the same value.
VOXEL_FUNC void VoxelMesherSamplePass(uint Id, uint Mode)
{
    uint B = 0u;
    int3 P = int3(0, 0, 0);
    int Level = 0;
    if (Mode == 0u)
    {
        if (Id >= NumBricks * VoxelMesherDenseTotal()) return;
        B = Id / VoxelMesherDenseTotal();
        const uint I = Id % VoxelMesherDenseTotal();
        const uint D = VoxelMesherDenseSide();
        P = int3(2 * int(I % D), 2 * int((I / D) % D), 2 * int(I / (D * D)));
        Level = Bricks[B].Level + VoxelStitchOwnerLevel(VoxelMesherStitchBrick(B), P.x, P.y, P.z);
    }
    else if (Mode == 1u)
    {
        if (Id >= NumBricks * HashSize) return;
        const uint Key = HashKeys[Id];
        if (Key == 0u || HashValues[Id] != VoxelMesherUnsampled) return;
        B = Id / HashSize;
        P = VoxelMesherKeyPoint(Key);
        Level = Bricks[B].Level + VoxelStitchOwnerLevel(VoxelMesherStitchBrick(B), P.x, P.y, P.z);
    }
    else
    {
        if (Id >= NumBricks * TargetHashSize) return;
        const uint Key = TargetHashKeys[Id];
        if (Key == 0u || TargetHashValues[Id] != VoxelMesherUnsampled) return;
        B = Id / TargetHashSize;
        P = VoxelMesherTargetKeyPoint(Key);
        Level = Bricks[B].Level + VoxelMesherTargetKeyTag(Key);
    }

    const float Density = VoxelMesherDensity(B, P, Level);

    if (Mode == 0u)
        Dense[Id] = Density;
    else if (Mode == 1u)
        HashValues[Id] = asuint(Density);
    else
        TargetHashValues[Id] = asuint(Density);
}

// One candidate edge of a brick's level touching the brick: lower end at cells 0..N-1 along
// it, 0..N across. Emits it when it is minimal and this brick owns it (MeshBrickStitched).
VOXEL_FUNC void VoxelMesherEdgesPass(uint Id)
{
    const uint N = uint(CellsPerBrick);
    const uint PerAxis = N * (N + 1u) * (N + 1u);
    if (Id >= NumBricks * 3u * PerAxis) return;
    const uint B = Id / (3u * PerAxis);
    uint R = Id % (3u * PerAxis);
    const int Axis = int(R / PerAxis);
    R = R % PerAxis;
    const int A = (Axis + 1) % 3;
    const int AB = (Axis + 2) % 3;
    int3 Lo = VoxelSetAxis(int3(0, 0, 0), Axis, 2 * int(R % N));
    Lo = VoxelSetAxis(Lo, A, 2 * int((R / N) % (N + 1u)));
    Lo = VoxelSetAxis(Lo, AB, 2 * int(R / (N * (N + 1u))));
    const int3 Hi = VoxelAddAxis(Lo, Axis, 2);

    const float D0 = Dense[VoxelMesherDenseIndex(B, Lo)];
    const float D1 = Dense[VoxelMesherDenseIndex(B, Hi)];
    if ((D0 < 0.0f) == (D1 < 0.0f)) return;

    // The four cells around the edge: (+A,+B), (-A,+B), (-A,-B), (+A,-B). The owner is the
    // meshed brick of this level that sorts last (z, then y, then x) among theirs.
    const FVoxelStitchBrick Brick = VoxelMesherStitchBrick(B);
    uint Slots[4];
    int3 Owner = int3(-2, -2, -2);
    for (int c = 0; c < 4; c++)
    {
        float3 Probe = VoxelAddAxisF(VoxelToFloat3(Lo), Axis, 1.0f);
        Probe = VoxelAddAxisF(Probe, A, (c == 1 || c == 2) ? -VoxelProbeOffset : VoxelProbeOffset);
        Probe = VoxelAddAxisF(Probe, AB, c >= 2 ? -VoxelProbeOffset : VoxelProbeOffset);
        const FVoxelStitchCell Cell = VoxelStitchCellAt(Brick, Probe);
        if (Cell.Level < 0) return;
        const int3 Block = int3(VoxelStitchBlockOf(Cell.Min.x, CellsPerBrick), VoxelStitchBlockOf(Cell.Min.y, CellsPerBrick), VoxelStitchBlockOf(Cell.Min.z, CellsPerBrick));
        const bool bLater = Block.z > Owner.z || (Block.z == Owner.z && (Block.y > Owner.y || (Block.y == Owner.y && Block.x > Owner.x)));
        if (Cell.Level == 0 && bLater && VoxelStitchIsMeshed(Brick, VoxelStitchDirection(Block.x, Block.y, Block.z)))
            Owner = Block;
        Slots[c] = VoxelMesherSlotOf(Cell);
    }
    if (Owner.x != 0 || Owner.y != 0 || Owner.z != 0) return;

    uint Face = 0u;
    InterlockedAdd(Counters[B * 4u], 1u, Face);
    if (Face >= FaceCap)
    {
        InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorFaces);
        return;
    }
    const uint Base = (B * FaceCap + Face) * 4u;
    Faces[Base] = Slots[0] | (D0 < 0.0f ? 0x80000000u : 0u);
    Faces[Base + 1u] = Slots[1];
    Faces[Base + 2u] = Slots[2];
    Faces[Base + 3u] = Slots[3];
    // Marked, with no vertex until VoxelMesherSolvePass gives one (SlotVertex is not cleared:
    // only marked slots are ever read).
    for (int k = 0; k < 4; k++)
    {
        SlotState[B * VoxelMesherNumSlots() + Slots[k]] = 1u;
        SlotVertex[B * VoxelMesherNumSlots() + Slots[k]] = VoxelMesherNone;
    }
}

// Mode 0: the ends of every edge of a marked cell. Mode 1: the gradient points of its crossed
// edges. Points on the own lattice are skipped.
VOXEL_FUNC void VoxelMesherRequestPass(uint Id, uint Mode)
{
    if (Id >= NumBricks * VoxelMesherNumSlots() || SlotState[Id] == 0u) return;
    const uint B = Id / VoxelMesherNumSlots();
    const FVoxelStitchBrick Brick = VoxelMesherStitchBrick(B);
    const FVoxelStitchCell Cell = VoxelMesherCellOf(Id % VoxelMesherNumSlots());
    VOXEL_LOOP
    for (int s = 0; s < 48; s++)
    {
        const FVoxelStitchEdge E = VoxelStitchCellEdge(Brick, Cell, s);
        if (!E.Valid) continue;
        const int3 Hi = VoxelAddAxis(E.Lo, E.Axis, E.Length);
        if (Mode == 0u)
        {
            VoxelMesherRequest(B, E.Lo);
            VoxelMesherRequest(B, Hi);
            continue;
        }
        if ((VoxelMesherSampleAt(B, E.Lo) < 0.0f) == (VoxelMesherSampleAt(B, Hi) < 0.0f)) continue;
        VOXEL_LOOP
        for (int Axis = 0; Axis < 3; Axis++)
        {
            const int3 Step = VoxelSetAxis(int3(0, 0, 0), Axis, E.Length);
            VoxelMesherRequest(B, E.Lo + Step);
            VoxelMesherRequest(B, E.Lo - Step);
            VoxelMesherRequest(B, Hi + Step);
            VoxelMesherRequest(B, Hi - Step);
        }
    }
}

// A unit normal from a gradient sum, or the radial direction at the lattice point Radial
// when the sum is shorter than sqrt(MinLengthSq) (the CPU mesher's tolerance, in the sum's
// units).
VOXEL_FUNC float3 VoxelMesherSafeNormal(float3 N, float MinLengthSq, float3 Radial)
{
    const float LengthSq = dot(N, N);
    if (LengthSq > MinLengthSq)
        return N / sqrt(LengthSq);
    return Radial / max(length(Radial), 1.0e-6f);
}

// The CPU mesher normalises gradients in density per cm (central differences over 2 Length
// units) and treats a squared length below 1e-8 as flat; the passes use raw differences, so
// that tolerance scales by the span squared.
VOXEL_FUNC float VoxelMesherGradientTolerance(int Length, float Unit)
{
    const float Span = 2.0f * float(Length) * Unit;
    return 1.0e-8f * Span * Span;
}

// The vertex of a marked cell: QEF over the crossings of its minimal edges.
VOXEL_FUNC void VoxelMesherSolvePass(uint Id)
{
    if (Id >= NumBricks * VoxelMesherNumSlots() || SlotState[Id] == 0u) return;
    const uint B = Id / VoxelMesherNumSlots();
    const FVoxelStitchBrick Brick = VoxelMesherStitchBrick(B);
    const FVoxelStitchCell Cell = VoxelMesherCellOf(Id % VoxelMesherNumSlots());
    const float S = float(Cell.Size);
    const float Unit = ldexp(FinestCell, Bricks[B].Level - 1);

    FVoxelQef Q = VoxelQefBegin();
    VOXEL_LOOP
    for (int s = 0; s < 48; s++)
    {
        const FVoxelStitchEdge E = VoxelStitchCellEdge(Brick, Cell, s);
        if (!E.Valid) continue;
        const int3 Hi = VoxelAddAxis(E.Lo, E.Axis, E.Length);
        const float D0 = VoxelMesherSampleAt(B, E.Lo);
        const float D1 = VoxelMesherSampleAt(B, Hi);
        if ((D0 < 0.0f) == (D1 < 0.0f)) continue;

        const float Denominator = D0 - D1;
        const float T = abs(Denominator) < 1.0e-12f ? 0.5f : saturate(D0 / Denominator);
        const float3 P = VoxelAddAxisF(VoxelToFloat3(E.Lo - Cell.Min), E.Axis, T * float(E.Length)) / S;

        const float3 G0 = VoxelMesherGradient(B, E.Lo, E.Length);
        const float3 G1 = VoxelMesherGradient(B, Hi, E.Length);
        const float3 Normal = VoxelMesherSafeNormal(G0 + (G1 - G0) * T, VoxelMesherGradientTolerance(E.Length, Unit),
            VoxelToFloat3(VoxelMesherLatticeIndex(B, E.Lo)));
        Q = VoxelQefAdd(Q, P, Normal);
    }
    if (Q.Count == 0) return;

    // Without a normal sum, the radial direction at the vertex (the lattice index of the
    // brick min plus the vertex's offset in lattice units), as the CPU mesher.
    const float3 Local = VoxelToFloat3(Cell.Min) + VoxelQefVertex(Q) * S;
    const float3 VertexNormal = VoxelMesherSafeNormal(Q.NormalSum, 1.0e-8f,
        VoxelToFloat3(VoxelMesherLatticeIndex(B, int3(0, 0, 0))) + Local * float(1u << uint(Bricks[B].Level)));

    uint V = 0u;
    InterlockedAdd(Counters[B * 4u + 1u], 1u, V);
    if (V >= VertexCap)
    {
        InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorVertices);
        return;
    }
    const uint Base = (B * VertexCap + V) * VoxelMesherVertexStride;
    Vertices[Base] = Local.x * Unit;
    Vertices[Base + 1u] = Local.y * Unit;
    Vertices[Base + 2u] = Local.z * Unit;
    Vertices[Base + 3u] = VertexNormal.x;
    Vertices[Base + 4u] = VertexNormal.y;
    Vertices[Base + 5u] = VertexNormal.z;
    // Floats 6 to 23 and 26 to 31 are written by VoxelMesherVertexTargetsPass for every vertex
    // stored here. 25 is the debug colour (0xRRGGBB as an exact float): white here, the land
    // view's when one runs (VoxelLandDebug.ush).
    Vertices[Base + 24u] = float(Cell.Level);
    Vertices[Base + 25u] = 16777215.0f;
    SlotVertex[Id] = V;
    const uint Targets = B * VoxelMesherNumTargets();
    const uint ParentSlot = VoxelMesherTargetOf(Cell);
    TargetState[Targets + ParentSlot] = 1u;
    TargetState[Targets + VoxelMesherTargetOf(VoxelMesherTargetCell(ParentSlot))] = 1u;
    // A coarse cell always touches the brick; an own cell may touch finer neighbours.
    if (Cell.Level > 0 || VoxelMesherTouchesFiner(B, Cell))
        TargetState[Targets + VoxelMesherTargetSlot(Cell)] = 1u;
}

VOXEL_FUNC float3 VoxelMesherVertexPosition(uint B, uint V)
{
    const uint Base = (B * VertexCap + V) * VoxelMesherVertexStride;
    return float3(Vertices[Base], Vertices[Base + 1u], Vertices[Base + 2u]);
}

VOXEL_FUNC void VoxelMesherEmitTriangle(uint B, uint VA, uint VB, uint VC, bool bFlip)
{
    uint T = 0u;
    InterlockedAdd(Counters[B * 4u + 2u], 1u, T);
    if (T >= TriangleCap)
    {
        InterlockedOr(Counters[B * 4u + 3u], VoxelMesherErrorTriangles);
        return;
    }
    const uint Base = (B * TriangleCap + T) * 3u;
    Indices[Base] = VA;
    Indices[Base + 1u] = bFlip ? VC : VB;
    Indices[Base + 2u] = bFlip ? VB : VC;
}

VOXEL_FUNC float3 VoxelSafeNormalize(float3 V)
{
    const float L = length(V);
    return L > 1.0e-20f ? V / L : float3(0.0f, 0.0f, 0.0f);
}

// One face: the vertices of its four cells, deduplicated around the ring, as one or two
// triangles with the CPU mesher's split choice and winding.
VOXEL_FUNC void VoxelMesherTrianglesPass(uint Id)
{
    if (Id >= NumBricks * FaceCap) return;
    const uint B = Id / FaceCap;
    const uint F = Id % FaceCap;
    if (F >= min(Counters[B * 4u], FaceCap)) return;

    const uint Base = Id * 4u;
    const bool bFlip = (Faces[Base] & 0x80000000u) != 0u;
    uint Ring[4];
    int Count = 0;
    bool bValid = true;
    for (int c = 0; c < 4; c++)
    {
        const uint Slot = Faces[Base + uint(c)] & 0x7fffffffu;
        const uint V = SlotVertex[B * VoxelMesherNumSlots() + Slot];
        bValid = bValid && V != VoxelMesherNone;
        if (Count == 0 || Ring[Count - 1] != V)
        {
            Ring[Count] = V;
            Count += 1;
        }
    }
    if (Count > 1 && Ring[Count - 1] == Ring[0]) Count -= 1;
    if (!bValid || Count < 3) return;

    if (Count == 3)
    {
        VoxelMesherEmitTriangle(B, Ring[0], Ring[1], Ring[2], bFlip);
        return;
    }
    const float3 P0 = VoxelMesherVertexPosition(B, Ring[0]);
    const float3 P1 = VoxelMesherVertexPosition(B, Ring[1]);
    const float3 P2 = VoxelMesherVertexPosition(B, Ring[2]);
    const float3 P3 = VoxelMesherVertexPosition(B, Ring[3]);
    const float FoldA = dot(VoxelSafeNormalize(cross(P1 - P0, P2 - P0)), VoxelSafeNormalize(cross(P2 - P0, P3 - P0)));
    const float FoldB = dot(VoxelSafeNormalize(cross(P1 - P0, P3 - P0)), VoxelSafeNormalize(cross(P2 - P1, P3 - P1)));
    if (FoldB > FoldA)
    {
        VoxelMesherEmitTriangle(B, Ring[0], Ring[1], Ring[3], bFlip);
        VoxelMesherEmitTriangle(B, Ring[1], Ring[2], Ring[3], bFlip);
    }
    else
    {
        VoxelMesherEmitTriangle(B, Ring[0], Ring[1], Ring[2], bFlip);
        VoxelMesherEmitTriangle(B, Ring[0], Ring[2], Ring[3], bFlip);
    }
}

// Mode 0: the ends of every edge of a needed target cell in its frame. Mode 2: a target of a
// coarser level without a crossing marks its neighbours on the surface's side and their
// parents, whose vertices its finer vertices may take (VoxelMesherTargetFor). Mode 3: mode 0
// for those. Mode 1: the gradient points of every target's crossed edges, of every corner for
// a coarser target. Each point at its owner's level in the frame.
VOXEL_FUNC void VoxelMesherTargetRequestPass(uint Id, uint Mode)
{
    if (Id >= NumBricks * VoxelMesherNumTargets() || TargetState[Id] == 0u) return;
    if (Mode == 3u && TargetState[Id] != 4u) return;
    const uint B = Id / VoxelMesherNumTargets();
    const FVoxelStitchCell Cell = VoxelMesherTargetCell(Id % VoxelMesherNumTargets());
    const FVoxelMesherFrame F = VoxelMesherTargetFrame(B, Cell);
    if (Mode == 2u)
    {
        if (TargetState[Id] != 1u || Cell.Level == 0) return;
        const float3 Dir = VoxelMesherSurfaceDirection(VoxelMesherTargetCorners(B, F, Cell));
        for (int k = 0; k < 4; k++)
        {
            const FVoxelStitchCell X = VoxelMesherSurfaceNeighbour(Cell, Dir, k);
            if (X.Level < 0) continue;
            VoxelMesherMarkNeighbourTarget(B, X);
            if (X.Level < 3) VoxelMesherMarkNeighbourTarget(B, VoxelMesherParentCell(X));
        }
        return;
    }
    if (Mode == 1u && Cell.Level > 0)
    {
        // A coarser target's frame is all of its level: the gradient points of every corner
        // (VoxelMesherCoarseNormal), which include those of its crossed edges.
        VOXEL_LOOP
        for (int c = 0; c < 8; c++)
        {
            const int3 Corner = Cell.Min + int3((c & 1) * Cell.Size, ((c >> 1) & 1) * Cell.Size, (c >> 2) * Cell.Size);
            VOXEL_LOOP
            for (int Axis = 0; Axis < 3; Axis++)
            {
                const int3 Step = VoxelSetAxis(int3(0, 0, 0), Axis, Cell.Size);
                VoxelMesherTargetRequest(B, Corner + Step, VoxelMesherFrameTag(F, Corner + Step));
                VoxelMesherTargetRequest(B, Corner - Step, VoxelMesherFrameTag(F, Corner - Step));
            }
        }
        return;
    }
    VOXEL_LOOP
    for (int s = 0; s < 48; s++)
    {
        const FVoxelStitchEdge E = VoxelMesherFrameEdge(F, Cell, s);
        if (!E.Valid) continue;
        const int3 Hi = VoxelAddAxis(E.Lo, E.Axis, E.Length);
        if (Mode != 1u)
        {
            VoxelMesherTargetRequest(B, E.Lo, VoxelMesherFrameTag(F, E.Lo));
            VoxelMesherTargetRequest(B, Hi, VoxelMesherFrameTag(F, Hi));
            continue;
        }
        if ((VoxelMesherFrameSample(B, F, E.Lo) < 0.0f) == (VoxelMesherFrameSample(B, F, Hi) < 0.0f)) continue;
        VOXEL_LOOP
        for (int Axis = 0; Axis < 3; Axis++)
        {
            const int3 Step = VoxelSetAxis(int3(0, 0, 0), Axis, E.Length);
            VoxelMesherTargetRequest(B, E.Lo + Step, VoxelMesherFrameTag(F, E.Lo + Step));
            VoxelMesherTargetRequest(B, E.Lo - Step, VoxelMesherFrameTag(F, E.Lo - Step));
            VoxelMesherTargetRequest(B, Hi + Step, VoxelMesherFrameTag(F, Hi + Step));
            VoxelMesherTargetRequest(B, Hi - Step, VoxelMesherFrameTag(F, Hi - Step));
        }
    }
}

// A target cell's vertex as VoxelMesherSolvePass computes it in the brick of the target's
// level, stitched as its frame says: the same edges in the same order, the same samples.
// Without a crossing the state is 3 and VoxelMesherVertexTargetsPass places each vertex.
VOXEL_FUNC void VoxelMesherTargetSolvePass(uint Id)
{
    if (Id >= NumBricks * VoxelMesherNumTargets() || TargetState[Id] == 0u) return;
    const uint B = Id / VoxelMesherNumTargets();
    const FVoxelStitchCell Cell = VoxelMesherTargetCell(Id % VoxelMesherNumTargets());
    const FVoxelMesherFrame F = VoxelMesherTargetFrame(B, Cell);
    const float S = float(Cell.Size);
    const float Unit = ldexp(FinestCell, Bricks[B].Level - 1);

    FVoxelQef Q = VoxelQefBegin();
    VOXEL_LOOP
    for (int s = 0; s < 48; s++)
    {
        const FVoxelStitchEdge E = VoxelMesherFrameEdge(F, Cell, s);
        if (!E.Valid) continue;
        const int3 Hi = VoxelAddAxis(E.Lo, E.Axis, E.Length);
        const float D0 = VoxelMesherFrameSample(B, F, E.Lo);
        const float D1 = VoxelMesherFrameSample(B, F, Hi);
        if ((D0 < 0.0f) == (D1 < 0.0f)) continue;

        const float Denominator = D0 - D1;
        const float T = abs(Denominator) < 1.0e-12f ? 0.5f : saturate(D0 / Denominator);
        const float3 P = VoxelAddAxisF(VoxelToFloat3(E.Lo - Cell.Min), E.Axis, T * float(E.Length)) / S;

        const float3 G0 = VoxelMesherTargetGradient(B, F, E.Lo, E.Length);
        const float3 G1 = VoxelMesherTargetGradient(B, F, Hi, E.Length);
        const float3 Normal = VoxelMesherSafeNormal(G0 + (G1 - G0) * T, VoxelMesherGradientTolerance(E.Length, Unit),
            VoxelToFloat3(VoxelMesherLatticeIndex(B, E.Lo)));
        Q = VoxelQefAdd(Q, P, Normal);
    }

    // No crossing: state 3, and VoxelMesherTargetFor places each vertex from the corners
    // (TargetData is read for state 2 only).
    if (Q.Count == 0)
    {
        TargetState[Id] = 3u;
        return;
    }
    const uint Base = Id * 6u;
    const float3 Local = VoxelToFloat3(Cell.Min) + VoxelQefVertex(Q) * S;
    const float3 VertexNormal = VoxelMesherSafeNormal(Q.NormalSum, 1.0e-8f,
        VoxelToFloat3(VoxelMesherLatticeIndex(B, int3(0, 0, 0))) + Local * float(1u << uint(Bricks[B].Level)));
    TargetData[Base] = Local.x;
    TargetData[Base + 1u] = Local.y;
    TargetData[Base + 2u] = Local.z;
    TargetData[Base + 3u] = VertexNormal.x;
    TargetData[Base + 4u] = VertexNormal.y;
    TargetData[Base + 5u] = VertexNormal.z;
    TargetState[Id] = 2u;
}

// A target as a point (units) of the finer level blends toward it: the target cell's vertex
// (state 2). When the cell has no crossing (state 3) the finer surface there is detail the
// coarser lattice doesn't see, and the coarser surface lies past the cell, in a neighbour:
// the first of those mode 2 marked that has a vertex (faces from the steepest, then the
// diagonal), which is what the coarser level draws there. All the cell's vertices take the
// same one, so a vertex's target doesn't jump when the level drawing it changes. Without one,
// the point moves onto the zero set of the cell's trilinear field (one Newton step, at most a
// cell). Slot is the target taken, whose own target is the next level's. bNeighbours is false
// where another brick sharing the vertex may not look at neighbours: the parent of a
// neighbour taken (mode 2 may not have marked its neighbours), and an unstitched solve (a
// cell's own in set 0 here may be a coarse cell's in set 1 there).
struct FVoxelMesherTarget
{
    float3 Position;
    float3 Normal;
    uint Slot;
};

VOXEL_FUNC FVoxelMesherTarget VoxelMesherSolvedTarget(uint B, uint Slot)
{
    const uint Target = B * VoxelMesherNumTargets() + Slot;
    FVoxelMesherTarget Out;
    Out.Position = float3(TargetData[Target * 6u], TargetData[Target * 6u + 1u], TargetData[Target * 6u + 2u]);
    Out.Normal = float3(TargetData[Target * 6u + 3u], TargetData[Target * 6u + 4u], TargetData[Target * 6u + 5u]);
    Out.Slot = Slot;
    return Out;
}

VOXEL_FUNC FVoxelMesherTarget VoxelMesherTargetFor(uint B, uint TargetSlot, float3 Point, float3 Normal, bool bNeighbours)
{
    FVoxelMesherTarget Out;
    Out.Position = Point;
    Out.Normal = Normal;
    Out.Slot = TargetSlot;
    const uint State = TargetState[B * VoxelMesherNumTargets() + TargetSlot];
    if (State == 2u) return VoxelMesherSolvedTarget(B, TargetSlot);
    if (State != 3u) return Out;

    const FVoxelStitchCell Parent = VoxelMesherTargetCell(TargetSlot);
    const FVoxelMesherFrame Frame = VoxelMesherTargetFrame(B, Parent);
    const FVoxelMesherCorners C = VoxelMesherTargetCorners(B, Frame, Parent);
    if (Parent.Level > 0 && bNeighbours)
    {
        const float3 Dir = VoxelMesherSurfaceDirection(C);
        for (int k = 0; k < 4; k++)
        {
            const FVoxelStitchCell X = VoxelMesherSurfaceNeighbour(Parent, Dir, k);
            if (X.Level < 0 || !VoxelMesherTargetInSet(X)) continue;
            const uint XSlot = VoxelMesherTargetSlot(X);
            if (TargetState[B * VoxelMesherNumTargets() + XSlot] == 2u) return VoxelMesherSolvedTarget(B, XSlot);
        }
    }

    const float S = float(Parent.Size);
    const float3 U = (Point - VoxelToFloat3(Parent.Min)) / S;
    const float X0 = 1.0f - U.x;
    const float Y0 = 1.0f - U.y;
    const float Z0 = 1.0f - U.z;
    const float F = Z0 * (Y0 * (X0 * C.D[0] + U.x * C.D[1]) + U.y * (X0 * C.D[2] + U.x * C.D[3]))
        + U.z * (Y0 * (X0 * C.D[4] + U.x * C.D[5]) + U.y * (X0 * C.D[6] + U.x * C.D[7]));
    const float3 G = float3(
        Z0 * (Y0 * (C.D[1] - C.D[0]) + U.y * (C.D[3] - C.D[2])) + U.z * (Y0 * (C.D[5] - C.D[4]) + U.y * (C.D[7] - C.D[6])),
        Z0 * (X0 * (C.D[2] - C.D[0]) + U.x * (C.D[3] - C.D[1])) + U.z * (X0 * (C.D[6] - C.D[4]) + U.x * (C.D[7] - C.D[5])),
        Y0 * (X0 * (C.D[4] - C.D[0]) + U.x * (C.D[5] - C.D[1])) + U.y * (X0 * (C.D[6] - C.D[2]) + U.x * (C.D[7] - C.D[3])));
    const float GG = dot(G, G);
    if (GG < 1.0e-12f) return Out;
    float3 Step = G * (-F / GG);
    const float StepLength = length(Step);
    if (StepLength > 1.0f) Step = Step / StepLength;
    Out.Position = Point + Step * S;
    Out.Normal = G / sqrt(GG);
    return Out;
}

// The normal field of a coarser target cell's level at Point (units; clamped to the cell):
// the central-difference gradients at its corners, interpolated trilinearly, which is
// continuous from cell to cell. Fallback where the field is flat.
VOXEL_FUNC float3 VoxelMesherCoarseNormal(uint B, uint TargetSlot, float3 Point, float3 Fallback)
{
    const FVoxelStitchCell T = VoxelMesherTargetCell(TargetSlot);
    const FVoxelMesherFrame F = VoxelMesherTargetFrame(B, T);
    const float3 R = (Point - VoxelToFloat3(T.Min)) / float(T.Size);
    const float3 U = float3(saturate(R.x), saturate(R.y), saturate(R.z));
    float3 G = float3(0.0f, 0.0f, 0.0f);
    VOXEL_LOOP
    for (int c = 0; c < 8; c++)
    {
        const int3 Corner = T.Min + int3((c & 1) * T.Size, ((c >> 1) & 1) * T.Size, (c >> 2) * T.Size);
        const float W = ((c & 1) != 0 ? U.x : 1.0f - U.x) * ((c & 2) != 0 ? U.y : 1.0f - U.y) * ((c & 4) != 0 ? U.z : 1.0f - U.z);
        G = G + VoxelMesherTargetGradient(B, F, Corner, T.Size) * W;
    }
    const float LengthSq = dot(G, G);
    return LengthSq > 1.0e-12f ? G / sqrt(LengthSq) : Fallback;
}

// Each solved cell's targets into its vertex record (cm from the brick min): the parent's,
// the parent target's own, as the brick of the parent's level computes it for that vertex,
// the cell's unstitched solve (its own position where no finer leaf touches it), and the
// coarser levels' normals: the parent's level's at the unstitched position, and the level
// after's at the parent target, which the parent's brick computes for that vertex too.
VOXEL_FUNC void VoxelMesherVertexTargetsPass(uint Id)
{
    if (Id >= NumBricks * VoxelMesherNumSlots() || SlotState[Id] == 0u) return;
    const uint V = SlotVertex[Id];
    if (V == VoxelMesherNone || V >= VertexCap) return;
    const uint B = Id / VoxelMesherNumSlots();
    const FVoxelStitchCell Cell = VoxelMesherCellOf(Id % VoxelMesherNumSlots());
    const float Unit = ldexp(FinestCell, Bricks[B].Level - 1);
    const uint Base = (B * VertexCap + V) * VoxelMesherVertexStride;
    const float3 Own = float3(Vertices[Base], Vertices[Base + 1u], Vertices[Base + 2u]) / Unit;
    const float3 OwnNormal = float3(Vertices[Base + 3u], Vertices[Base + 4u], Vertices[Base + 5u]);

    const uint ParentSlot = VoxelMesherTargetOf(Cell);
    const FVoxelMesherTarget Parent = VoxelMesherTargetFor(B, ParentSlot, Own, OwnNormal, true);
    const uint GrandSlot = VoxelMesherTargetOf(VoxelMesherTargetCell(Parent.Slot));
    const FVoxelMesherTarget Grand = VoxelMesherTargetFor(B, GrandSlot, Parent.Position, Parent.Normal, Parent.Slot == ParentSlot);
    Vertices[Base + 6u] = Parent.Position.x * Unit;
    Vertices[Base + 7u] = Parent.Position.y * Unit;
    Vertices[Base + 8u] = Parent.Position.z * Unit;
    Vertices[Base + 9u] = Parent.Normal.x;
    Vertices[Base + 10u] = Parent.Normal.y;
    Vertices[Base + 11u] = Parent.Normal.z;
    Vertices[Base + 12u] = Grand.Position.x * Unit;
    Vertices[Base + 13u] = Grand.Position.y * Unit;
    Vertices[Base + 14u] = Grand.Position.z * Unit;
    Vertices[Base + 15u] = Grand.Normal.x;
    Vertices[Base + 16u] = Grand.Normal.y;
    Vertices[Base + 17u] = Grand.Normal.z;
    FVoxelMesherTarget Unstitched;
    Unstitched.Position = Own;
    Unstitched.Normal = OwnNormal;
    if (VoxelMesherTargetInSet(Cell))
        Unstitched = VoxelMesherTargetFor(B, VoxelMesherTargetSlot(Cell), Own, OwnNormal, false);
    Vertices[Base + 18u] = Unstitched.Position.x * Unit;
    Vertices[Base + 19u] = Unstitched.Position.y * Unit;
    Vertices[Base + 20u] = Unstitched.Position.z * Unit;
    Vertices[Base + 21u] = Unstitched.Normal.x;
    Vertices[Base + 22u] = Unstitched.Normal.y;
    Vertices[Base + 23u] = Unstitched.Normal.z;
    const float3 Coarse = VoxelMesherCoarseNormal(B, ParentSlot, Unstitched.Position, Parent.Normal);
    const float3 ParentCoarse = VoxelMesherCoarseNormal(B, GrandSlot, Parent.Position, Grand.Normal);
    Vertices[Base + 26u] = Coarse.x;
    Vertices[Base + 27u] = Coarse.y;
    Vertices[Base + 28u] = Coarse.z;
    Vertices[Base + 29u] = ParentCoarse.x;
    Vertices[Base + 30u] = ParentCoarse.y;
    Vertices[Base + 31u] = ParentCoarse.z;
}

#endif // VOXEL_BRICK_MESHER_PASSES_USH
