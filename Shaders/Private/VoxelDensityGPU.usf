// VoxelDensityGPU.usf - Samples the planet density on a box of lattice points
// (FVoxelDensityCS, VoxelDensityGPU.cpp). The evaluation is VoxelDensitySample.ush.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelDensityCore.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelDF64.ush"

StructuredBuffer<FVoxelOctave> Octaves;
RWStructuredBuffer<float> OutDensity;

int3 BlockMin;
int3 BlockDim;
int BlockStep;
uint OutOffset;
float SampleFootprint;
uint OutputMode;   // 0 density, 1 |p| - R only, 2 edit delta only
float2 HalfFinest;

uint ContinentOctaves;
uint MountainOctaves;
uint DetailOctaves;
float2 InvNormContinent;
float2 InvNormMountain;
float2 InvNormDetail;
float2 PlanetRadius;
float2 NoiseAmplitude;
float2 ContinentWeight;
float2 MountainWeight;
float2 MountainStart;
float2 MountainBlend;
float2 DetailWeight;
float RidgeGain;
float SlopeDamping;

// Edits (VoxelEditSample.ush).
StructuredBuffer<float> EditCorners;
StructuredBuffer<int> EditChildren;
StructuredBuffer<uint> EditFlags;
uint EditNodeCount;
int EditRootExtent;

#include "/Plugin/VoxelPlugin/Private/VoxelDensitySample.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelEditSample.ush"

[numthreads(GROUP_SIZE, GROUP_SIZE, GROUP_SIZE)]
void MainCS(uint3 Id : SV_DispatchThreadID)
{
    if (Id.x >= (uint)BlockDim.x || Id.y >= (uint)BlockDim.y || Id.z >= (uint)BlockDim.z) return;

    const int3 Index = BlockMin + int3(Id) * BlockStep;
    const uint Linear = Id.x + (uint)BlockDim.x * (Id.y + (uint)BlockDim.y * Id.z);
    float Value = 0.0f;
    if (OutputMode == 1u)
        Value = VoxelRadialDF(Index.x, Index.y, Index.z);
    else if (OutputMode == 2u)
        Value = VoxelEditDelta(Index.x, Index.y, Index.z);
    else
        Value = VoxelSampleDensityDF(Index.x, Index.y, Index.z, SampleFootprint);
    OutDensity[OutOffset + Linear] = Value;
}
