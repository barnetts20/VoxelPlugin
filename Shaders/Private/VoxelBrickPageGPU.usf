// VoxelBrickPageGPU.usf - The brick pages' passes (VoxelBrickPages.cpp).
//
// StageCS runs ahead of a commit (async compute): it converts a mesher batch
// (VoxelBrickMesherGPU.usf) into the mesh cache, each brick's vertices in the page format and
// its indices brick-local, packed in order into the cache region the CPU reserved for the batch.
// A brick that doesn't fit what is left is skipped (it is queued and meshed again). Per brick an entry
// is read back: where it went, its counts and error bits.
//
// WriteCS runs in a page buffer set's compute run at the commit. A job is one brick: its
// vertices and triangles copied from the cache to where the CPU placed them (indices rebased),
// or the triangles a departed brick left cleared (degenerate). Group 0 writes the draw
// arguments. Bricks a commit doesn't change are not touched.
//
// Page format: position (page-local, in units of the page's level: cm / 2^level, the component
// carries the scale), tangent and normal (snorm8 x4), and texture coordinates 0 to 7 as 16
// words: the triplanar UV; the parent and grandparent offsets (level units, page axes); their
// normals, octahedral 11 bits per axis, the parent's plus 2^22 times the cell's level above
// the page's (0 or 1), as exact floats; the unstitched offset and its normal, packed the same;
// the parent level's normal field at the unstitched position and the grandparent level's at
// the parent target, packed the same (VoxelMorph.ush). Colour is the page's.

#include "/Engine/Public/Platform.ush"

#define VOXEL_CACHE_WORDS 21u    // VoxelBrickPagesDetail::CacheWords
#define VOXEL_ENTRY_WORDS 8u     // VoxelBrickPagesDetail::EntryWords
#define VOXEL_JOB_WORDS 8u       // VoxelBrickPagesDetail::JobWords

static const uint TexCoordWords = 16u;

// StageCS
StructuredBuffer<uint> MesherCounters;     // per brick: faces, vertices, triangles, error bits
StructuredBuffer<float> MesherVertices;    // per vertex: VertexStride floats
StructuredBuffer<uint> MesherIndices;
StructuredBuffer<float4> StageBricks;      // per brick: min from the page origin (cm), 2^-level; UV offset, UV scale
RWStructuredBuffer<uint> CacheVertices;    // VOXEL_CACHE_WORDS per vertex
RWStructuredBuffer<uint> CacheIndices;     // 3 per triangle
// Per brick: first vertex, vertices, first triangle, triangles (both 0 when skipped), error
// bits, 1 if stored, and the vertices and triangles it has.
RWStructuredBuffer<uint> StageEntries;
uint NumBricks;
uint VertexCap;
uint TriangleCap;
uint VertexStride;
uint RegionVertexStart;
uint RegionVertices;
uint RegionTriangleStart;
uint RegionTriangles;

// WriteCS
StructuredBuffer<uint> CachedVertices;
StructuredBuffer<uint> CachedIndices;
// Per job: kind (0 copy, 1 clear), cache vertex, page vertex, vertices, cache triangle, page
// triangle, triangles, unused.
StructuredBuffer<uint> Jobs;
RWBuffer<float> OutPositions;
RWBuffer<uint> OutTangents;                // two packed normals per vertex: tangent, normal
RWBuffer<uint> OutTexCoords;               // TexCoordWords per vertex
RWBuffer<uint> OutColors;
RWBuffer<uint> OutIndices;
RWBuffer<uint> OutArgs;
uint NumJobs;
uint TriangleEnd;                          // triangles drawn
uint VertexCapacity;                       // page buffers
uint TriangleCapacity;
uint Color;
uint StreamMask;                           // 1 tangents, 2 UVs, 4 colours: streams the page has

uint PackSnorm8(float4 V)
{
    const int4 I = int4(round(clamp(V, -1.0f, 1.0f) * 127.0f));
    return (uint(I.x) & 0xffu) | ((uint(I.y) & 0xffu) << 8) | ((uint(I.z) & 0xffu) << 16) | ((uint(I.w) & 0xffu) << 24);
}

float3 SafeNormal(float3 N, float3 Fallback)
{
    return dot(N, N) > 1.0e-8f ? normalize(N) : Fallback;
}

// Octahedral normal, 11 bits per axis, as an integer below 2^22.
uint PackOctahedral(float3 N)
{
    N = N / max(abs(N.x) + abs(N.y) + abs(N.z), 1.0e-20f);
    float2 P = float2(N.x, N.y);
    if (N.z < 0.0f)
        P = float2((1.0f - abs(N.y)) * (N.x >= 0.0f ? 1.0f : -1.0f), (1.0f - abs(N.x)) * (N.y >= 0.0f ? 1.0f : -1.0f));
    const uint2 Q = uint2(round(saturate(P * 0.5f + 0.5f) * 2047.0f));
    return Q.x | (Q.y << 11);
}

uint StageVertices(uint B) { return min(MesherCounters[B * 4u + 1u], VertexCap); }
uint StageTriangles(uint B) { return min(MesherCounters[B * 4u + 2u], TriangleCap); }

groupshared uint StageBase[3];   // first vertex, first triangle, stored

// One group per brick of the batch.
[numthreads(64, 1, 1)]
void StageCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint B = GroupId.x;
    const uint V = StageVertices(B);
    const uint T = StageTriangles(B);
    if (GroupThread == 0u)
    {
        // The bricks before this one in order, each stored if it fits what is left.
        uint UsedV = 0u;
        uint UsedT = 0u;
        [loop]
        for (uint K = 0u; K < B; K++)
        {
            const uint KV = StageVertices(K);
            const uint KT = StageTriangles(K);
            if (UsedV + KV <= RegionVertices && UsedT + KT <= RegionTriangles)
            {
                UsedV += KV;
                UsedT += KT;
            }
        }
        const bool bFits = UsedV + V <= RegionVertices && UsedT + T <= RegionTriangles;
        StageBase[0] = RegionVertexStart + UsedV;
        StageBase[1] = RegionTriangleStart + UsedT;
        StageBase[2] = bFits ? 1u : 0u;
        const uint E = B * VOXEL_ENTRY_WORDS;
        StageEntries[E] = StageBase[0];
        StageEntries[E + 1u] = bFits ? V : 0u;
        StageEntries[E + 2u] = StageBase[1];
        StageEntries[E + 3u] = bFits ? T : 0u;
        StageEntries[E + 4u] = MesherCounters[B * 4u + 3u];
        StageEntries[E + 5u] = StageBase[2];
        StageEntries[E + 6u] = V;
        StageEntries[E + 7u] = T;
    }
    GroupMemoryBarrierWithGroupSync();
    if (StageBase[2] == 0u) return;

    const float4 Place = StageBricks[B * 2u];
    const float4 UVs = StageBricks[B * 2u + 1u];
    [loop]
    for (uint I = GroupThread; I < V; I += 64u)
    {
        const uint Src = (B * VertexCap + I) * VertexStride;
        const float3 Own = float3(MesherVertices[Src], MesherVertices[Src + 1u], MesherVertices[Src + 2u]);
        const float3 Cm = Own + Place.xyz;
        const float3 N = SafeNormal(float3(MesherVertices[Src + 3u], MesherVertices[Src + 4u], MesherVertices[Src + 5u]), float3(0.0f, 0.0f, 1.0f));
        const float3 Parent = (float3(MesherVertices[Src + 6u], MesherVertices[Src + 7u], MesherVertices[Src + 8u]) - Own) * Place.w;
        const float3 ParentNormal = SafeNormal(float3(MesherVertices[Src + 9u], MesherVertices[Src + 10u], MesherVertices[Src + 11u]), N);
        const float3 Grand = (float3(MesherVertices[Src + 12u], MesherVertices[Src + 13u], MesherVertices[Src + 14u]) - Own) * Place.w;
        const float3 GrandNormal = SafeNormal(float3(MesherVertices[Src + 15u], MesherVertices[Src + 16u], MesherVertices[Src + 17u]), ParentNormal);
        const float3 Unstitched = (float3(MesherVertices[Src + 18u], MesherVertices[Src + 19u], MesherVertices[Src + 20u]) - Own) * Place.w;
        const float3 UnstitchedNormal = SafeNormal(float3(MesherVertices[Src + 21u], MesherVertices[Src + 22u], MesherVertices[Src + 23u]), N);
        const uint Rel = uint(MesherVertices[Src + 24u] + 0.5f);
        const float3 CoarseNormal = SafeNormal(float3(MesherVertices[Src + 26u], MesherVertices[Src + 27u], MesherVertices[Src + 28u]), ParentNormal);
        const float3 ParentCoarseNormal = SafeNormal(float3(MesherVertices[Src + 29u], MesherVertices[Src + 30u], MesherVertices[Src + 31u]), GrandNormal);

        // Triplanar UV from the dominant normal axis, in cm (the page origin's whole periods dropped).
        const float3 A = abs(N);
        float2 UV = float2(UVs.x, UVs.y) + Cm.xy * UVs.w;
        if (A.x > A.y && A.x > A.z)
            UV = float2(UVs.y, UVs.z) + Cm.yz * UVs.w;
        else if (A.y > A.x && A.y > A.z)
            UV = float2(UVs.x, UVs.z) + Cm.xz * UVs.w;

        const float3 P = Cm * Place.w;
        const float3 Axis = abs(N.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
        const uint Dst = (StageBase[0] + I) * VOXEL_CACHE_WORDS;
        CacheVertices[Dst] = asuint(P.x);
        CacheVertices[Dst + 1u] = asuint(P.y);
        CacheVertices[Dst + 2u] = asuint(P.z);
        CacheVertices[Dst + 3u] = PackSnorm8(float4(normalize(cross(Axis, N)), 1.0f));
        CacheVertices[Dst + 4u] = PackSnorm8(float4(N, 1.0f));
        CacheVertices[Dst + 5u] = asuint(UV.x);
        CacheVertices[Dst + 6u] = asuint(UV.y);
        CacheVertices[Dst + 7u] = asuint(Parent.x);
        CacheVertices[Dst + 8u] = asuint(Parent.y);
        CacheVertices[Dst + 9u] = asuint(Parent.z);
        CacheVertices[Dst + 10u] = asuint(Grand.x);
        CacheVertices[Dst + 11u] = asuint(Grand.y);
        CacheVertices[Dst + 12u] = asuint(Grand.z);
        CacheVertices[Dst + 13u] = asuint(float(PackOctahedral(ParentNormal) + (Rel << 22)));
        CacheVertices[Dst + 14u] = asuint(float(PackOctahedral(GrandNormal)));
        CacheVertices[Dst + 15u] = asuint(Unstitched.x);
        CacheVertices[Dst + 16u] = asuint(Unstitched.y);
        CacheVertices[Dst + 17u] = asuint(Unstitched.z);
        CacheVertices[Dst + 18u] = asuint(float(PackOctahedral(UnstitchedNormal)));
        CacheVertices[Dst + 19u] = asuint(float(PackOctahedral(CoarseNormal)));
        CacheVertices[Dst + 20u] = asuint(float(PackOctahedral(ParentCoarseNormal)));
    }
    [loop]
    for (uint J = GroupThread; J < T; J += 64u)
    {
        const uint Src = (B * TriangleCap + J) * 3u;
        uint3 Tri = uint3(MesherIndices[Src], MesherIndices[Src + 1u], MesherIndices[Src + 2u]);
        // A vertex the mesher couldn't store (its error bits say so): degenerate.
        if (Tri.x >= V || Tri.y >= V || Tri.z >= V)
            Tri = uint3(0u, 0u, 0u);
        const uint Dst = (StageBase[1] + J) * 3u;
        CacheIndices[Dst] = Tri.x;
        CacheIndices[Dst + 1u] = Tri.y;
        CacheIndices[Dst + 2u] = Tri.z;
    }
}

// One group per job; group 0 also writes FRHIDrawIndexedIndirectParameters (index count,
// instances, first index, base vertex, first instance).
[numthreads(64, 1, 1)]
void WriteCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Job = GroupId.x;
    if (Job == 0u && GroupThread == 0u)
    {
        OutArgs[0] = min(TriangleEnd, TriangleCapacity) * 3u;
        OutArgs[1] = 1u;
        OutArgs[2] = 0u;
        OutArgs[3] = 0u;
        OutArgs[4] = 0u;
    }
    if (Job >= NumJobs) return;

    const uint W = Job * VOXEL_JOB_WORDS;
    const bool bCopy = Jobs[W] == 0u;
    const uint DstV = Jobs[W + 2u];
    const uint NumV = Jobs[W + 3u];
    const uint SrcT = Jobs[W + 4u];
    const uint DstT = Jobs[W + 5u];
    const uint NumT = Jobs[W + 6u];
    if (bCopy)
    {
        const uint SrcV = Jobs[W + 1u];
        [loop]
        for (uint I = GroupThread; I < NumV && DstV + I < VertexCapacity; I += 64u)
        {
            const uint Src = (SrcV + I) * VOXEL_CACHE_WORDS;
            const uint Dst = DstV + I;
            OutPositions[Dst * 3u] = asfloat(CachedVertices[Src]);
            OutPositions[Dst * 3u + 1u] = asfloat(CachedVertices[Src + 1u]);
            OutPositions[Dst * 3u + 2u] = asfloat(CachedVertices[Src + 2u]);
            if (StreamMask & 1u)
            {
                OutTangents[Dst * 2u] = CachedVertices[Src + 3u];
                OutTangents[Dst * 2u + 1u] = CachedVertices[Src + 4u];
            }
            if (StreamMask & 2u)
            {
                [unroll]
                for (uint C = 0u; C < TexCoordWords; C++)
                    OutTexCoords[Dst * TexCoordWords + C] = CachedVertices[Src + 5u + C];
            }
            if (StreamMask & 4u)
                OutColors[Dst] = Color;
        }
    }
    [loop]
    for (uint J = GroupThread; J < NumT && DstT + J < TriangleCapacity; J += 64u)
    {
        const uint Dst = (DstT + J) * 3u;
        if (bCopy)
        {
            const uint Src = (SrcT + J) * 3u;
            OutIndices[Dst] = DstV + CachedIndices[Src];
            OutIndices[Dst + 1u] = DstV + CachedIndices[Src + 1u];
            OutIndices[Dst + 2u] = DstV + CachedIndices[Src + 2u];
        }
        else
        {
            OutIndices[Dst] = 0u;
            OutIndices[Dst + 1u] = 0u;
            OutIndices[Dst + 2u] = 0u;
        }
    }
}
