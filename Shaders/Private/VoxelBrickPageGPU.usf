// VoxelBrickPageGPU.usf - Packs a brick page's buffers (VoxelBrickPages.cpp): the morph data per
// vertex (position and normal, and the parent cell's), triplanar UVs, colours, indices and the
// indirect draw arguments. Bricks the page held unchanged are copied from a snapshot of its
// previous contents (Reuse* passes); the others come from the mesher's per-brick output
// (VoxelBrickMesherGPU.usf). MorphCS writes positions and tangents from the morph data.
//
// Commits are checked before they are drawn: the placement passes (OffsetsCS, ReuseOffsetsCS)
// of every page in a frame run first, and any brick that doesn't fit clears Verdict. Then no
// page of that frame writes anything (the passes below return early, ArgsCS keeps the old
// draw arguments): the old tree stays on screen whole until the pages are resized.
//
// Geomorphing: a vertex of a cell of level l blends toward its parent cell's vertex as its
// distance d goes from MorphStart0 * 2^l to MorphEnd0 * 2^l (VoxelBrickPages.cpp,
// MorphDistances): fully morphed wherever level l can meet level l + 1, not morphed at all
// where a level l + 1 brick may still be splitting into level l.

#include "/Engine/Public/Platform.ush"

StructuredBuffer<uint> MesherCounters;     // per mesher row: faces, vertices, triangles, error bits
StructuredBuffer<float> MesherVertices;    // per vertex: position from the brick min, normal
StructuredBuffer<uint> MesherIndices;
StructuredBuffer<float4> BrickOffsets;     // brick min from the page origin (cm)

// 0 vertices needed, 1 triangles needed, 2 error bits, 3 vertices written, 4 triangles written,
// 5 bricks dropped (did not fit), 6 vertex capacity, 7 triangle capacity, 8 verdict.
RWStructuredBuffer<uint> PageState;
RWStructuredBuffer<uint> Verdict;          // 1 until a page of the frame's batch doesn't fit (placement)
StructuredBuffer<uint> CommitVerdict;      // the same, read by the passes that write
RWStructuredBuffer<uint> BrickBase;        // per brick: first vertex, first triangle, written

RWBuffer<float> OutPositions;
RWBuffer<uint> OutTangents;                // two packed normals per vertex: tangent, normal
RWBuffer<uint> OutTexCoords;               // half2
RWBuffer<uint> OutColors;
RWBuffer<uint> OutIndices;
RWBuffer<uint> OutArgs;

RWStructuredBuffer<uint> MorphData;        // per vertex, MorphStride words
RWStructuredBuffer<uint> MorphCount;       // vertices written

// Per member brick, 4 words: first vertex, vertices, first triangle, triangles (0 when it
// didn't fit). The new table is written; the previous one is read by the Reuse passes.
RWStructuredBuffer<uint> BrickTable;
StructuredBuffer<uint> OldTable;
StructuredBuffer<uint> OldMorphData;       // snapshots of the previous contents
StructuredBuffer<uint> OldIndices;
// Per batch brick, 2 words: where it comes from (its row in the mesher output, or its row in
// the previous table for the reuse batch) and its member index.
StructuredBuffer<uint> BrickMap;

uint NumBricks;
uint VertexCap;          // mesher slots per brick
uint TriangleCap;
uint VertexCapacity;     // page buffers
uint TriangleCapacity;
uint Color;
uint StreamMask;         // 1 tangents, 2 UVs, 4 colours: streams the page has
int PageLevel;
uint VertexStride;       // mesher vertex record (VoxelMesherVertexStride)
float3 CameraRel;        // camera from the page origin
float MorphStart0;       // level-0 morph distances (cm)
float MorphEnd0;
uint MorphMode;          // 0 off, 1 by distance, 2 fully morphed
float MorphSlack;        // cm the camera may be ahead of the tree: narrows the band
float3 UVOffset;         // frac(page origin * UVScale)
float UVScale;
uint GroupsX;

uint ThreadIndex(uint3 GroupId, uint GroupThread)
{
    return (GroupId.y * GroupsX + GroupId.x) * 64u + GroupThread;
}

static const uint MorphStride = 9u;   // position, target position, level, normal, target normal

uint BrickVertices(uint B) { return min(MesherCounters[B * 4u + 1u], VertexCap); }
uint BrickTriangles(uint B) { return min(MesherCounters[B * 4u + 2u], TriangleCap); }

uint PackSnorm8(float4 V)
{
    const int4 I = int4(round(clamp(V, -1.0f, 1.0f) * 127.0f));
    return (uint(I.x) & 0xffu) | ((uint(I.y) & 0xffu) << 8) | ((uint(I.z) & 0xffu) << 16) | ((uint(I.w) & 0xffu) << 24);
}

float3 UnpackSnorm8(uint P)
{
    const int3 I = int3(int(P << 24) >> 24, int(P << 16) >> 24, int(P << 8) >> 24);
    return float3(I) / 127.0f;
}

float3 SafeNormal(float3 N, float3 Fallback)
{
    return dot(N, N) > 1.0e-8f ? normalize(N) : Fallback;
}

// Single thread: places the batch's bricks after those already written and records them in
// the new table. A brick that doesn't fit whole is dropped (counted), so a page never shows
// part of a brick. bReuse: the counts come from the previous table.
void PlaceBricks(bool bReuse)
{
    uint Written[2] = { PageState[3], PageState[4] };
    uint Needed[2] = { PageState[0], PageState[1] };
    uint Errors = PageState[2];
    uint Dropped = PageState[5];
    [loop]
    for (uint B = 0u; B < NumBricks; B++)
    {
        const uint Row = BrickMap[B * 2u];
        const uint Member = BrickMap[B * 2u + 1u];
        uint V = 0u;
        uint T = 0u;
        if (bReuse)
        {
            V = OldTable[Row * 4u + 1u];
            T = OldTable[Row * 4u + 3u];
        }
        else
        {
            V = BrickVertices(Row);
            T = BrickTriangles(Row);
            Errors |= MesherCounters[Row * 4u + 3u];
        }
        Needed[0] += V;
        Needed[1] += T;
        const bool bFits = Written[0] + V <= VertexCapacity && Written[1] + T <= TriangleCapacity;
        BrickBase[B * 3u] = Written[0];
        BrickBase[B * 3u + 1u] = Written[1];
        BrickBase[B * 3u + 2u] = bFits ? 1u : 0u;
        BrickTable[Member * 4u] = Written[0];
        BrickTable[Member * 4u + 1u] = bFits ? V : 0u;
        BrickTable[Member * 4u + 2u] = Written[1];
        BrickTable[Member * 4u + 3u] = bFits ? T : 0u;
        if (bFits)
        {
            Written[0] += V;
            Written[1] += T;
        }
        else
        {
            Dropped++;
        }
    }
    PageState[0] = Needed[0];
    PageState[1] = Needed[1];
    PageState[2] = Errors;
    PageState[3] = Written[0];
    PageState[4] = Written[1];
    PageState[5] = Dropped;
    PageState[6] = VertexCapacity;
    PageState[7] = TriangleCapacity;
    if (Dropped > 0u)
        Verdict[0] = 0u;
}

[numthreads(1, 1, 1)]
void OffsetsCS()
{
    PlaceBricks(false);
}

[numthreads(1, 1, 1)]
void ReuseOffsetsCS()
{
    PlaceBricks(true);
}

// The streams derived from a vertex's position and normal: triplanar UVs as the CPU renderer
// picks them (the page origin's whole periods dropped), and the colour.
void WriteDerived(uint Dst, float3 P, float3 N)
{
    const float3 A = abs(N);
    float2 UV = float2(UVOffset.x, UVOffset.y) + P.xy * UVScale;
    if (A.x > A.y && A.x > A.z)
        UV = float2(UVOffset.y, UVOffset.z) + P.yz * UVScale;
    else if (A.y > A.x && A.y > A.z)
        UV = float2(UVOffset.x, UVOffset.z) + P.xz * UVScale;
    if (StreamMask & 2u)
        OutTexCoords[Dst] = f32tof16(UV.x) | (f32tof16(UV.y) << 16);
    if (StreamMask & 4u)
        OutColors[Dst] = Color;
}

[numthreads(64, 1, 1)]
void VerticesCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Id = ThreadIndex(GroupId, GroupThread);
    if (CommitVerdict[0] == 0u) return;
    const uint B = Id / VertexCap;
    const uint V = Id - B * VertexCap;
    if (B >= NumBricks || BrickBase[B * 3u + 2u] == 0u) return;
    const uint Row = BrickMap[B * 2u];
    if (V >= BrickVertices(Row)) return;

    const uint Src = (Row * VertexCap + V) * VertexStride;
    const float3 Offset = BrickOffsets[B].xyz;
    const float3 P = float3(MesherVertices[Src], MesherVertices[Src + 1u], MesherVertices[Src + 2u]) + Offset;
    const float3 N = SafeNormal(float3(MesherVertices[Src + 3u], MesherVertices[Src + 4u], MesherVertices[Src + 5u]), float3(0.0f, 0.0f, 1.0f));
    const float3 TP = float3(MesherVertices[Src + 6u], MesherVertices[Src + 7u], MesherVertices[Src + 8u]) + Offset;
    const float3 TN = SafeNormal(float3(MesherVertices[Src + 9u], MesherVertices[Src + 10u], MesherVertices[Src + 11u]), N);
    const uint Level = uint(PageLevel + int(MesherVertices[Src + 12u] + 0.5f));

    const uint Dst = BrickBase[B * 3u] + V;
    const uint M = Dst * MorphStride;
    MorphData[M] = asuint(P.x);
    MorphData[M + 1u] = asuint(P.y);
    MorphData[M + 2u] = asuint(P.z);
    MorphData[M + 3u] = asuint(TP.x);
    MorphData[M + 4u] = asuint(TP.y);
    MorphData[M + 5u] = asuint(TP.z);
    MorphData[M + 6u] = Level;
    MorphData[M + 7u] = PackSnorm8(float4(N, 1.0f));
    MorphData[M + 8u] = PackSnorm8(float4(TN, 1.0f));
    // From the packed normal, as a copy of this vertex (ReuseVerticesCS) does.
    WriteDerived(Dst, P, UnpackSnorm8(MorphData[M + 7u]));
}

// A reused brick's vertex: its morph data as it was, at its new place.
[numthreads(64, 1, 1)]
void ReuseVerticesCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Id = ThreadIndex(GroupId, GroupThread);
    if (CommitVerdict[0] == 0u) return;
    const uint B = Id / VertexCap;
    const uint V = Id - B * VertexCap;
    if (B >= NumBricks || BrickBase[B * 3u + 2u] == 0u) return;
    const uint Old = BrickMap[B * 2u];
    if (V >= OldTable[Old * 4u + 1u]) return;

    const uint Src = (OldTable[Old * 4u] + V) * MorphStride;
    const uint Dst = BrickBase[B * 3u] + V;
    [unroll]
    for (uint W = 0u; W < MorphStride; W++)
        MorphData[Dst * MorphStride + W] = OldMorphData[Src + W];
    const float3 P = float3(asfloat(OldMorphData[Src]), asfloat(OldMorphData[Src + 1u]), asfloat(OldMorphData[Src + 2u]));
    WriteDerived(Dst, P, UnpackSnorm8(OldMorphData[Src + 7u]));
}

[numthreads(64, 1, 1)]
void TrianglesCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Id = ThreadIndex(GroupId, GroupThread);
    if (CommitVerdict[0] == 0u) return;
    const uint B = Id / TriangleCap;
    const uint T = Id - B * TriangleCap;
    if (B >= NumBricks || BrickBase[B * 3u + 2u] == 0u) return;
    const uint Row = BrickMap[B * 2u];
    if (T >= BrickTriangles(Row)) return;

    const uint NumVertices = BrickVertices(Row);
    const uint Base = BrickBase[B * 3u];
    const uint Src = (Row * TriangleCap + T) * 3u;
    uint I[3] = { MesherIndices[Src], MesherIndices[Src + 1u], MesherIndices[Src + 2u] };
    if (I[0] >= NumVertices || I[1] >= NumVertices || I[2] >= NumVertices)
    {
        // A vertex the mesher couldn't store (its error bits say so): degenerate.
        I[0] = 0u;
        I[1] = 0u;
        I[2] = 0u;
    }
    const uint Dst = (BrickBase[B * 3u + 1u] + T) * 3u;
    OutIndices[Dst] = Base + I[0];
    OutIndices[Dst + 1u] = Base + I[1];
    OutIndices[Dst + 2u] = Base + I[2];
}

// A reused brick's triangle, its indices moved with its vertices.
[numthreads(64, 1, 1)]
void ReuseTrianglesCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Id = ThreadIndex(GroupId, GroupThread);
    if (CommitVerdict[0] == 0u) return;
    const uint B = Id / TriangleCap;
    const uint T = Id - B * TriangleCap;
    if (B >= NumBricks || BrickBase[B * 3u + 2u] == 0u) return;
    const uint Old = BrickMap[B * 2u];
    if (T >= OldTable[Old * 4u + 3u]) return;

    const uint OldBase = OldTable[Old * 4u];
    const uint Base = BrickBase[B * 3u];
    const uint Src = (OldTable[Old * 4u + 2u] + T) * 3u;
    const uint Dst = (BrickBase[B * 3u + 1u] + T) * 3u;
    [unroll]
    for (uint K = 0u; K < 3u; K++)
        OutIndices[Dst + K] = OldIndices[Src + K] - OldBase + Base;
}

// FRHIDrawIndexedIndirectParameters: index count, instances, first index, base vertex, first
// instance. Left as they are when the frame's commit was refused.
[numthreads(1, 1, 1)]
void ArgsCS()
{
    PageState[8] = CommitVerdict[0];
    if (CommitVerdict[0] == 0u) return;
    MorphCount[0] = PageState[3];
    OutArgs[0] = PageState[4] * 3u;
    OutArgs[1] = 1u;
    OutArgs[2] = 0u;
    OutArgs[3] = 0u;
    OutArgs[4] = 0u;
}

// Positions and tangents of the page's vertices for the current camera.
[numthreads(64, 1, 1)]
void MorphCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint V = ThreadIndex(GroupId, GroupThread);
    if (V >= MorphCount[0] || V >= VertexCapacity) return;
    const uint M = V * MorphStride;
    const float3 P = float3(asfloat(MorphData[M]), asfloat(MorphData[M + 1u]), asfloat(MorphData[M + 2u]));
    const float3 TP = float3(asfloat(MorphData[M + 3u]), asfloat(MorphData[M + 4u]), asfloat(MorphData[M + 5u]));
    const float Scale = exp2(float(MorphData[M + 6u]));

    float T = MorphMode == 2u ? 1.0f : 0.0f;
    if (MorphMode == 1u)
    {
        const float Start = MorphStart0 * Scale + MorphSlack;
        const float End = MorphEnd0 * Scale - MorphSlack;
        const float Distance = length(P - CameraRel);
        if (End > Start)
        {
            const float X = saturate((Distance - Start) / (End - Start));
            T = X * X * (3.0f - 2.0f * X);
        }
        else
        {
            T = Distance >= 0.5f * (Start + End) ? 1.0f : 0.0f;
        }
    }
    const float3 Position = lerp(P, TP, T);
    OutPositions[V * 3u] = Position.x;
    OutPositions[V * 3u + 1u] = Position.y;
    OutPositions[V * 3u + 2u] = Position.z;

    if ((StreamMask & 1u) == 0u) return;
    const float3 N0 = UnpackSnorm8(MorphData[M + 7u]);
    const float3 N = SafeNormal(lerp(N0, UnpackSnorm8(MorphData[M + 8u]), T), N0);
    const float3 Axis = abs(N.z) < 0.999f ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
    const float3 Tangent = normalize(cross(Axis, N));
    OutTangents[V * 2u] = PackSnorm8(float4(Tangent, 1.0f));
    OutTangents[V * 2u + 1u] = PackSnorm8(float4(N, 1.0f));
}
