// VoxelUnderwater.ush - The ocean seen from below (Design/OceanMeshing.md section 5). The pass
// that runs it is VoxelUnderwaterPass.usf, from the ocean's view extension
// (FVoxelUnderwaterViewExtension, ahead of depth of field, after the atmosphere). This file
// holds only the optics, so any pass that needs them (the atmosphere's march, later) includes it.
//
// Per pixel:
// 1. Waterline. The pixel's point on the near plane is below the surface (the sea sphere and
//    the waves): the pixel looks through water. A frame crossing the surface splits pixel by
//    pixel, along the line where the near plane cuts the surface.
// 2. Meniscus. A thin tint where the near-plane point is within Meniscus.w cm of the surface.
// 3. Water path. An underwater ray runs through water from the near plane to the scene, or to
//    where it leaves through the surface if that comes first (the stable root of the ray and
//    the sphere; with waves, the first crossing marched across the waves' shell).
// 4. Absorption and in-scatter over that path, per channel (Absorption and Scattering, per
//    metre): the scene fades toward the water's own colour, Light * Scattering / Extinction.
// 5. The underside. The surface is one-sided, so seen from below it isn't drawn and the scene
//    colour already holds what is above the water. Where the ray leaves through the surface,
//    inside Snell's window (incidence below about 48.6 degrees from the surface normal) it
//    shows that scene colour, less the Fresnel reflection; outside, total internal reflection
//    shows the water below. The normal there includes the waves.
// 6. Foam (stage O9c; with the map's foam, VOXEL_UNDERWATER_MAP_FOAM_LOAD, and the includer's
//    VOXEL_UNDERWATER_FOAM_COLOR: rgb in the scene colour's units, a 0 off): where the ray leaves,
//    the surface's foam covers what lies beyond by its amount, lit from above (whitecaps, the
//    surf's bores and the swash seen from below), before the water's extinction along the path.
//
// Positions are from the view's camera (the reference point): W.Center is the planet centre from
// it, Sphere = (sea radius, the camera's height above the sphere), both formed in double on the
// CPU. Heights come from the stable sphere formula (VoxelOceanSphereHeight) less the waves at
// the surface point above (VoxelOceanHeightAtFFT, the wave hook, any model: the cascade
// textures come along as VOXEL_OCEAN_TEXTURE_PARAMS), so the waterline is exact to well under
// a millimetre at the near plane, horizontal displacement included.
//
// THE FFT MODEL reads the surface map instead (VoxelUnderwaterMap.ush, written once per view by
// UnderwaterMapCS from the same inversion): every height the pass asks for is one bilinear read
// (two at a level's edge) instead of an inversion of a dozen cascade lookups per chart, and the
// underside's normal comes from the map's heights. The includer that has the map defines
// VOXEL_UNDERWATER_MAP_LOAD and the rest (VoxelUnderwaterMap.ush) before including this file.

#pragma once

#include "/Plugin/VoxelPlugin/Private/VoxelOceanWaves.ush"

#ifdef VOXEL_UNDERWATER_MAP_LOAD
#include "/Plugin/VoxelPlugin/Private/VoxelUnderwaterMap.ush"
#define VOXEL_UNDERWATER_HAS_MAP 1
#else
#define VOXEL_UNDERWATER_HAS_MAP 0
#endif

#if VOXEL_UNDERWATER_HAS_MAP && defined(VOXEL_UNDERWATER_MAP_FOAM_LOAD) && defined(VOXEL_UNDERWATER_FOAM_COLOR)
#define VOXEL_UNDERWATER_HAS_FOAM 1
#else
#define VOXEL_UNDERWATER_HAS_FOAM 0
#endif

// An exit distance meaning the ray doesn't leave the water nearby.
#define VOXEL_UNDERWATER_NO_EXIT 3.0e38f
// The scene distance of a pixel showing nothing (the sky).
#define VOXEL_UNDERWATER_FAR 1.0e30f

// Where along Dir a ray from a point at sphere height Height (cm, from the planet centre O,
// B = O . Dir) leaves the sphere of radius R + Offset from inside it: the stable root of
// t^2 + 2 B t + c = 0, c = |O|^2 - (R + Offset)^2 = (Height - Offset) (2R + Height + Offset).
float VoxelUnderwaterShellExit(float B, float Height, float Radius, float Offset)
{
    const float C = (Height - Offset) * (2.0f * Radius + Height + Offset);
    const float Root = sqrt(max(B * B - C, 0.0f));
    return B > 0.0f ? -C / max(B + Root, 1.0e-6f) : Root - B;
}

// Q's height above the surface (cm; Q from the camera): the map's surface with the FFT model when
// the includer has the map, the wave hook's search otherwise. Mask as VoxelOceanHeightAtFFTMask:
// VOXEL_OCEAN_LOOKUP_ALL fills OutSurface.Normal.
float VoxelUnderwaterHeight(float3 Q, float2 Sphere, FVoxelOceanWaveParams W, VOXEL_OCEAN_TEXTURE_PARAMS, uint Mask, out FVoxelOceanWaveOutput OutSurface)
{
#if VOXEL_UNDERWATER_HAS_MAP
    if (W.FFT.x >= 0.5f)
    {
        const float Height = VoxelOceanSphereHeight(Q, Sphere.x, Sphere.y, normalize(-W.Center));
        const float3 Up = normalize(Q - W.Center);
        const float3 Foot = Q - Up * Height;
        OutSurface = (FVoxelOceanWaveOutput)0;
        const float Surface = VoxelUnderwaterMapHeight(Foot);
        OutSurface.Height = Surface;
        OutSurface.Normal = (Mask & 2u) != 0u ? VoxelUnderwaterMapNormal(Foot, Up) : Up;
        OutSurface.Jacobian = 1.0f;
        return Height - Surface;
    }
    // The other models (the map pass runs only for the FFT one). Not the FFT search: its code
    // would set this shader's registers even untaken.
    return VoxelOceanHeightAt(Q, Sphere, W, OutSurface);
#else
    return VoxelOceanHeightAtFFTMask(Q, Sphere, W, VOXEL_OCEAN_TEXTURE_ARGS, Mask, 0.0f, OutSurface);
#endif
}

// How far from Start (below the surface) along Dir the ray leaves through the surface;
// VOXEL_UNDERWATER_NO_EXIT when it doesn't nearby (it heads down into deep water). Without
// waves it is the sphere's stable root. With them the surface lies in a shell of +-MaxHeight
// around the sphere (VoxelOceanMaxHeight): the ray is marched across that shell (16 steps, 32
// on the map, denser near the start; a ray heading down stops where it dives below the shell)
// and the first crossing is bisected (6 times, 10 on the map). Inside Snell's window the exit is within a centimetre of the first
// crossing; a grazing ray may skip a crest tip it only clips, where total internal reflection
// shows the water colour either way. OutSurface receives the waves where it leaves.
float VoxelUnderwaterExit(float3 Start, float3 Dir, float2 Sphere, FVoxelOceanWaveParams W, VOXEL_OCEAN_TEXTURE_PARAMS, out FVoxelOceanWaveOutput OutSurface)
{
    const float Height = VoxelOceanSphereHeight(Start, Sphere.x, Sphere.y, normalize(-W.Center));
    const float B = dot(Start - W.Center, Dir);
    const float MaxHeight = VoxelOceanMaxHeight(W);
    if (MaxHeight <= 0.0f)
    {
        const float T = VoxelUnderwaterShellExit(B, Height, Sphere.x, 0.0f);
        VoxelUnderwaterHeight(Start + Dir * T, Sphere, W, VOXEL_OCEAN_TEXTURE_ARGS, VOXEL_OCEAN_LOOKUP_ALL, OutSurface);
        return T;
    }

    const float Shell = MaxHeight + 1.0f;
    OutSurface = (FVoxelOceanWaveOutput)0;
    // Below the waves' shell and heading down: deep water all the way.
    if (Height < -Shell && B < 0.0f) return VOXEL_UNDERWATER_NO_EXIT;
    const float Lower = Height < -Shell ? VoxelUnderwaterShellExit(B, Height, Sphere.x, -Shell) : 0.0f;
    float Upper = max(VoxelUnderwaterShellExit(B, Height, Sphere.x, Shell), Lower);
    // Heading down from inside the shell, the search ends where the ray dives below it (the
    // near root into the inner sphere, stable form); past that it is deep water.
    if (Height >= -Shell && B < 0.0f)
    {
        const float Inner = (Height + Shell) * (2.0f * Sphere.x + Height - Shell);
        const float Disc = B * B - Inner;
        if (Disc >= 0.0f)
            Upper = min(Upper, Inner / max(sqrt(Disc) - B, 1.0e-6f));
    }
    float Below = Lower;
    float Above = Upper;
    bool bFound = false;
    FVoxelOceanWaveOutput Surface;
    // The map makes a step one read: more of them.
    const bool bMap = VOXEL_UNDERWATER_HAS_MAP != 0 && W.FFT.x >= 0.5f;
    const int Steps = bMap ? 32 : 16;
    const int Bisections = bMap ? 10 : 6;
    [loop]
    for (int Step = 1; Step <= Steps; Step++)
    {
        const float X = (float)Step / (float)Steps;
        const float T = Lower + (Upper - Lower) * X * X;
        if (VoxelUnderwaterHeight(Start + Dir * T, Sphere, W, VOXEL_OCEAN_TEXTURE_ARGS, VOXEL_OCEAN_LOOKUP_DISPLACEMENT, Surface) > 0.0f)
        {
            Above = T;
            bFound = true;
            break;
        }
        Below = T;
    }
    // No crossing before the ray dives below the shell: it stays in the water.
    if (!bFound) return VOXEL_UNDERWATER_NO_EXIT;
    [loop]
    for (int Bisect = 0; Bisect < Bisections; Bisect++)
    {
        const float Mid = 0.5f * (Below + Above);
        if (VoxelUnderwaterHeight(Start + Dir * Mid, Sphere, W, VOXEL_OCEAN_TEXTURE_ARGS, VOXEL_OCEAN_LOOKUP_DISPLACEMENT, Surface) > 0.0f)
            Above = Mid;
        else
            Below = Mid;
    }
    const float Exit = 0.5f * (Below + Above);
    VoxelUnderwaterHeight(Start + Dir * Exit, Sphere, W, VOXEL_OCEAN_TEXTURE_ARGS, VOXEL_OCEAN_LOOKUP_ALL, OutSurface);
    return Exit;
}

// Stage A7: THE WATER'S LIGHT AS SCATTERED SUNLIGHT AND SKYLIGHT, not a fog colour. The sun's beam
// refracts at the surface and dims along its slant path down (exp(-sigma_t d / mu_w)); the sky's
// light, and the sun's once scattered, come down diffusely and dim by Kd per metre of depth. Along
// the view ray the depth changes linearly (the local vertical, planar over the water's few hundred
// metres of visibility), so the single scattering integrates in closed form per channel: the sun's
// through the water's phase function (Henyey-Greenstein, g), the diffuse light's isotropically over
// the lower half (1 / 2 pi). Looking down darkens, looking up toward the sun glows, the deep goes
// dark; the bed's own light dims by the depth it lies at.
struct FVoxelUnderwaterLight
{
    float3 SunBeam;   // the sun's beam just under the surface, irradiance normal to it (pre-exposed)
    float3 SunDir;    // the beam's direction of travel in the water (unit, downward)
    float3 SkyDown;   // the diffuse light coming down just under the surface, on the horizontal
    float3 Kd;        // the diffuse light's attenuation with depth (per metre)
    float3 Up;        // the local vertical at the camera
    float PhaseG;
    float On;         // 0: the fog model (Light), as before
};

FVoxelUnderwaterLight VoxelUnderwaterNoLight()
{
    FVoxelUnderwaterLight L;
    L.SunBeam = float3(0.0f, 0.0f, 0.0f);
    L.SunDir = float3(0.0f, 0.0f, -1.0f);
    L.SkyDown = float3(0.0f, 0.0f, 0.0f);
    L.Kd = float3(0.0f, 0.0f, 0.0f);
    L.Up = float3(0.0f, 0.0f, 1.0f);
    L.PhaseG = 0.0f;
    L.On = 0.0f;
    return L;
}

/** The integral of exp(-A t) over [0, P] (per metre), per channel; its exponent held off overflow
 *  where A is negative (looking up toward brighter water). The series for small A P is formed from
 *  a clamped X: unclamped, a ray into open water (P the sky's 1e28 m) overflows it to -inf, and the
 *  lerp's 0 x inf made the whole pixel NaN (black), where the water should fade to its own light. */
float3 VoxelUnderwaterIntegralOf(float3 A, float P)
{
    const float3 X = A * P;
    const float3 SafeA = lerp(A, float3(1.0f, 1.0f, 1.0f), step(abs(A), float3(1.0e-6f, 1.0e-6f, 1.0e-6f)));
    const float3 Full = (1.0f - exp(-clamp(X, -60.0f, 60.0f))) / SafeA;
    const float3 Series = float3(P, P, P) * (1.0f - 0.5f * clamp(X, -1.0f, 1.0f));
    return lerp(Full, Series, step(abs(X), float3(1.0e-4f, 1.0e-4f, 1.0e-4f)));
}

// The longest path the scattering integrates (m): past it the water is opaque (the clearest
// water's extinction, about 0.02 per metre, leaves exp(-200)), so a ray that meets nothing, the
// sky's distance, converges on the water's own light: the fog it fades into.
#define VOXEL_UNDERWATER_MAX_PATH_M 1.0e4f

/** Henyey-Greenstein's phase function (per steradian). */
float VoxelUnderwaterPhaseOf(float CosTheta, float G)
{
    const float G2 = G * G;
    const float D = max(1.0f + G2 - 2.0f * G * CosTheta, 1.0e-4f);
    return (1.0f - G2) / (4.0f * 3.14159265f * D * sqrt(D));
}

/** The light the water scatters toward the eye along Dir from a point StartDepth (cm) under the
 *  surface, over Path (cm), per channel (per metre coefficients). */
float3 VoxelUnderwaterInscatterOf(float3 Dir, float StartDepth, float Path, float3 Scattering, float3 Extinction, FVoxelUnderwaterLight L)
{
    const float D0 = max(StartDepth, 0.0f) * 0.01f;
    const float P = clamp(Path * 0.01f, 0.0f, VOXEL_UNDERWATER_MAX_PATH_M);
    // Depth gained per metre along the ray; the beam's slant through the depth.
    const float S = -dot(Dir, L.Up);
    const float MuW = max(-dot(L.SunDir, L.Up), 0.05f);
    const float3 Sun0 = L.SunBeam * exp(-min(Extinction * (D0 / MuW), 60.0f));
    const float3 Sky0 = L.SkyDown * exp(-min(L.Kd * D0, 60.0f));
    // The scattering angle: from the beam's direction of travel to the light's toward the eye (-Dir):
    // looking up into the beam is forward scattering, looking down at the bed back scattering.
    const float Phase = VoxelUnderwaterPhaseOf(dot(-Dir, L.SunDir), L.PhaseG);
    const float3 SunTerm = Sun0 * Phase * VoxelUnderwaterIntegralOf(Extinction * (1.0f + S / MuW), P);
    const float3 SkyTerm = Sky0 * (1.0f / (2.0f * 3.14159265f)) * VoxelUnderwaterIntegralOf(Extinction + L.Kd * S, P);
    return max(Scattering * (SunTerm + SkyTerm), 0.0f);
}

// The scene colour seen through the water along one pixel's ray from the reference point.
// Dir: the ray (unit, world axes); NearDistance: to the near plane along it; SceneDistance: to
// the scene point (VOXEL_UNDERWATER_FAR for the sky). Light and Meniscus.rgb are in the scene
// colour's units (pre-exposed).
float3 VoxelUnderwaterColor(float3 SceneColor, float3 Dir, float NearDistance, float SceneDistance, float2 Sphere,
    FVoxelOceanWaveParams W, VOXEL_OCEAN_TEXTURE_PARAMS, float3 Absorption, float3 Scattering, float3 Light, float4 Meniscus,
    FVoxelUnderwaterLight Lit)
{
    // The pixel's point on the near plane.
    const float3 Near = Dir * NearDistance;
    FVoxelOceanWaveOutput NearSurface;
    const float NearHeight = VoxelUnderwaterHeight(Near, Sphere, W, VOXEL_OCEAN_TEXTURE_ARGS, VOXEL_OCEAN_LOOKUP_DISPLACEMENT, NearSurface);
    const float MeniscusMix = Meniscus.w > 0.0f ? 1.0f - saturate(abs(NearHeight) / Meniscus.w) : 0.0f;
    if (NearHeight > 0.0f)
        return lerp(SceneColor, Meniscus.rgb, MeniscusMix);

    // Under water: the path through it, and what lies at its end.
    const float3 Extinction = max(Absorption + Scattering, 1.0e-6f);
    const float3 WaterColor = Light * Scattering / Extinction;
    FVoxelOceanWaveOutput ExitSurface;
    const float Exit = VoxelUnderwaterExit(Near, Dir, Sphere, W, VOXEL_OCEAN_TEXTURE_ARGS, ExitSurface);
    const bool bExits = NearDistance + Exit < SceneDistance;
    const float Path = max(bExits ? Exit : SceneDistance - NearDistance, 0.0f);
    float3 Behind = SceneColor;
    if (bExits)
    {
        // The underside: Snell's window (refraction into air, Fresnel from the water side), total
        // internal reflection outside it. The normal is the displaced surface's where the ray
        // leaves.
        const float3 N = ExitSurface.Normal;
        const float CosI = dot(Dir, N);
        const float SinT2 = 1.7769f * max(1.0f - CosI * CosI, 0.0f);   // (1.333 sin(i))^2
        float Fresnel = 1.0f;
        if (CosI > 0.0f && SinT2 < 1.0f)
        {
            const float CosT = sqrt(1.0f - SinT2);
            const float X = 1.0f - CosT;
            Fresnel = 0.02f + 0.98f * X * X * X * X * X;
        }
        // (Stage A7: outside the window, the water below as seen along the reflected ray.)
        const float3 Mirrored = Lit.On > 0.5f
            ? VoxelUnderwaterInscatterOf(reflect(Dir, N), 0.0f, 1.0e5f, Scattering, Extinction, Lit) : WaterColor;
        Behind = lerp(SceneColor, Mirrored, Fresnel);
#if VOXEL_UNDERWATER_HAS_FOAM
        // The foam where it leaves (the map's, at the exit's foot on the sphere).
        const float4 FoamColor = VOXEL_UNDERWATER_FOAM_COLOR;
        if (W.FFT.x >= 0.5f && FoamColor.a > 0.0f)
        {
            const float3 ExitPoint = Near + Dir * Exit;
            const float ExitHeight = VoxelOceanSphereHeight(ExitPoint, Sphere.x, Sphere.y, normalize(-W.Center));
            const float3 ExitFoot = ExitPoint - normalize(ExitPoint - W.Center) * ExitHeight;
            Behind = lerp(Behind, FoamColor.rgb, VoxelUnderwaterMapFoam(ExitFoot));
        }
#endif
    }
    const float3 Transmittance = exp(-Extinction * min(Path * 0.01f, VOXEL_UNDERWATER_MAX_PATH_M));
    if (Lit.On > 0.5f)
    {
        // Stage A7: the scattered light along the path, from the near plane's depth; a bed (the
        // scene in the water) lit only by what comes down to the depth it lies at.
        const float StartDepth = max(-NearHeight, 0.0f);
        if (!bExits)
            Behind *= exp(-min(Lit.Kd * (max(StartDepth - dot(Dir, Lit.Up) * min(Path, VOXEL_UNDERWATER_MAX_PATH_M * 100.0f), 0.0f) * 0.01f), 60.0f));
        // Past the longest path nothing behind shows (and an unbounded sky colour can't make 0 x inf).
        Behind = Path * 0.01f < VOXEL_UNDERWATER_MAX_PATH_M ? Behind : float3(0.0f, 0.0f, 0.0f);
        const float3 Lit3 = Behind * Transmittance + VoxelUnderwaterInscatterOf(Dir, StartDepth, Path, Scattering, Extinction, Lit);
        return lerp(Lit3, Meniscus.rgb, MeniscusMix);
    }
    const float3 Color = Behind * Transmittance + WaterColor * (1.0f - Transmittance);
    return lerp(Color, Meniscus.rgb, MeniscusMix);
}
