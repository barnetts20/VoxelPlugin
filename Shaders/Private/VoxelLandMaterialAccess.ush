#define LandDetailSeed VoxelLandConstU32(LandConstTex, VOXEL_LAND_MC_DETAIL_SEED)
// The cost switch's detail (VoxelLandDetail.ush).
#define VOXEL_LAND_DETAIL_ON (!GVoxelLandSkipDetail)
#define LandStrataBase VoxelLandConstU32(LandConstTex, VOXEL_LAND_MC_STRATA_BASE)
#define LandStrataN VoxelLandConstU(LandConstTex, VOXEL_LAND_MC_STRATA_N)
#define LandStrataMips VoxelLandConstU(LandConstTex, VOXEL_LAND_MC_STRATA_MIPS)
