#define LandStrataScaleR VoxelLandConstF(LandConstTex, VOXEL_LAND_MC_STRATA_SCALE_R)
#define LandStrataScaleG VoxelLandConstF(LandConstTex, VOXEL_LAND_MC_STRATA_SCALE_G)
