#include "/Plugin/VoxelPlugin/Private/VoxelDF64.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelBrickStitch.ush"

// Density (VoxelDensitySample.ush).
StructuredBuffer<FVoxelOctave> Octaves;
float2 HalfFinest;
uint ContinentOctaves;
uint MountainOctaves;
uint DetailOctaves;
float2 InvNormContinent;
float2 InvNormMountain;
float2 InvNormDetail;
float2 PlanetRadius;
float2 NoiseAmplitude;
float2 ContinentWeight;
float2 MountainWeight;
float2 MountainStart;
float2 MountainBlend;
float2 DetailWeight;
float RidgeGain;
float SlopeDamping;

// Edits (VoxelEditSample.ush).
StructuredBuffer<float> EditCorners;
StructuredBuffer<int> EditChildren;
StructuredBuffer<uint> EditFlags;
uint EditNodeCount;
int EditRootExtent;

// Mesher (VoxelBrickMesherPasses.ush).
StructuredBuffer<FVoxelMesherBrick> Bricks;
int CellsPerBrick;
uint NumBricks;
uint HashSize;
uint FaceCap;
uint VertexCap;
uint TriangleCap;
float FinestCell;
float MinFootprint;
uint PassMode;
uint GroupsX;
RWStructuredBuffer<float> Dense;
RWStructuredBuffer<uint> HashKeys;
RWStructuredBuffer<uint> HashValues;
RWStructuredBuffer<uint> SlotState;
RWStructuredBuffer<uint> SlotVertex;
RWStructuredBuffer<uint> Faces;
RWStructuredBuffer<uint> Counters;
RWStructuredBuffer<float> Vertices;
RWStructuredBuffer<uint> Indices;
uint TargetHashSize;
RWStructuredBuffer<uint> TargetState;
RWStructuredBuffer<float> TargetData;
RWStructuredBuffer<uint> TargetHashKeys;
RWStructuredBuffer<uint> TargetHashValues;

#include "/Plugin/VoxelPlugin/Private/VoxelCubeSphere.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelLandParameters.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelLandSample.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelDensitySample.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelEditSample.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelBrickMesherPasses.ush"

// The land debug views (VoxelLandDebug.ush; FVoxelLandDebugParameters): the view, the bake's
// attributes, the sea radius, and the plate model's inputs (VoxelLandPlates.ush; the plates
// view reads the plates and the seed).
uint LandDebugMode;
StructuredBuffer<uint> LandAttr;
float2 LandDebugSeaRadius;
StructuredBuffer<uint> LandFlow;
StructuredBuffer<float> LandWater;
uint LandDebugHasHydro;
StructuredBuffer<float> LandPlates;
uint LandPlateCount;
uint LandSeed;
float LandRadiusM;
float LandWidthScale;
float LandReliefScale;
float LandShelfDepth;
float LandAbyssDepth;
float LandCoastHeight;
float LandInteriorHeight;

#include "/Plugin/VoxelPlugin/Private/VoxelLandPlates.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelLandDebugPalette.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelLandDebug.ush"

// Thread index over a 2D grid of 64-thread groups (GroupsX wide), so a pass can exceed 65535
// groups.
uint ThreadIndex(uint3 GroupId, uint GroupThread)
{
    return (GroupId.y * GroupsX + GroupId.x) * 64u + GroupThread;
}

[numthreads(64, 1, 1)]
void SampleCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelMesherSamplePass(ThreadIndex(GroupId, GroupThread), PassMode);
}

[numthreads(64, 1, 1)]
void EdgesCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelMesherEdgesPass(ThreadIndex(GroupId, GroupThread));
}

[numthreads(64, 1, 1)]
void RequestCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelMesherRequestPass(ThreadIndex(GroupId, GroupThread), PassMode);
}

[numthreads(64, 1, 1)]
void SolveCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelMesherSolvePass(ThreadIndex(GroupId, GroupThread));
}

[numthreads(64, 1, 1)]
void TrianglesCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelMesherTrianglesPass(ThreadIndex(GroupId, GroupThread));
}

[numthreads(64, 1, 1)]
void TargetRequestCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelMesherTargetRequestPass(ThreadIndex(GroupId, GroupThread), PassMode);
}

[numthreads(64, 1, 1)]
void TargetSolveCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelMesherTargetSolvePass(ThreadIndex(GroupId, GroupThread));
}

[numthreads(64, 1, 1)]
void VertexTargetsCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelMesherVertexTargetsPass(ThreadIndex(GroupId, GroupThread));
}

[numthreads(64, 1, 1)]
void LandDebugCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelLandDebugPass(ThreadIndex(GroupId, GroupThread));
}
