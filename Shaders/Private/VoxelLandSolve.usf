uint HistogramBin(float Relief)
{
    return min(uint(max(Relief, 0.0f) / HistogramMax * float(VOXEL_SOLVE_BINS)), VOXEL_SOLVE_BINS - 1u);
}

[numthreads(64, 1, 1)]
void HistogramCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Slot = ThreadIndex(GroupId, GroupThread);
    if (Slot >= NumSlots) return;
    const FVoxelSolveRelief R = VoxelSolveReliefOf(Slot);
    if (!R.bCounted) return;
    InterlockedAdd(Histogram[HistogramBin(R.Solved)], 1u);
    InterlockedAdd(Histogram[VOXEL_SOLVE_BINS + HistogramBin(R.Target)], 1u);
}

[numthreads(64, 1, 1)]
void NormaliseCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Cell = ThreadIndex(GroupId, GroupThread);
    if (SolveErode == 0u)
    {
        // No solve: the plate model's heights.
        if (Cell < VoxelSolveNumCells())
            SolveH[Cell] = BakeHeight[Cell];
        return;
    }
    VoxelSolveNormalisePass(Cell);
}

