// VoxelLandSolve.usf - The land bake's erosion solve and final routing on the GPU
// (VoxelLandSolve.cpp drives it). The per-cell work is VoxelLandSolve.ush; this file declares
// its inputs and the entry points, and adds the GPU-only parts: the compaction of a domain into
// slots (a deterministic scan, so slots are in cell order), the per-step residual (a fixed-order
// reduction) with the done flag every step's passes check, and the normalisation's histograms.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelDensityCore.ush"
#include "/Plugin/VoxelPlugin/Private/VoxelCubeSphere.ush"

// Grid and the plate model's fields.
uint SolveN;
uint SolvePad;
float SolveRadiusM;
StructuredBuffer<float2> SolveTan;
StructuredBuffer<float> BakeHeight;
StructuredBuffer<float> BakeUp;
StructuredBuffer<float> BakeCrust;
StructuredBuffer<uint> BakeAttr;

// The model.
float SolvePlainsUplift;
float SolveRampWidth;
float SolveUpliftTime;
float SolveKdt;
float SolveDt;
float SolveEps;
uint SolveSeed;
float SolveFactor;
float SolveReliefKnee;
float SolveReliefTop;
float SolveMinLakeDepth;
float SolveMinLakeArea;
uint SolveMaxLakes;
uint SolveErode;
// The T1 model (Design/SurfaceLook.md; VoxelLandSolve.ush lists them).
float SolveJitter;
float SolveRouteNoise;
float SolveSpreadCells;
float SolveUpliftVariation;
float SolveErodibilityVariation;
float SolveVariationWavelength;
float SolveRoughness;
float SolveReliefScale;
uint SolveFillDepressions;
uint SolveModel;
float SolvePlainsRelief;
float SolveUndulation;
float SolveIncision;

// Per cell.
RWStructuredBuffer<float> SolveH;
RWStructuredBuffer<float> SolveW;
RWStructuredBuffer<float> SolveWater;
RWStructuredBuffer<uint> SolveRec;
RWStructuredBuffer<uint> SolveSlot;
RWStructuredBuffer<uint> SolveLabel;

// Per slot.
RWStructuredBuffer<uint> SlotCell;
RWStructuredBuffer<float> SlotU;
RWStructuredBuffer<float> SlotK;
RWStructuredBuffer<float> SlotArea;
RWStructuredBuffer<float> SlotDist;
RWStructuredBuffer<float> SlotH0;
RWStructuredBuffer<float> SlotA;
RWStructuredBuffer<float> SlotAOut;
RWStructuredBuffer<float> SlotWOut;
RWStructuredBuffer<float> JumpX;
RWStructuredBuffer<float> JumpXOut;
RWStructuredBuffer<uint> JumpY;
RWStructuredBuffer<uint> JumpYOut;
RWStructuredBuffer<uint> JumpP;
RWStructuredBuffer<uint> JumpPOut;
RWStructuredBuffer<uint> SolveFlags;     // [0] something changed, [1] error bits

// Lakes and outputs.
RWStructuredBuffer<uint> LakeArea;
RWStructuredBuffer<uint> LakeDepth;
RWStructuredBuffer<uint> LakeOutlet;
RWStructuredBuffer<uint> LakeCount;
RWStructuredBuffer<uint> LakeList;
RWStructuredBuffer<float> OutHeight;
RWStructuredBuffer<float> OutFlow;
RWStructuredBuffer<float> OutWater;
RWStructuredBuffer<uint> OutAttr;

// GPU-only: dispatch, compaction, the steps' state, the histograms.
uint GroupsX;
uint NumSlots;
uint SolveDomain;
uint PassMode;
uint GateOnDone;                         // 1: a step's pass, skipped once the solve is done
uint NumScanGroups;
uint SolveMaxSteps;
uint SolveMinSteps;
float SolveTolerance;
float HistogramMax;                      // m: the histograms' range
RWStructuredBuffer<uint> GroupCounts;    // per group of 64 cells: in the domain, then its first slot
RWStructuredBuffer<uint> SolveCounts;    // [0] slots in the domain
RWStructuredBuffer<uint> SolveState;     // [0] done, [1] steps run
RWStructuredBuffer<float> Partials;      // per group of 64 slots: sum |dh|, sum U
RWStructuredBuffer<float> ResidualLog;   // per step
RWStructuredBuffer<uint> Histogram;      // 2 x VOXEL_SOLVE_BINS: solved relief, target relief

#include "/Plugin/VoxelPlugin/Private/VoxelLandSolve.ush"

#define VOXEL_SOLVE_BINS 4096u           // VoxelLandSolveDetail::HistogramBins

uint ThreadIndex(uint3 GroupId, uint GroupThread)
{
    return (GroupId.y * GroupsX + GroupId.x) * 64u + GroupThread;
}

uint GroupIndex(uint3 GroupId)
{
    return GroupId.y * GroupsX + GroupId.x;
}

bool Skipped()
{
    return GateOnDone != 0u && SolveState[0] != 0u;
}

// --- Compaction: CountCS, ScanCS, ScatterCS ------------------------------------------------

groupshared uint GroupFlags[64];

[numthreads(64, 1, 1)]
void CountCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Cell = ThreadIndex(GroupId, GroupThread);
    uint Flag = 0u;
    if (Cell < VoxelSolveNumCells())
        Flag = VoxelSolveInDomain(Cell, SolveDomain) ? 1u : 0u;
    GroupFlags[GroupThread] = Flag;
    GroupMemoryBarrierWithGroupSync();
    // The 2D grid's tail groups have no counts to write.
    if (GroupThread != 0u || GroupIndex(GroupId) >= NumScanGroups) return;
    uint Count = 0u;
    for (uint k = 0u; k < 64u; k++)
        Count += GroupFlags[k];
    GroupCounts[GroupIndex(GroupId)] = Count;
}

groupshared uint ScanSums[1024];

// One group: GroupCounts becomes each group's first slot (exclusive prefix sum), in order.
[numthreads(1024, 1, 1)]
void ScanCS(uint GroupThread : SV_GroupIndex)
{
    const uint PerThread = (NumScanGroups + 1023u) / 1024u;
    const uint First = GroupThread * PerThread;
    const uint Last = min(First + PerThread, NumScanGroups);
    uint Sum = 0u;
    for (uint g = First; g < Last; g++)
        Sum += GroupCounts[g];
    ScanSums[GroupThread] = Sum;
    GroupMemoryBarrierWithGroupSync();
    if (GroupThread == 0u)
    {
        uint Running = 0u;
        for (uint t = 0u; t < 1024u; t++)
        {
            const uint S = ScanSums[t];
            ScanSums[t] = Running;
            Running += S;
        }
        SolveCounts[0] = Running;
    }
    GroupMemoryBarrierWithGroupSync();
    uint Running = ScanSums[GroupThread];
    for (uint g = First; g < Last; g++)
    {
        const uint Count = GroupCounts[g];
        GroupCounts[g] = Running;
        Running += Count;
    }
}

[numthreads(64, 1, 1)]
void ScatterCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const uint Cell = ThreadIndex(GroupId, GroupThread);
    bool bIn = false;
    if (Cell < VoxelSolveNumCells())
        bIn = VoxelSolveInDomain(Cell, SolveDomain);
    GroupFlags[GroupThread] = bIn ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();
    if (Cell >= VoxelSolveNumCells()) return;
    if (!bIn)
    {
        SolveSlot[Cell] = VOXEL_SOLVE_NONE;
        return;
    }
    uint Rank = 0u;
    for (uint k = 0u; k < GroupThread; k++)
        Rank += GroupFlags[k];
    const uint Slot = GroupCounts[GroupIndex(GroupId)] + Rank;
    SolveSlot[Cell] = Slot;
    SlotCell[Slot] = Cell;
}

// --- Per-cell and per-slot passes ----------------------------------------------------------

[numthreads(64, 1, 1)]
void InitCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelSolveInitPass(ThreadIndex(GroupId, GroupThread));
}

// One thread: clears the change flag (SolveFlags[0]) before a counted iteration, or (PassMode
// 1) the solve's state and error bits too.
[numthreads(1, 1, 1)]
void ResetCS()
{
    SolveFlags[0] = 0u;
    if (PassMode == 1u)
    {
        SolveFlags[1] = 0u;
        SolveState[0] = 0u;
        SolveState[1] = 0u;
    }
}

[numthreads(64, 1, 1)]
void FillInPlaceCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    VoxelSolveFillInPlacePass(ThreadIndex(GroupId, GroupThread), NumSlots, PassMode == 1u ? SolveEps : 0.0f);
}

