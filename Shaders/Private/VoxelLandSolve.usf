groupshared float ReduceA[64];
groupshared float ReduceB[64];

// Per group, the sums of |dh| and of the uplift (a fixed-order tree), for the residual. Every
// thread of the group calls it (it has barriers).
void WritePartials(uint3 GroupId, uint GroupThread, bool bSkip, float Change, float Uplift)
{
    ReduceA[GroupThread] = Change;
    ReduceB[GroupThread] = Uplift;
    GroupMemoryBarrierWithGroupSync();
    for (uint Stride = 32u; Stride > 0u; Stride >>= 1u)
    {
        if (GroupThread < Stride)
        {
            ReduceA[GroupThread] += ReduceA[GroupThread + Stride];
            ReduceB[GroupThread] += ReduceB[GroupThread + Stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (GroupThread == 0u && !bSkip && GroupIndex(GroupId) < (NumSlots + 63u) / 64u)
    {
        const uint G = GroupIndex(GroupId);
        Partials[G * 2u] = ReduceA[0];
        Partials[G * 2u + 1u] = ReduceB[0];
    }
}

// The new heights, and the residual's partials (the slope cap's finish writes them again when
// the channel heads are on).
[numthreads(64, 1, 1)]
void ImplicitFinishCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    // No early return: the barriers below must be reached by every thread.
    const bool bSkip = Skipped();
    const uint Slot = ThreadIndex(GroupId, GroupThread);
    // if, not ?: (HLSL evaluates both sides of ?:, and the pass writes).
    float Change = 0.0f;
    float Uplift = 0.0f;
    if (!bSkip)
    {
        Change = VoxelSolveImplicitFinishPass(Slot, NumSlots);
        if (Slot < NumSlots)
            Uplift = SlotU[Slot];
    }
    WritePartials(GroupId, GroupThread, bSkip, Change, Uplift);
}

// T3g: the hillslopes' threshold after the implicit update.
[numthreads(64, 1, 1)]
void CapInitCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    if (Skipped()) return;
    VoxelSolveCapInitPass(ThreadIndex(GroupId, GroupThread), NumSlots);
