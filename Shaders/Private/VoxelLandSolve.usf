}

[numthreads(64, 1, 1)]
void CapFinishCS(uint3 GroupId : SV_GroupID, uint GroupThread : SV_GroupIndex)
{
    const bool bSkip = Skipped();
    const uint Slot = ThreadIndex(GroupId, GroupThread);
    float Change = 0.0f;
    float Uplift = 0.0f;
    if (!bSkip)
    {
        Change = VoxelSolveCapFinishPass(Slot, NumSlots);
        if (Slot < NumSlots)
            Uplift = SlotU[Slot];
    }
    WritePartials(GroupId, GroupThread, bSkip, Change, Uplift);
}

// One group: the step's residual (mean |dh| over the mean uplift of the step), and whether the
// solve is done (below SolveTolerance after SolveMinSteps, or SolveMaxSteps run).
[numthreads(64, 1, 1)]
void ResidualCS(uint GroupThread : SV_GroupIndex)
{
    const uint NumGroups = (NumSlots + 63u) / 64u;
    float A = 0.0f;
    float B = 0.0f;
    for (uint g = GroupThread; g < NumGroups; g += 64u)
    {
        A += Partials[g * 2u];
        B += Partials[g * 2u + 1u];
    }
    ReduceA[GroupThread] = A;
    ReduceB[GroupThread] = B;
    GroupMemoryBarrierWithGroupSync();
    for (uint Stride = 32u; Stride > 0u; Stride >>= 1u)
    {
        if (GroupThread < Stride)
        {
            ReduceA[GroupThread] += ReduceA[GroupThread + Stride];
            ReduceB[GroupThread] += ReduceB[GroupThread + Stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (GroupThread != 0u || SolveState[0] != 0u) return;
    const uint Steps = SolveState[1] + 1u;
    const float Residual = ReduceA[0] / max(ReduceB[0] * SolveDt, 1.0e-30f);
    if (Steps <= SolveMaxSteps)
        ResidualLog[Steps - 1u] = Residual;
    SolveState[1] = Steps;
    SolveState[0] = ((Steps >= SolveMinSteps && Residual < SolveTolerance) || Steps >= SolveMaxSteps) ? 1u : 0u;
}

