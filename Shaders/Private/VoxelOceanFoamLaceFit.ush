// structure's thresholds (VoxelOceanFoamLace.ush), the inverse of each pattern's distribution
// (2,000,000 samples) at D = sin^2(pi k / 128) (closer toward both ends), interpolated. Write it again when the patterns change.

// The streaks' pattern (VoxelOceanLaceStreak).
VOXEL_FUNC float VoxelOceanLaceThreshold0(float D)
{
    const float K[65] = {
        -1.463187f, -1.261469f, -1.168002f, -1.094656f, -1.032663f, -0.977626f,
        -0.928145f, -0.881413f, -0.837293f, -0.794498f, -0.753515f, -0.713545f,
        -0.675533f, -0.637644f, -0.600890f, -0.564517f, -0.528972f, -0.493885f,
        -0.458985f, -0.424849f, -0.390631f, -0.357016f, -0.323400f, -0.290146f,
        -0.257120f, -0.224024f, -0.191046f, -0.158554f, -0.126110f, -0.093652f,
        -0.061488f, -0.029196f, 0.003153f, 0.035413f, 0.067858f, 0.100087f,
        0.132581f, 0.164894f, 0.197351f, 0.230173f, 0.263028f, 0.296162f,
        0.329299f, 0.362844f, 0.396671f, 0.430714f, 0.464956f, 0.499793f,
        0.534913f, 0.570623f, 0.606952f, 0.643863f, 0.681984f, 0.720397f,
        0.760138f, 0.801517f, 0.843962f, 0.888142f, 0.935383f, 0.985970f,
        1.040157f, 1.101236f, 1.175036f, 1.266260f, 1.446771f };
    // (The knots at D = sin^2(pi k / 128): closer toward both ends.)
    const float S = sqrt(saturate(D));
    const float X = atan2(S, sqrt(max(1.0f - S * S, 0.0f))) * (128.0f / 3.14159265f);
    const int I = min(int(X), 63);
    return lerp(K[I], K[I + 1], X - float(I));
}

