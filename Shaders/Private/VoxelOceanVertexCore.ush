// VoxelOceanVertexCore.ush - A drawn ocean vertex: the morph between tile levels and the waves'
// displacement (Design/OceanMeshing.md; Design/OceanWaves.md section 25). Shared by the ocean
// material's vertex node (VoxelOcean.ush, VoxelOceanVertexFFT) and the pages' per-frame
// displacement pass (stage O9j, VoxelOceanDisplace.usf), so the two can't drift apart.
//
// A vertex's static data are what its tile write leaves (VoxelOceanPage.usf): its position, its
// morph offsets to its target and its target's target (page axes and units: Parent, Grand, here
// already in world axes and cm), the depths the waves feel at it and at its targets, its coast
// codes and its bed's codes and land depth (texture coordinates 0 to 5). ToVertex: the vertex
// from the selection camera (world cm).

#pragma once

#include "/Plugin/VoxelPlugin/Private/VoxelOceanWaves.ush"

// The split bias near shores (stage O9c): VoxelOceanTiles::CoastCapCm and CoastScaleCm.
#define VOXEL_OCEAN_COAST_CAP 1.0e6f
#define VOXEL_OCEAN_COAST_SCALE 2000.0f

// The bias's settings (Detail, the band and the reach in cm; the chart table's row 17), Detail 1:
// none (no FFT model).
float3 VoxelOceanShoreDetailOf(float4 FFT, Texture2D OceanCharts)
{
    if (FFT.x < 0.5f || FFT.y < 0.5f) return float3(1.0f, 0.0f, 0.0f);
    return OceanCharts.Load(int3(VoxelOceanConstantsX(int(FFT.y)), 17, 0)).xyz;
}

// A vertex's coast distances (cm), its own and its morph target's, from their codes (TexCoord 2
// y: VoxelOceanTiles::CoastPack, an integer exact in a float; CoastValue).
float2 VoxelOceanCoastOf(float Packed)
{
    const float Self = floor(Packed * (1.0f / 4096.0f));
    const float Target = Packed - Self * 4096.0f;
    const float K = log2(1.0f + VOXEL_OCEAN_COAST_CAP / VOXEL_OCEAN_COAST_SCALE) / 4095.0f;
    return VOXEL_OCEAN_COAST_SCALE * (exp2(float2(Self, Target) * K) - 1.0f);
}

// The distance the morph weights take for a point D (cm) from the selection camera, Coast (cm)
// from the coast (VoxelOceanTiles::EffectiveDistance, in float).
float VoxelOceanShoreDetailDistance(float D, float Coast, float3 Bias)
{
    if (Bias.x <= 1.0f) return D;
    const float Outside = max(Coast - Bias.y, 0.0f);
    return min(D, D / Bias.x + (1.0f - 1.0f / Bias.x) * max(Outside, D - Bias.z));
}

// Morph weight of a level-L vertex D (world units) from the selection camera.
float VoxelOceanMorphWeight(float D, float Level, float MorphEnd0, float2 Params)
{
    if (Params.x < 0.5f || MorphEnd0 <= 0.0f || Level < 0.5f) return 0.0f;
    if (Params.x > 1.5f) return 1.0f;
    const float End = MorphEnd0 * exp2(-Level);
    const float Start = End * Params.y;
    const float X = saturate((D - Start) / max(End - Start, 1.0e-6f));
    return X * X * (3.0f - 2.0f * X);
}

// The bed (stage O9b2): the slope of a vertex's packed codes (VoxelOceanBedPack: its own, its
// target's, the target's target's) morphed as the depth is, an unknown code standing for Field
// (the field's slope at the morphed point, as the surf takes it): always a real slope, so the
// morph stays continuous and the pixel's interpolation harmless.
float VoxelOceanBedOf(uint Code, float Field)
{
    const float S = VoxelOceanBedSlopeOf(Code);
    return S > VOXEL_OCEAN_SURF_BED_KNOWN ? S : Field;
}

float VoxelOceanBedMorph(float Packed, float W0, float W1, float Field)
{
    const float S0 = VoxelOceanBedOf(VoxelOceanBedCodeAt(Packed, 0), Field);
    if (W0 <= 0.0f) return S0;
    const float S1 = VoxelOceanBedOf(VoxelOceanBedCodeAt(Packed, 1), Field);
    const float S2 = VoxelOceanBedOf(VoxelOceanBedCodeAt(Packed, 2), Field);
    return lerp(S0, lerp(S1, S2, W1), W0);
}

// What a vertex draws: its offset from where it sits (world cm: the morph and the waves), the
// undisplaced morphed point from the selection camera (for the pixel), the depth the waves feel
// there (morphed, cm) and the bed (its slope morphed, the terrain's own depth).
struct FVoxelOceanVertexOut
{
    float3 Offset;
    float3 SamplePoint;
    float Depth;
    float2 Bed;
};

// The morph alone: the offset to where the vertex draws (world cm), the morphed point and depth,
// the weights and the spacing the waves see there (s_L 2^(W0 (1 + W1))).
struct FVoxelOceanVertexMorph
{
    float3 Offset;
    float3 SamplePoint;
    float Depth;
    float W0;
    float W1;
    float Spacing;
};

FVoxelOceanVertexMorph VoxelOceanVertexMorphOf(float3 ToVertex, float3 Parent, float3 Grand, float2 UV1, float2 UV2, float2 UV4,
    float Level, float MorphEnd0, float4 Params, float4 FFT, Texture2D Charts)
{
    FVoxelOceanVertexMorph M;
    M.Offset = float3(0.0f, 0.0f, 0.0f);
    M.Depth = UV1.y;
    const float3 Bias = VoxelOceanShoreDetailOf(FFT, Charts);
    const float2 Coast = VoxelOceanCoastOf(UV2.y);
    M.W0 = VoxelOceanMorphWeight(VoxelOceanShoreDetailDistance(length(ToVertex), Coast.x, Bias), Level, MorphEnd0, Params.xy);
    M.W1 = 0.0f;
    if (M.W0 > 0.0f)
    {
        M.W1 = VoxelOceanMorphWeight(VoxelOceanShoreDetailDistance(length(ToVertex + Parent), Coast.y, Bias), Level - 1.0f, MorphEnd0, Params.xy);
        M.Depth = lerp(UV1.y, lerp(UV2.x, UV4.y, M.W1), M.W0);
        M.Offset = (Parent + Grand * M.W1) * M.W0;
    }
    M.SamplePoint = ToVertex + M.Offset;
    M.Spacing = MorphEnd0 * exp2(M.W0 * (1.0f + M.W1) - Level) * Params.w;
    return M;
}

// The vertex with the FFT model (or the test model with FFT.x 0) and the shore field: UV1, UV2,
// UV4, UV5 its texture coordinates 1, 2, 4 and 5 (the depths, the coast codes, the bed), Parent
// and Grand its morph offsets in world axes (cm); Level and MorphEnd0 its page's (custom
// primitive data 0 and 1); Params (x the morph mode 0 off, 1 by distance, 2 fully morphed).
FVoxelOceanVertexOut VoxelOceanVertexCore(float3 ToVertex, float3 Parent, float3 Grand, float2 UV1, float2 UV2, float2 UV4, float2 UV5,
    float Level, float MorphEnd0, float4 Params, FVoxelOceanWaveParams Waves, Texture2DArray Displacement, SamplerState DisplacementSampler,
    Texture2DArray Derivatives, SamplerState DerivativesSampler, Texture2D Charts VOXEL_OCEAN_FINE_PARAMS, Texture2DArray Shore)
{
    const FVoxelOceanVertexMorph M = VoxelOceanVertexMorphOf(ToVertex, Parent, Grand, UV1, UV2, UV4, Level, MorphEnd0, Params, Waves.FFT, Charts);
    FVoxelOceanVertexOut Out;
    Out.Offset = M.Offset;
    Out.Depth = M.Depth;
    Out.SamplePoint = M.SamplePoint;
    Out.Bed = float2(VOXEL_OCEAN_SHORE_DEFAULT_SLOPE, UV5.y);
    const int N = int(Waves.FFT.y);
    if ((Params.z > 0.0f || Waves.FFT.x > 0.5f) && MorphEnd0 > 0.0f)
    {
        const FVoxelOceanShoreFrame Frame = VoxelOceanShoreFrameOfTable(Charts, N);
        const FVoxelOceanCoastLayout CoastLayout = VoxelOceanCoastLayoutOfTable(Charts, N);
        FVoxelOceanWaveInput In = VoxelOceanWaveInputShore(Out.SamplePoint, M.Spacing, M.Spacing, Out.Depth, Waves, Frame, CoastLayout, Shore);
        Out.Bed.x = VoxelOceanBedMorph(UV5.x, M.W0, M.W1, max(In.Shore.Slope, max(Waves.SlopeVar.y, 1.0e-4f)));
        In.Shore.BedSlope = Out.Bed.x;
        In.Shore.BedDepth = Out.Bed.y;
        Out.Offset += VoxelOceanWavesFFT(In, Waves, Displacement, DisplacementSampler, Derivatives, DerivativesSampler, Charts VOXEL_OCEAN_FINE_ARGS,
            VOXEL_OCEAN_LOOKUP_DISPLACEMENT).Displacement;
    }
    return Out;
}
