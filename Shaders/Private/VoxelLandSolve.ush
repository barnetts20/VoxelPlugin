// VoxelLandSolve.ush - The land bake's erosion solve and final routing (Design/LandGen.md
// section 5): the per-cell work of every pass, one function per pass taking the thread's cell
// or slot. VoxelLandSolve.usf declares the inputs and the entry points (with the GPU-only
// compaction and reductions); the C++ harness runs the same functions in sequence.
//
// Shared subset (VoxelShaderCompat.h): the C++ side includes this inside a struct whose members
// carry the buffer names below, so it declares no static data (constants are #defines).
//
// Grid: the bake's padded cells (6 faces of Side^2, Side = SolveN + 2 SolvePad, cell (i, j)
// of face f at f Side^2 + (j + Pad) Side + i + Pad). The solve and the routing run on the
// interior cells; the aprons are filled from the neighbouring faces at the end. A cell's 8
// neighbours are its face's, or across a face edge the cell under the extended face
// coordinate's direction (equal-angle grids line up along an edge); the diagonal beyond a cube
// corner is left out.
//
// Domains: the cells a phase solves are compacted into slots in cell order (the solve: the
// mountain cells; the routing: the land cells). Per-slot buffers are indexed by slot, per-cell
// buffers by cell; SolveSlot maps a cell to its slot (VOXEL_SOLVE_NONE outside the domain).
// Cells outside the domain are fixed: their level SolveW is the base level flow ends at.
//
// Every pass is order-independent (double-buffered, or iterated to its unique fixed point), so
// a bake is reproduced bit for bit on the same GPU.
//
// Inputs (declared by the includer):
//   uint SolveN, SolvePad;  float SolveRadiusM;
//   StructuredBuffer<float2> SolveTan;          tan of the cell centres' angles (Side entries,
//                                               from -Pad), the bake's TanTable
//   StructuredBuffer<float> BakeHeight;         the plate model's height (m), per cell
//   StructuredBuffer<float> BakeUp;             its boundary uplift (m)
//   StructuredBuffer<float> BakeCrust;          its continental fraction
//   float SolvePlainsUplift, SolveRampWidth;    the range-front ramp (m)
//   float SolveUpliftTime;                      years for the full uplift
//   float SolveKdt, SolveDt, SolveEps;          erodibility x time step, the step (years), the
//                                               fill's descent per cell (m)
//   uint SolveSeed;
//   RWStructuredBuffer<float> SolveH, SolveW, SolveWater;   per cell: height, water level
//                                               (the fill), the lake level (routing)
//   RWStructuredBuffer<uint> SolveRec, SolveSlot, SolveLabel; per cell: receiver, slot, lake
//   RWStructuredBuffer<uint> SlotCell;          per slot: its cell
//   RWStructuredBuffer<float> SlotU, SlotArea, SlotDist, SlotH0, SlotA, SlotAOut, SlotWOut;
//   RWStructuredBuffer<float> JumpX, JumpXOut;  pointer-jumping records (value, factor or
//   RWStructuredBuffer<uint> JumpY, JumpYOut, JumpP, JumpPOut;   count, next slot)
//   RWStructuredBuffer<uint> SolveFlags;        [0] something changed, [1] error bits
//   float SolveFactor, SolveReliefKnee, SolveReliefTop;   the relief normalisation: scale, and
//                                               where the scaled relief starts to ease toward
//                                               the top (m)
//   float SolveMinLakeDepth, SolveMinLakeArea;  m, m^2
//   float SolveJitter;                          the routing graph's node offsets (cells, 0..0.45;
//                                               Design/SurfaceLook.md T1): breaks D8's 8 directions
//   float SolveSpreadCells;                     the drainage field's hillslopes (cells; T1b, see
//                                               VoxelSolveSpreadPass)
//   float SolveRouteNoise;                      the receivers' choice: each neighbour's slope
//                                               times 2^(this x u), u a fixed hash in -1..1 per
//                                               cell and neighbour (T1b; 0 steepest descent)
//   float SolveUpliftVariation;                 uplift x max(0, 1 + this x n1): massifs, saddles
//   float SolveErodibilityVariation;            erodibility x exp(this x n2): hard and soft rock
//   float SolveVariationWavelength;             the coarsest wavelength of n1 and n2 (m)
//   float SolveRoughness;                       the initial surface's noise (m, coarsest octave)
//   uint SolveModel;                            0 (L2): relief above the outlet; 1 (T1): the static
//                                               surface stays, the solve adds the eroded uplifted
//                                               mass on it, rivers cut at most SolveIncision below
//   float SolveUndulation;                      model 1: the static surface's rolling ground on
//                                               land (m, coarsest octave; T1b)
//   StructuredBuffer<uint> BakeForm;            the landform (VoxelLandPlates.ush) | the province << 16, one cell a word
//   float SolveLandformErosion;                 T2: how much the hilliness H scales the plains
//                                               relief and the rolling ground (x lerp(1,
//                                               0.3 + 1.75 H, e))
//   float SolvePlainsRelief;                    model 1: the plains' uplift as relief (m): they
//                                               join the solve, so they get drained valleys
//   float SolveIncision;                        model 1: how far rivers may cut below the static
//                                               surface (m; never below the sea)
//   uint SolveFillDepressions;                  1: the solve fills depressions with sediment each step
//   float SolveReliefScale;                     the relief map above the knee: 0 the L2 easing toward
//                                               SolveReliefTop, else K + s ln(1 + (R - K) / s) with
//                                               this s (m), fitted so the 99.9th percentile lands on
//                                               the top (large: nearly linear)
//   RWStructuredBuffer<float> SlotK;            per slot: the erodibility factor
//   float SolveChannelCells;                    T3g: the channel heads' drainage area (cells of
//                                               the cell's own area); 0 off (every cell incises
//                                               fully, no slope cap: the T3f solve)
//   float SolveChannelVariation;                the heads' area varies by 2^(this x n3), n3 a
//                                               smooth noise spread over -1..1: drainage density
//   float SolveChannelWavelength;               n3's coarsest wavelength (m)
//   uint SolveChannelOctaves;                   n3's octaves
//   float SolveHillslope;                       the slope cap above the receiver, as a multiple of
//                                               the steady channel slope at the cell's head area
//   RWStructuredBuffer<float> SlotAc;           per slot: the channel heads' area factor,
//                                               2^(SolveChannelVariation x n3) (1 when off)
//   float SolveChannelCharacter;                T3h: the character's pull (the output pass)
//   RWStructuredBuffer<uint> AccHi, AccHiOut;   S1: the exact accumulation's high words (per slot,
//                                               double-buffered with JumpY's low words)
//   float SolveAccUnit;                         S1: its unit (m^2; a 4096th of a cell)

#ifndef VOXEL_LAND_SOLVE_USH
#define VOXEL_LAND_SOLVE_USH

#define VOXEL_SOLVE_NONE 0xffffffffu
#define VOXEL_SOLVE_INF 3.0e38f
#define VOXEL_SOLVE_INV_QUARTER_PI 1.27323954473516269f
#define VOXEL_SOLVE_HALF_PI 1.57079632679489662f
// SolveFlags[1] error bits.
#define VOXEL_SOLVE_ERROR_NO_RECEIVER 1u    // a domain cell without a lower neighbour
#define VOXEL_SOLVE_ERROR_JUMP 2u           // a path longer than the pointer jumping reaches
#define VOXEL_SOLVE_ERROR_UNDRAINED 4u      // the initial fill left a cell without an outlet
// A depression must be this much below its lake level (m).
#define VOXEL_SOLVE_LAKE_MIN 0.001f
// Attr bit of a cell under a kept lake (FVoxelLandBake::Attr).
#define VOXEL_SOLVE_LAKE_BIT 0x1000u

// --- Grid --------------------------------------------------------------------------------

struct FVoxelSolveCell
{
    uint Face;
    int I;
    int J;
};

VOXEL_FUNC uint VoxelSolveSide()
{
    return SolveN + 2u * SolvePad;
}

VOXEL_FUNC uint VoxelSolveNumCells()
{
    const uint Side = VoxelSolveSide();
    return 6u * Side * Side;
}

VOXEL_FUNC FVoxelSolveCell VoxelSolveDecode(uint Cell)
{
    const uint Side = VoxelSolveSide();
    FVoxelSolveCell C;
    C.Face = Cell / (Side * Side);
    const uint Rest = Cell - C.Face * Side * Side;
    C.J = int(Rest / Side) - int(SolvePad);
    C.I = int(Rest - (Rest / Side) * Side) - int(SolvePad);
    return C;
}

VOXEL_FUNC uint VoxelSolveEncode(uint Face, int I, int J)
{
    const uint Side = VoxelSolveSide();
    return Face * Side * Side + uint(J + int(SolvePad)) * Side + uint(I + int(SolvePad));
}

VOXEL_FUNC bool VoxelSolveIsInterior(FVoxelSolveCell C)
{
    return C.I >= 0 && C.J >= 0 && C.I < int(SolveN) && C.J < int(SolveN);
}

/** Unit direction of cell (I, J) of a face (I and J may lie in the apron), from the tan table. */
VOXEL_FUNC float3 VoxelSolveDirection(uint Face, int I, int J)
{
    const float A = SolveTan[uint(I + int(SolvePad))].x;
    const float B = SolveTan[uint(J + int(SolvePad))].x;
    const float3 N = VoxelCubeAxisVector(VoxelCubeNormalAxis(Face)) * VoxelCubeNormalSign(Face);
    return normalize(N + VoxelCubeAxisVector(VoxelCubeUAxis(Face)) * A + VoxelCubeAxisVector(VoxelCubeVAxis(Face)) * B);
}

VOXEL_FUNC float3 VoxelSolveCellDirection(uint Cell)
{
    const FVoxelSolveCell C = VoxelSolveDecode(Cell);
    return VoxelSolveDirection(C.Face, C.I, C.J);
}

/** A direction's face and continuous cell coordinates (cell centres at whole numbers). */
struct FVoxelSolveLocation
{
    uint Face;
    float X;
    float Y;
};

VOXEL_FUNC FVoxelSolveLocation VoxelSolveLocate(float3 Dir)
{
    const float AX = abs(Dir.x);
    const float AY = abs(Dir.y);
    const float AZ = abs(Dir.z);
    const uint Axis = (AX >= AY && AX >= AZ) ? 0u : (AY >= AZ ? 1u : 2u);
    const float PN = VoxelCubeComponent(Dir, Axis);
    FVoxelSolveLocation L;
    L.Face = Axis * 2u + (PN < 0.0f ? 1u : 0u);
    const float Den = max(abs(PN), 1.0e-20f);
    const float S = atan(VoxelCubeComponent(Dir, VoxelCubeUAxis(L.Face)) / Den) * VOXEL_SOLVE_INV_QUARTER_PI;
    const float T = atan(VoxelCubeComponent(Dir, VoxelCubeVAxis(L.Face)) / Den) * VOXEL_SOLVE_INV_QUARTER_PI;
    L.X = (S + 1.0f) * 0.5f * float(SolveN) - 0.5f;
    L.Y = (T + 1.0f) * 0.5f * float(SolveN) - 0.5f;
    return L;
}

/** The interior cell holding a direction. */
VOXEL_FUNC uint VoxelSolveCellOf(float3 Dir)
{
    const FVoxelSolveLocation L = VoxelSolveLocate(Dir);
    const int I = clamp(int(floor(L.X + 0.5f)), 0, int(SolveN) - 1);
    const int J = clamp(int(floor(L.Y + 0.5f)), 0, int(SolveN) - 1);
    return VoxelSolveEncode(L.Face, I, J);
}

/** Neighbour C (0..7: di, dj over -1..1 with dj outer, (0, 0) left out) of an interior cell,
 *  or VOXEL_SOLVE_NONE (off a cube corner). Across a face's edge, the cell of the face beyond
 *  that holds the point on the edge level with the step's cell along it: the coordinate along a
 *  shared edge is the same angle on both faces, so the neighbours across are the edge row of the
 *  other face, in step with this one's, and the links are symmetric. (S1: the cell holding the
 *  apron cell's centre, as before, lands near half-cell ties toward the corners: 96 one-way links
 *  at 1,024 cells a face, and a gathering pass, such as the drainage's, lost what came over one.) */
VOXEL_FUNC uint VoxelSolveNeighbour(uint Cell, uint C)
{
    const uint K = C < 4u ? C : C + 1u;
    const int DI = int(K - (K / 3u) * 3u) - 1;
    const int DJ = int(K / 3u) - 1;
    const FVoxelSolveCell P = VoxelSolveDecode(Cell);
    const int I = P.I + DI;
    const int J = P.J + DJ;
    const bool bOutI = I < 0 || I >= int(SolveN);
    const bool bOutJ = J < 0 || J >= int(SolveN);
    if (!bOutI && !bOutJ) return VoxelSolveEncode(P.Face, I, J);
    if (bOutI && bOutJ) return VOXEL_SOLVE_NONE;
    // The face beyond: the apron cell's centre lies half a cell past the edge.
    const uint Face = VoxelSolveLocate(VoxelSolveDirection(P.Face, I, J)).Face;
    // The point on the edge (the edge's tan is 1), in this face's frame; the other face's
    // coordinates of it are ratios of its components (no need to normalise).
    const float A = bOutI ? (I < 0 ? -1.0f : 1.0f) : SolveTan[uint(I + int(SolvePad))].x;
    const float B = bOutJ ? (J < 0 ? -1.0f : 1.0f) : SolveTan[uint(J + int(SolvePad))].x;
    const float3 Dir = VoxelCubeAxisVector(VoxelCubeNormalAxis(P.Face)) * VoxelCubeNormalSign(P.Face)
        + VoxelCubeAxisVector(VoxelCubeUAxis(P.Face)) * A + VoxelCubeAxisVector(VoxelCubeVAxis(P.Face)) * B;
    const float Den = abs(VoxelCubeComponent(Dir, VoxelCubeNormalAxis(Face)));
    const float S = atan(VoxelCubeComponent(Dir, VoxelCubeUAxis(Face)) / Den) * VOXEL_SOLVE_INV_QUARTER_PI;
    const float T = atan(VoxelCubeComponent(Dir, VoxelCubeVAxis(Face)) / Den) * VOXEL_SOLVE_INV_QUARTER_PI;
    // Across the edge the coordinate is the edge's (-0.5 or N - 0.5: the edge row once clamped),
    // along it a cell centre's (a whole number to float error).
    const int I2 = clamp(int(floor((S + 1.0f) * 0.5f * float(SolveN))), 0, int(SolveN) - 1);
    const int J2 = clamp(int(floor((T + 1.0f) * 0.5f * float(SolveN))), 0, int(SolveN) - 1);
    return VoxelSolveEncode(Face, I2, J2);
}

/** Distance between two cells' centres on the sphere (m): the chord, exact to 1e-7 between
 *  neighbours. */
VOXEL_FUNC float VoxelSolveDistance(float3 A, float3 B)
{
    return length(A - B) * SolveRadiusM;
}

/** A cell's area on the sphere (m^2). */
VOXEL_FUNC float VoxelSolveCellArea(uint Cell)
{
    const FVoxelSolveCell C = VoxelSolveDecode(Cell);
    const float A = SolveTan[uint(C.I + int(SolvePad))].x;
    const float B = SolveTan[uint(C.J + int(SolvePad))].x;
    const float Q = 1.0f + A * A + B * B;
    const float Step = VOXEL_SOLVE_HALF_PI / float(SolveN) * SolveRadiusM;
    return Step * Step * (1.0f + A * A) * (1.0f + B * B) / (Q * sqrt(Q));
}

/** -1..1, a hash of a cell and the seed. */
VOXEL_FUNC uint VoxelSolveHash(uint X)
{
    uint H = X;
    H = H ^ (H >> 16u);
    H = H * 0x7feb352du;
    H = H ^ (H >> 15u);
    H = H * 0x846ca68bu;
    H = H ^ (H >> 16u);
    return H;
}

VOXEL_FUNC float VoxelSolveNoise(uint Cell)
{
    return float(VoxelSolveHash(Cell ^ VoxelSolveHash(SolveSeed + 0x51ed27u)) >> 8u) * (2.0f / 16777216.0f) - 1.0f;
}

/** A cell's node in the routing graph: its centre moved by up to SolveJitter cells along each
 *  face axis (a hash of the cell and the seed), on the sphere. The fields stay at the centres;
 *  only the distances the receivers and slopes see move, so a plane no longer drains along one
 *  of 8 directions (the regular-grid form of an irregular sampling, Cordonnier et al. 2016). */
VOXEL_FUNC float3 VoxelSolveNodeDirection(uint Cell)
{
    if (!(SolveJitter > 0.0f)) return VoxelSolveCellDirection(Cell);
    const FVoxelSolveCell C = VoxelSolveDecode(Cell);
    const uint H = VoxelSolveHash(Cell ^ VoxelSolveHash(SolveSeed + 0x2c1b3c6du));
    const float DU = (float(H & 0xffffu) * (1.0f / 65535.0f) - 0.5f) * 2.0f * SolveJitter;
    const float DV = (float(H >> 16u) * (1.0f / 65535.0f) - 0.5f) * 2.0f * SolveJitter;
    const float Step = 2.0f / float(SolveN);
    const float A = tan((-1.0f + (float(C.I) + 0.5f + DU) * Step) * (0.5f * VOXEL_SOLVE_HALF_PI));
    const float B = tan((-1.0f + (float(C.J) + 0.5f + DV) * Step) * (0.5f * VOXEL_SOLVE_HALF_PI));
    const float3 N = VoxelCubeAxisVector(VoxelCubeNormalAxis(C.Face)) * VoxelCubeNormalSign(C.Face);
    return normalize(N + VoxelCubeAxisVector(VoxelCubeUAxis(C.Face)) * A + VoxelCubeAxisVector(VoxelCubeVAxis(C.Face)) * B);
}

/** A cell's weight for its neighbour c in the receivers' choice: 2^(SolveRouteNoise x u), u a
 *  fixed hash of the cell, c and the seed in -1..1. Steepest descent sends every cell of a
 *  planar flank the same way, so its channels run parallel and never meet; a random choice
 *  among the downhill neighbours makes them random walks down the slope that merge, as in
 *  Rho8 (Fairfield and Leymarie 1991) and Scheidegger's networks, and the erosion then deepens
 *  the merged channels into valleys (Design/SurfaceLook.md, T1b). Fixed per cell, so the
 *  routing settles. */
VOXEL_FUNC float VoxelSolveRouteWeight(uint Cell, uint c)
{
    if (!(SolveRouteNoise > 0.0f)) return 1.0f;
    const uint H = VoxelSolveHash((Cell * 8u + c) ^ VoxelSolveHash(SolveSeed + 0x6a09e667u));
    return exp2(SolveRouteNoise * (float(H >> 8u) * (2.0f / 16777216.0f) - 1.0f));
}

/** A smooth noise on the sphere (about -1..1): Octaves of gradient noise from WavelengthM,
 *  halving, at the unit direction Dir; Salt picks the field. */
VOXEL_FUNC float VoxelSolveFbm(float3 Dir, float WavelengthM, uint Octaves, uint Salt)
{
    float Sum = 0.0f;
    float Amp = 1.0f;
    float Norm = 0.0f;
    float Scale = SolveRadiusM / max(WavelengthM, 1.0f);
    for (uint o = 0u; o < Octaves; o++)
    {
        const float3 P = Dir * Scale + float3(17.31f, 5.77f, 11.13f) * float(o + 1u);
        const float3 Fl = float3(floor(P.x), floor(P.y), floor(P.z));
        const FVoxelNoiseSample N = VoxelGradientNoise(uint3(asuint(int(Fl.x)), asuint(int(Fl.y)), asuint(int(Fl.z))), P - Fl,
            VoxelSolveHash(SolveSeed * 0x9e3779b9u + Salt * 0x85ebca6bu + o));
        Sum += Amp * N.Value;
        Norm += Amp;
        Amp *= 0.5f;
        Scale *= 2.0f;
    }
    // Gradient noise spans about +-0.7: to about -1..1.
    return Sum / max(Norm, 1.0e-6f) * 1.4f;
}

/** The erodibility factor of a cell (hard rock below 1, soft above). */
VOXEL_FUNC float VoxelSolveErodibility(float3 Dir)
{
    if (!(SolveErodibilityVariation > 0.0f)) return 1.0f;
    return exp(SolveErodibilityVariation * VoxelSolveFbm(Dir, 0.5f * SolveVariationWavelength, 3u, 2u));
}

// --- Channel heads and the hillslopes (T3g) --------------------------------------------------
//
// Drainage density. Without a threshold every cell incises (F grows with sqrt(A) from a cell's
// own area up), so channels are as dense as the grid allows everywhere. Here a cell incises
// only once it drains more than the channel heads' area A_c(x), ramped in from A_c / 2, and
// A_c varies over the planet by 2^(+-V) (a fixed noise): sparse, widely spaced valleys in one
// region, dense dissection in the next. The cells below the heads are hillslopes. Stream power
// no longer lowers them, so they would rise with the uplift without end; a threshold slope caps
// them instead: no cell stands more than C above its receiver (VoxelSolveCapRise), so a
// hillslope is a plane at the threshold between its divide and the channel head below.

/** Whether the channel heads (and the slope cap) are on. */
VOXEL_FUNC bool VoxelSolveChannelHeads()
{
    return SolveChannelCells > 0.0f;
}

/** The channel heads' noise is spread over most of -1..1 by this gain and a smooth saturation,
 *  x / sqrt(1 + x^2): VoxelSolveFbm's own values mostly lie within +-0.3 (p5 to p95), which
 *  would leave 2^(V n) a fraction of the range V asks for. With 4, p5 to p95 is about +-0.75. */
#define VOXEL_SOLVE_CHANNEL_CONTRAST 4.0f

/** The channel heads' noise n3 at a direction, in -1..1 (0 when the heads or their variation
 *  are off): above 0 the heads are sparse, below dense. */
VOXEL_FUNC float VoxelSolveChannelNoise(float3 Dir)
{
    if (!VoxelSolveChannelHeads() || !(SolveChannelVariation > 0.0f)) return 0.0f;
    const float X = VOXEL_SOLVE_CHANNEL_CONTRAST * VoxelSolveFbm(Dir, SolveChannelWavelength, max(SolveChannelOctaves, 1u), 6u);
    return X / sqrt(1.0f + X * X);
}

/** A cell's channel-head area factor, 2^(V n3) (1 when off). */
VOXEL_FUNC float VoxelSolveChannelFactor(float3 Dir)
{
    if (!VoxelSolveChannelHeads() || !(SolveChannelVariation > 0.0f)) return 1.0f;
    return exp2(SolveChannelVariation * VoxelSolveChannelNoise(Dir));
}

/** T3h: the bake's landform with the character following the drainage density. The character
 *  (high byte: 0 smooth, rolling .. 1 rough-topped) picks the peaks' soft (G) or hard (R)
 *  channel and the hills' shape on the sample side, so the regional detail agrees with the
 *  bake: where the heads are sparse (broad, smooth slopes) it leans smooth, where they are
 *  dense (finely cut) rough, by SolveChannelCharacter x |n3| toward 0 or 1. The hilliness
 *  (low byte) is the plate model's. Unchanged when the heads, their variation or the
 *  influence are off. */
VOXEL_FUNC uint VoxelSolveFormOf(uint Cell)
{
    const uint Form = BakeForm[Cell];
    if (!(SolveChannelCharacter > 0.0f)) return Form;
    const float N = VoxelSolveChannelNoise(VoxelSolveCellDirection(Cell));
    if (N == 0.0f) return Form;
    const float C = float((Form >> 8u) & 0xffu) * (1.0f / 255.0f);
    const float Pulled = lerp(C, N > 0.0f ? 0.0f : 1.0f, saturate(SolveChannelCharacter) * abs(N));
    // The low byte (the hilliness) and the high half (the province, T4c) kept.
    return (Form & 0xffff00ffu) | (uint(saturate(Pulled) * 255.0f + 0.5f) << 8u);
}

/** The incision's ramp: 0 below half the cell's channel-head area, a smoothstep to 1 at it. */
VOXEL_FUNC float VoxelSolveChannelRamp(uint Slot)
{
    if (!VoxelSolveChannelHeads()) return 1.0f;
    const float Ac = SolveChannelCells * SlotArea[Slot] * SlotAc[Slot];
    const float T = clamp((SlotA[Slot] - 0.5f * Ac) / (0.5f * Ac), 0.0f, 1.0f);
    return T * T * (3.0f - 2.0f * T);
}

/** The most a cell may stand above its receiver (m): SolveHillslope times the steady channel
 *  drop at the cell's own head area, U dt / F(A_c(x)) with F(A) = K dt K sqrt(A) / d: a
 *  hillslope meets its channel head without a break in slope. Proportional to the uplift and
 *  inverse to the erodibility, as the channels' own steady slopes are, so the normalisation's
 *  assumption (relief following the uplift) holds and slow-rising plains get gentle
 *  hillslopes. Where the heads are sparse the hillslopes are longer and gentler (about the same
 *  relief between ridge and channel head), so the land reads smooth and broad; where they are
 *  dense, short, steep and finely cut. (A cap at the base head area everywhere gave sparse
 *  regions taller ridges instead, and the density hardly showed.) At least the random fill's
 *  largest descent into a cell (Eps 2^2 sqrt 2), so where the uplift is about 0 the fill and
 *  the cap don't undo each other every step. */
VOXEL_FUNC float VoxelSolveCapRise(uint Slot)
{
    const float Fc = SolveKdt * SlotK[Slot] * sqrt(SolveChannelCells * SlotArea[Slot] * SlotAc[Slot]) / max(SlotDist[Slot], 1.0f);
    return max(SolveHillslope * SlotU[Slot] * SolveDt / max(Fc, 1.0e-20f), 6.0f * SolveEps);
}

// --- The solve's inputs --------------------------------------------------------------------

/** The plate height (m) over which land on oceanic crust joins the solve. */
#define VOXEL_SOLVE_LAND_RAMP 300.0f

/** What the plate model gives a cell: its static height (the base and the profile without the
 *  solved uplift), how much of its uplift the solve raises (the range-front ramp times the
 *  continental fraction, or the land ramp on oceanic crust), the uplift rate, and whether it
 *  is solved. */
struct FVoxelSolveSetup
{
    float Static;
    float Mix;
    float Uplift;      // m / year
    float Target;      // the profile's solved uplift (m): the relief the normalisation matches
    bool bMoving;
};

VOXEL_FUNC FVoxelSolveSetup VoxelSolveSetupOf(uint Cell)
{
    const float H = BakeHeight[Cell];
    const float Up = BakeUp[Cell];
    const float Crust = BakeCrust[Cell];
    const float Half = 0.5f * max(SolveRampWidth, 1.0f);
    const float Lo = SolvePlainsUplift - Half;
    FVoxelSolveSetup S;
    // Continental crust, and any crust the profile lifts above the sea (an arc's ocean-side
    // flank, an island arc): left out, such land kept its full profile height beside the
    // eroded range, a wall up to kilometres high along the coast.
    const float CrustRamp = smoothstep(0.45f, 0.55f, Crust);
    const float LandRamp = smoothstep(0.0f, VOXEL_SOLVE_LAND_RAMP, H);
    const float Solid = 1.0f - (1.0f - CrustRamp) * (1.0f - LandRamp);   // a smooth union
    S.Mix = Solid * smoothstep(Lo, SolvePlainsUplift + Half, Up);
    // The uplift the solve takes over (T4b): all of it above the range front, less a part that
    // stays in the static surface: Up - g(Up), g = Up up to Lo, then easing to Lo + Half (the
    // plains uplift threshold) as Lo + Half (1 - e^(-(Up - Lo) / Half)), with slope 1 at Lo.
    // (S.Uplift below still uses Mix x (Up - Lo); model 1 normalises it, so only its shape counts.)
    // So the static surface rises monotonically from the plains into the range. (T1's Up x Mix
    // took the whole profile out within the ramp: the static surface rose with the uplift to
    // about 280 m over the base at the ramp's start, then fell back to the base under the
    // range, a ridge with a moat behind it all along every range front, which turned the
    // ranges' rivers to run along it instead of out onto the plains.)
    // Lo is floored at 0 (a plains threshold under half the ramp would otherwise make Kept
    // negative at zero uplift, taking height off land with none); W is then the easing's
    // width, Half at the defaults.
    const float Lo0 = max(Lo, 0.0f);
    const float W = max(SolvePlainsUplift - Lo0, 1.0f);
    const float Kept = Up <= Lo0 ? Up : Lo0 + W * (1.0f - exp(-(Up - Lo0) / W));
    const float Solved = Solid * (Up - Kept);
    S.Static = H - Solved;
    // The landform (T2): flat plains erode flatter, hill country deeper: 0.3 at hilliness 0, 1
    // at 0.4 (about the plains' mean), 2.05 at 1; SolveLandformErosion 0 leaves 1.
    const float Hilliness = float(BakeForm[Cell] & 0xffu) * (1.0f / 255.0f);
    const float FormScale = lerp(1.0f, 0.3f + 1.75f * Hilliness, SolveLandformErosion);
    if (SolveModel == 1u && SolveUndulation > 0.0f && H > 0.0f)
    {
        // The static surface's undulation (T1b): the plate profile is a smooth ramp between
        // its belts and coasts, and the solve keeps it, so every river on a ramp ran straight
        // down it beside its neighbours. Rolling ground at a third of the variation wavelength
        // and below gives the drainage hollows to gather in. It moves the static surface by at
        // most 70% of its height either way, so the coastline stays the plate model's with no
        // step at it, and the coastal ramps, where the straight runs were longest, undulate.
        // Band-limited to the bake: at least 6 cells for the coarsest scale, and no finer one
        // under 3 cells (finer noise would be pits, so lakes, at every few cells).
        const float CellM = VOXEL_SOLVE_HALF_PI / float(SolveN) * SolveRadiusM;
        const float Wavelength = max(SolveVariationWavelength * (1.0f / 3.0f), 6.0f * CellM);
        const uint Octaves = uint(clamp(floor(log2(Wavelength / (3.0f * CellM))) + 1.0f, 1.0f, 3.0f));
        const float3 Dir = VoxelSolveCellDirection(Cell);
        const float Undulation = SolveUndulation * FormScale * Solid * VoxelSolveFbm(Dir, Wavelength, Octaves, 5u);
        const float Bound = 0.7f * max(S.Static, 0.0f);
        S.Static += clamp(Undulation, -Bound, Bound);
    }
    S.Target = Solved;
    S.Uplift = S.Mix * max(Up - Lo, 0.0f) / max(SolveUpliftTime, 1.0f);
    S.bMoving = S.Mix > 0.0f;
    if (SolveModel == 1u && SolvePlainsRelief > 0.0f)
    {
        // The plains join with a small uplift of their own: drained valleys and interfluves on
        // the static surface.
        const float Land = Solid * smoothstep(0.0f, 100.0f, H) * (1.0f - S.Mix);
        S.Uplift += SolvePlainsRelief * FormScale * Land / max(SolveUpliftTime, 1.0f);
        S.bMoving = S.bMoving || Land > 0.0f;
    }
    S.bMoving = S.bMoving && VoxelSolveIsInterior(VoxelSolveDecode(Cell));
    return S;
}

/** Whether a cell is in a domain: 0 the solve (mountain cells), 1 the routing (land cells,
 *  after the solve), 2 none. */
VOXEL_FUNC bool VoxelSolveInDomain(uint Cell, uint Which)
{
    if (Which > 1u || !VoxelSolveIsInterior(VoxelSolveDecode(Cell))) return false;
    if (Which == 0u) return VoxelSolveSetupOf(Cell).bMoving;
    return SolveH[Cell] > 0.0f;
}

// --- Passes ------------------------------------------------------------------------------

/** Every cell, once SolveSlot and SlotCell are set for the solve domain: the solve's start.
 *  Solved cells start at their static height (with a few metres of noise, which breaks the
 *  grid's symmetry) and no water level; the others are fixed at max(static, 0), so valleys
 *  never cut below the sea. */
VOXEL_FUNC void VoxelSolveInitPass(uint Cell)
{
    if (Cell >= VoxelSolveNumCells()) return;
    SolveRec[Cell] = Cell;
    if (!VoxelSolveIsInterior(VoxelSolveDecode(Cell)))
    {
        SolveH[Cell] = 0.0f;
        SolveW[Cell] = VOXEL_SOLVE_INF;
        return;
    }
    const FVoxelSolveSetup S = VoxelSolveSetupOf(Cell);
    const uint Slot = SolveSlot[Cell];
    if (Slot == VOXEL_SOLVE_NONE)
    {
        SolveH[Cell] = max(S.Static, 0.0f);
        SolveW[Cell] = max(S.Static, 0.0f);
        return;
    }
    const float3 Dir = VoxelSolveCellDirection(Cell);
    float Rough = 8.66f * VoxelSolveNoise(Cell);
    if (SolveRoughness > 0.0f)
        Rough += SolveRoughness * VoxelSolveFbm(Dir, 0.25f * SolveVariationWavelength, 4u, 3u);
    SolveH[Cell] = S.Static + Rough;
    SolveW[Cell] = VOXEL_SOLVE_INF;
    float Uplift = S.Uplift;
    if (SolveUpliftVariation > 0.0f)
        Uplift *= max(0.0f, 1.0f + SolveUpliftVariation * VoxelSolveFbm(Dir, SolveVariationWavelength, 3u, 1u));
    SlotU[Slot] = Uplift;
    SlotK[Slot] = VoxelSolveErodibility(Dir);
    SlotAc[Slot] = VoxelSolveChannelFactor(Dir);
    SlotArea[Slot] = VoxelSolveCellArea(Cell);
    SlotA[Slot] = SlotArea[Slot];
}

/** Whether the fills randomise their descent (T1b): with the receivers' random choice. */
VOXEL_FUNC bool VoxelSolveRandomFill(float Eps)
{
    return SolveRouteNoise > 0.0f && Eps > 0.0f;
}

/** The fill's descent into Cell from its neighbour C (m): Eps, or with VoxelSolveRandomFill,
 *  Eps times the step's length in cells (diagonals, C = 0, 2, 5 or 7, the square root of 2;
 *  across a face's edge too) and the cell's fixed random factor (VoxelSolveFillFactor).
 *  A filled flat drains along the least total descent to its outlet. With Eps per cell that
 *  is the fewest steps (the chessboard distance): every path of a flat's quarter funnels into
 *  the one diagonal from the outlet, so each flat drained by a dead straight diagonal channel,
 *  which the erosion then cut and kept (the long straight runs on range flanks). The step's
 *  length makes the descent's metric near Euclidean, and the random factors make the least
 *  paths a branching, wandering tree (first-passage percolation) (Design/SurfaceLook.md). */
VOXEL_FUNC float VoxelSolveFillDescent(float Factor, uint C)
{
    return (C == 0u || C == 2u || C == 5u || C == 7u) ? Factor * 1.41421356f : Factor;
}

/** A cell's descent per cell of step (m): Eps, or with VoxelSolveRandomFill, Eps times a fixed
 *  random factor of the cell between 2^(-e) and 2^e, e = 2 SolveRouteNoise at most 2 (the
 *  least descent, Eps / 4, stays a few float steps at the highest summits' levels). */
VOXEL_FUNC float VoxelSolveFillFactor(uint Cell, float Eps)
{
    if (!VoxelSolveRandomFill(Eps)) return Eps;
    const uint H = VoxelSolveHash(Cell ^ VoxelSolveHash(SolveSeed + 0x3c6ef372u));
    const float U = float(H >> 8u) * (2.0f / 16777216.0f) - 1.0f;
    return Eps * exp2(min(2.0f * SolveRouteNoise, 2.0f) * U);
}

/** The descent into Cell from its receiver Rec (a neighbour): finds Rec's neighbour index. */
VOXEL_FUNC float VoxelSolveFillDescentTo(uint Cell, uint Rec, float Eps)
{
    if (!VoxelSolveRandomFill(Eps)) return Eps;
    const float Factor = VoxelSolveFillFactor(Cell, Eps);
    for (uint c = 0u; c < 8u; c++)
    {
        if (VoxelSolveNeighbour(Cell, c) == Rec)
            return VoxelSolveFillDescent(Factor, c);
    }
    return Factor;
}

/** The lowest neighbour's water level plus the descent from it (the fill's candidate). */
VOXEL_FUNC float VoxelSolveFillFloor(uint Cell, float Eps)
{
    const bool bRandom = VoxelSolveRandomFill(Eps);
    const float Factor = VoxelSolveFillFactor(Cell, Eps);
    float Lowest = VOXEL_SOLVE_INF;
    for (uint c = 0u; c < 8u; c++)
    {
        const uint N = VoxelSolveNeighbour(Cell, c);
        if (N != VOXEL_SOLVE_NONE)
            Lowest = min(Lowest, SolveW[N] + (bRandom ? VoxelSolveFillDescent(Factor, c) : Eps));
    }
    return Lowest;
}

/** Planchon-Darboux, in place: a slot's water level drops to max(its height, the lowest
 *  neighbour's level + Eps). From levels above the result it converges to the least surface
 *  that drains every cell by at least Eps per cell (the priority flood's), whatever the order;
 *  SolveFlags[0] is set while anything changes. */
VOXEL_FUNC void VoxelSolveFillInPlacePass(uint Slot, uint NumSlots, float Eps)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const float Candidate = max(SolveH[Cell], VoxelSolveFillFloor(Cell, Eps));
    if (Candidate < SolveW[Cell])
    {
        SolveW[Cell] = Candidate;
        InterlockedOr(SolveFlags[0], 1u);
    }
}

/** The same, double-buffered (into SlotWOut; VoxelSolveFillCopyPass writes it back): a fixed
 *  number of these is reproducible. Any number keeps the surface draining. */
VOXEL_FUNC void VoxelSolveFillJacobiPass(uint Slot, uint NumSlots, float Eps)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const float Candidate = max(SolveH[Cell], VoxelSolveFillFloor(Cell, Eps));
    SlotWOut[Slot] = min(SolveW[Cell], Candidate);
}

VOXEL_FUNC void VoxelSolveFillCopyPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    SolveW[SlotCell[Slot]] = SlotWOut[Slot];
}

/** After the initial fill: a cell it couldn't drain (a region with no fixed cell around it)
 *  is fixed at its height. */
VOXEL_FUNC void VoxelSolveUndrainedPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    if (SolveW[Cell] < 0.5f * VOXEL_SOLVE_INF) return;
    SolveW[Cell] = SolveH[Cell];
    InterlockedOr(SolveFlags[1], VOXEL_SOLVE_ERROR_UNDRAINED);
}

/** Each slot's receiver: the steepest descent on the water level (ties to the lower neighbour
 *  index), and its distance. bFill: the height becomes the water level (the depressions fill
 *  with sediment), and SlotH0 keeps it. */
VOXEL_FUNC void VoxelSolveReceiversPass(uint Slot, uint NumSlots, bool bFill)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const float W = SolveW[Cell];
    const float3 Dir = VoxelSolveNodeDirection(Cell);
    float Best = 0.0f;
    uint Rec = Cell;
    float Dist = 1.0f;
    for (uint c = 0u; c < 8u; c++)
    {
        const uint N = VoxelSolveNeighbour(Cell, c);
        if (N == VOXEL_SOLVE_NONE) continue;
        const float D = VoxelSolveDistance(Dir, VoxelSolveNodeDirection(N));
        const float Slope = (W - SolveW[N]) / D * VoxelSolveRouteWeight(Cell, c);
        if (Slope > Best)
        {
            Best = Slope;
            Rec = N;
            Dist = D;
        }
    }
    if (Rec == Cell)
        InterlockedOr(SolveFlags[1], VOXEL_SOLVE_ERROR_NO_RECEIVER);
    SolveRec[Cell] = Rec;
    SlotDist[Slot] = Dist;
    if (bFill)
    {
        // Filled with sediment at once (SolveFillDepressions), or left for the implicit update
        // to raise toward the spill while the outlet erodes: a basin drains through a cut sill
        // instead of turning into one flat sediment plain.
        if (SolveFillDepressions != 0u)
            SolveH[Cell] = W;
        SlotH0[Slot] = SolveH[Cell];
    }
}

/** A slot's drainage area from its donors' (the neighbours that drain into it, in neighbour
 *  order, so the sum is reproducible). */
VOXEL_FUNC float VoxelSolveDrainage(uint Slot)
{
    const uint Cell = SlotCell[Slot];
    float A = SlotArea[Slot];
    for (uint c = 0u; c < 8u; c++)
    {
        const uint N = VoxelSolveNeighbour(Cell, c);
        if (N == VOXEL_SOLVE_NONE || SolveRec[N] != Cell) continue;
        const uint S = SolveSlot[N];
        if (S != VOXEL_SOLVE_NONE)
            A += SlotA[S];
    }
    return A;
}

/** Drainage accumulation, double-buffered (SlotA into SlotAOut). In the solve a fixed number
 *  run per step from the previous step's areas: a change of receivers reaches downstream a
 *  number of cells per step, and the areas are exact once the routing settles. */
VOXEL_FUNC void VoxelSolveAccumulateJacobiPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    SlotAOut[Slot] = VoxelSolveDrainage(Slot);
}

/** The same in place, until nothing changes (the routing's exact areas). */
VOXEL_FUNC void VoxelSolveAccumulateInPlacePass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const float A = VoxelSolveDrainage(Slot);
    if (A != SlotA[Slot])
    {
        SlotA[Slot] = A;
        InterlockedOr(SolveFlags[0], 1u);
    }
}

// Pointer jumping over the receiver forest. A record is (X, Y, P): P the next slot on the
// path, VOXEL_SOLVE_NONE once the record reaches a fixed cell; each round composes a record
// with its next one's (JumpX/Y/P into JumpXOut/YOut/POut), so after k rounds it spans 2^k
// cells of its path.

/** The fill along the previous receivers: W_i = max(h_i, W_r + Eps), as a record (c, k) for
 *  W = max(c, W_next + k Eps) (with VoxelSolveRandomFill, (c, e) for W = max(c, W_next + e),
 *  e the descents' sum in metres, as float bits). Composes to the level the old tree gives every cell, which
 *  drains, so the receivers stay valid however the heights moved. */
VOXEL_FUNC void VoxelSolveTreeFillInitPass(uint Slot, uint NumSlots, float Eps)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Rec = SolveRec[Cell];
    const float H = SolveH[Cell];
    const uint Next = Rec == Cell ? VOXEL_SOLVE_NONE : SolveSlot[Rec];
    if (Rec == Cell)
    {
        JumpX[Slot] = H;
        JumpY[Slot] = 0u;
        JumpP[Slot] = VOXEL_SOLVE_NONE;
    }
    else if (Next == VOXEL_SOLVE_NONE)
    {
        JumpX[Slot] = max(H, SolveW[Rec] + VoxelSolveFillDescentTo(Cell, Rec, Eps));
        JumpY[Slot] = 0u;
        JumpP[Slot] = VOXEL_SOLVE_NONE;
    }
    else
    {
        JumpX[Slot] = H;
        // The descent to the next cell: a count of Eps, or the random fill's metres (as bits).
        JumpY[Slot] = VoxelSolveRandomFill(Eps) ? asuint(VoxelSolveFillDescentTo(Cell, Rec, Eps)) : 1u;
        JumpP[Slot] = Next;
    }
}

VOXEL_FUNC void VoxelSolveTreeFillJumpPass(uint Slot, uint NumSlots, float Eps)
{
    if (Slot >= NumSlots) return;
    const uint P = JumpP[Slot];
    if (P == VOXEL_SOLVE_NONE)
    {
        JumpXOut[Slot] = JumpX[Slot];
        JumpYOut[Slot] = JumpY[Slot];
        JumpPOut[Slot] = P;
        return;
    }
    if (VoxelSolveRandomFill(Eps))
    {
        const float E = asfloat(JumpY[Slot]);
        JumpXOut[Slot] = max(JumpX[Slot], JumpX[P] + E);
        JumpYOut[Slot] = asuint(E + asfloat(JumpY[P]));
    }
    else
    {
        const uint K = JumpY[Slot];
        JumpXOut[Slot] = max(JumpX[Slot], JumpX[P] + float(K) * Eps);
        JumpYOut[Slot] = K + JumpY[P];
    }
    JumpPOut[Slot] = JumpP[P];
}

VOXEL_FUNC void VoxelSolveTreeFillFinishPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    if (JumpP[Slot] != VOXEL_SOLVE_NONE)
    {
        InterlockedOr(SolveFlags[1], VOXEL_SOLVE_ERROR_JUMP);
        return;
    }
    SolveW[SlotCell[Slot]] = JumpX[Slot];
}

/** The implicit stream-power update (Braun & Willett 2013, n = 1, m = 0.5) as an affine map of
 *  the receiver's new height, h_i = a + b h_r, with a = (h + U dt) / (1 + F), b = F / (1 + F),
 *  F = K dt sqrt(A) / d. Composed along the path, every cell's new height comes from its
 *  fixed outlet's (Y holds b's bits). */
VOXEL_FUNC void VoxelSolveImplicitInitPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Rec = SolveRec[Cell];
    const float H = SolveH[Cell];
    const float Raised = H + SlotU[Slot] * SolveDt;
    if (Rec == Cell)
    {
        JumpX[Slot] = Raised;
        JumpY[Slot] = asuint(0.0f);
        JumpP[Slot] = VOXEL_SOLVE_NONE;
        return;
    }
    // T3g: below the channel heads, no incision (VoxelSolveChannelRamp; 1 when off).
    const float F = SolveKdt * SlotK[Slot] * sqrt(SlotA[Slot]) / max(SlotDist[Slot], 1.0f) * VoxelSolveChannelRamp(Slot);
    const uint Next = SolveSlot[Rec];
    if (Next == VOXEL_SOLVE_NONE)
    {
        JumpX[Slot] = (Raised + F * SolveW[Rec]) / (1.0f + F);
        JumpY[Slot] = asuint(0.0f);
        JumpP[Slot] = VOXEL_SOLVE_NONE;
        return;
    }
    JumpX[Slot] = Raised / (1.0f + F);
    JumpY[Slot] = asuint(F / (1.0f + F));
    JumpP[Slot] = Next;
}

VOXEL_FUNC void VoxelSolveImplicitJumpPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint P = JumpP[Slot];
    if (P == VOXEL_SOLVE_NONE)
    {
        JumpXOut[Slot] = JumpX[Slot];
        JumpYOut[Slot] = JumpY[Slot];
        JumpPOut[Slot] = P;
        return;
    }
    const float B = asfloat(JumpY[Slot]);
    JumpXOut[Slot] = JumpX[Slot] + B * JumpX[P];
    JumpYOut[Slot] = asuint(B * asfloat(JumpY[P]));
    JumpPOut[Slot] = JumpP[P];
}

/** Model 1's incision floor applied to a new height: rivers may cut deeper the more they drain
 *  (a cell draining 100 cells the incision, ten times that at 10,000): they cut through the
 *  sills, so basins drain, while the land between them (a cell's own drainage: a tenth) keeps
 *  near its static surface. */
VOXEL_FUNC float VoxelSolveIncisionFloor(uint Slot, uint Cell, float H)
{
    if (SolveModel != 1u) return H;
    const float Allow = SolveIncision * sqrt(SlotA[Slot] / (100.0f * SlotArea[Slot]));
    const float Static = VoxelSolveSetupOf(Cell).Static;
    return max(H, Static > 0.0f ? max(Static - Allow, 0.0f) : Static);
}

/** The new height, and its change from the filled height (for the residual; with the channel
 *  heads on, the slope cap follows and its finish gives the change instead). */
VOXEL_FUNC float VoxelSolveImplicitFinishPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return 0.0f;
    if (JumpP[Slot] != VOXEL_SOLVE_NONE)
    {
        InterlockedOr(SolveFlags[1], VOXEL_SOLVE_ERROR_JUMP);
        return 0.0f;
    }
    const uint Cell = SlotCell[Slot];
    const float H = VoxelSolveIncisionFloor(Slot, Cell, JumpX[Slot]);
    SolveH[Cell] = H;
    return abs(H - SlotH0[Slot]);
}

/** T3g: the hillslopes' threshold, h_i = min(h_i, h_r + C_i) (C_i VoxelSolveCapRise) along the
 *  receivers from the outlets up, after the implicit update. As a record (P, C) for
 *  h = min(P, h_next + C) it composes like the tree fill: min(P, min(P', h'' + C') + C) =
 *  min(min(P, P' + C), h'' + (C + C')) (Y holds C's bits). Lowering a receiver never puts a
 *  cell below it, so the cells still drain (but for the incision floor the finish applies
 *  again, which can leave a cell under its receiver's floor: a pit the next step's fill takes). */
VOXEL_FUNC void VoxelSolveCapInitPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Rec = SolveRec[Cell];
    const float H = SolveH[Cell];
    JumpY[Slot] = asuint(0.0f);
    JumpP[Slot] = VOXEL_SOLVE_NONE;
    if (Rec == Cell)
    {
        JumpX[Slot] = H;
        return;
    }
    const float C = VoxelSolveCapRise(Slot);
    const uint Next = SolveSlot[Rec];
    if (Next == VOXEL_SOLVE_NONE)
    {
        JumpX[Slot] = min(H, SolveW[Rec] + C);
        return;
    }
    JumpX[Slot] = H;
    JumpY[Slot] = asuint(C);
    JumpP[Slot] = Next;
}

VOXEL_FUNC void VoxelSolveCapJumpPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint P = JumpP[Slot];
    if (P == VOXEL_SOLVE_NONE)
    {
        JumpXOut[Slot] = JumpX[Slot];
        JumpYOut[Slot] = JumpY[Slot];
        JumpPOut[Slot] = P;
        return;
    }
    const float C = asfloat(JumpY[Slot]);
    JumpXOut[Slot] = min(JumpX[Slot], JumpX[P] + C);
    JumpYOut[Slot] = asuint(C + asfloat(JumpY[P]));
    JumpPOut[Slot] = JumpP[P];
}

/** The capped height (the incision floor again: the static surface stays), and its change
 *  from the filled height (for the residual). */
VOXEL_FUNC float VoxelSolveCapFinishPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return 0.0f;
    if (JumpP[Slot] != VOXEL_SOLVE_NONE)
    {
        InterlockedOr(SolveFlags[1], VOXEL_SOLVE_ERROR_JUMP);
        return 0.0f;
    }
    const uint Cell = SlotCell[Slot];
    const float H = VoxelSolveIncisionFloor(Slot, Cell, JumpX[Slot]);
    SolveH[Cell] = H;
    return abs(H - SlotH0[Slot]);
}

/** Each solved cell's outlet: the level of the fixed cell its path ends at (JumpX). */
VOXEL_FUNC void VoxelSolveOutletInitPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Rec = SolveRec[Cell];
    const uint Next = Rec == Cell ? VOXEL_SOLVE_NONE : SolveSlot[Rec];
    JumpX[Slot] = Rec == Cell ? SolveH[Cell] : (Next == VOXEL_SOLVE_NONE ? SolveW[Rec] : 0.0f);
    JumpY[Slot] = 0u;
    JumpP[Slot] = Next;
}

VOXEL_FUNC void VoxelSolveOutletJumpPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint P = JumpP[Slot];
    JumpYOut[Slot] = 0u;
    if (P == VOXEL_SOLVE_NONE)
    {
        JumpXOut[Slot] = JumpX[Slot];
        JumpPOut[Slot] = P;
        return;
    }
    JumpXOut[Slot] = JumpX[P];
    JumpPOut[Slot] = JumpP[P];
}

/** A solved cell's relief above its outlet, and the relief the profile asks for there (the
 *  normalisation's two distributions). */
struct FVoxelSolveRelief
{
    float Solved;
    float Target;
    bool bCounted;      // in the histograms: model 1 counts the mountains (the plains' relief
                        // is their own, not the profile's)
};

VOXEL_FUNC FVoxelSolveRelief VoxelSolveReliefOf(uint Slot)
{
    const uint Cell = SlotCell[Slot];
    FVoxelSolveRelief R;
    const FVoxelSolveSetup S = VoxelSolveSetupOf(Cell);
    // Model 1: the mass above the static surface (above the sea where that is under it: the
    // solve never made the water column); else the relief above the outlet.
    R.Solved = max(SolveH[Cell] - (SolveModel == 1u ? max(S.Static, 0.0f) : JumpX[Slot]), 0.0f);
    // Model 1 measures both above the sea where the static surface is under it.
    R.Target = SolveModel == 1u ? max(BakeHeight[Cell], 0.0f) - max(S.Static, 0.0f) : S.Target;
    R.bCounted = SolveModel != 1u || S.Mix >= 0.5f;
    return R;
}

/** The scaled relief above the knee eases toward the top (slope 1 at the knee, never above
 *  the top): the solve's relief has a longer tail than the profile's (long paths across a
 *  wide belt keep adding height), and this keeps the peaks near the profile's highest. It is
 *  increasing, so every path still descends. */
VOXEL_FUNC float VoxelSolveCompressRelief(float R)
{
    if (R <= SolveReliefKnee) return R;
    // Model 1: a logarithm above the knee, K + s ln(1 + (R - K) / s), s fitted on the CPU so
    // the 99.9th percentile lands on the top: slope 1 at the knee, 1 / (1 + (R - K) / s)
    // above; the few above the top ease within 15% over it. (The easing below flattened all
    // high ground: slope 1 / (1 + x)^2, equal summits, plateaus.)
    if (SolveReliefScale > 0.0f)
    {
        // ln(1 + y), stable for small y (a large scale: nearly linear, and a plain float log
        // of 1 + y would step by 1.2e-7 of the scale).
        const float Y = (R - SolveReliefKnee) / SolveReliefScale;
        const float U = 1.0f + Y;
        const float Log1p = U == 1.0f ? Y : log(U) * Y / (U - 1.0f);
        float Mapped = SolveReliefKnee + SolveReliefScale * Log1p;
        if (Mapped > SolveReliefTop)
        {
            const float Span = 0.15f * max(SolveReliefTop, 1.0f);
            const float Over = (Mapped - SolveReliefTop) / Span;
            Mapped = SolveReliefTop + Span * Over / (1.0f + Over);
        }
        return Mapped;
    }
    const float Span = max(SolveReliefTop - SolveReliefKnee, 1.0f);
    const float X = (R - SolveReliefKnee) / Span;
    return SolveReliefKnee + Span * X / (1.0f + X);
}

/** Every interior cell: the bake's height after the solve. A solved cell's relief above its
 *  outlet is scaled by SolveFactor (and eased above the knee); the others take their static
 *  height (the sea floor too: the solve held it at 0 only as a base level). */
VOXEL_FUNC void VoxelSolveNormalisePass(uint Cell)
{
    if (Cell >= VoxelSolveNumCells()) return;
    if (!VoxelSolveIsInterior(VoxelSolveDecode(Cell))) return;
    const uint Slot = SolveSlot[Cell];
    if (Slot == VOXEL_SOLVE_NONE)
    {
        SolveH[Cell] = VoxelSolveSetupOf(Cell).Static;
        return;
    }
    if (SolveModel == 1u)
    {
        // The static surface (the sea where that is under it), the mass above it scaled (by the
        // mountains' factor, fading to 1 over the range-front ramp: the plains keep their own
        // relief), the cuts below it as they are. Not monotone along every path where the
        // static surface changes: VoxelSolveSettlePass follows.
        const FVoxelSolveSetup S = VoxelSolveSetupOf(Cell);
        const float Ref = max(S.Static, 0.0f);
        const float E = SolveH[Cell] - Ref;
        SolveH[Cell] = Ref + (E > 0.0f ? VoxelSolveCompressRelief(lerp(1.0f, SolveFactor, S.Mix) * E) : E);
        return;
    }
    const float Outlet = JumpX[Slot];
    SolveH[Cell] = Outlet + VoxelSolveCompressRelief(SolveFactor * max(SolveH[Cell] - Outlet, 0.0f));
}

/** Model 1, before the normalisation: whether a solved cell's link to its receiver goes
 *  uphill already (a basin behind a sill the rivers couldn't cut: a lake), into SlotWOut
 *  (free until the routing). The settle leaves those alone. */
VOXEL_FUNC void VoxelSolveSettleMarkPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Rec = SolveRec[Cell];
    SlotWOut[Slot] = Rec != Cell && SolveH[Rec] > SolveH[Cell] ? 1.0f : 0.0f;
}

/** The settle's tree fill (VoxelSolveTreeFillInitPass, then its jump and finish passes):
 *  W = max(h, W_r + Eps) along the last step's receivers, except across a link that went
 *  uphill before the normalisation (marked), where the path stops. */
VOXEL_FUNC void VoxelSolveSettleInitPass(uint Slot, uint NumSlots, float Eps)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Rec = SolveRec[Cell];
    const float H = SolveH[Cell];
    const uint Next = Rec == Cell ? VOXEL_SOLVE_NONE : SolveSlot[Rec];
    if (Rec == Cell || SlotWOut[Slot] > 0.5f)
    {
        JumpX[Slot] = H;
        JumpY[Slot] = 0u;
        JumpP[Slot] = VOXEL_SOLVE_NONE;
    }
    else if (Next == VOXEL_SOLVE_NONE)
    {
        JumpX[Slot] = max(H, SolveW[Rec] + VoxelSolveFillDescentTo(Cell, Rec, Eps));
        JumpY[Slot] = 0u;
        JumpP[Slot] = VOXEL_SOLVE_NONE;
    }
    else
    {
        JumpX[Slot] = H;
        JumpY[Slot] = VoxelSolveRandomFill(Eps) ? asuint(VoxelSolveFillDescentTo(Cell, Rec, Eps)) : 1u;
        JumpP[Slot] = Next;
    }
}

/** Model 1, after the normalisation and the settle's tree fill: each solved cell rises to its
 *  level, at least its receiver's plus Eps, so the scaling (relative to each cell's static
 *  surface) adds no step uphill along a path (those were lakes no sill made). */
VOXEL_FUNC void VoxelSolveSettlePass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    SolveH[Cell] = max(SolveH[Cell], SolveW[Cell]);
}

/** Every cell, once SolveSlot and SlotCell are set for the routing domain: land cells start
 *  with no water level and their own area; the sea is fixed at 0. Bit 0 of Mode: the second
 *  fill (with descent), which keeps the first's lake levels in SolveWater. Bit 1: the receivers
 *  stay (the solve's last step's: VoxelSolveRouteTreeInitPass starts the fills from them, S1);
 *  else every cell starts as its own. */
VOXEL_FUNC void VoxelSolveRouteInitPass(uint Cell, uint Mode)
{
    if (Cell >= VoxelSolveNumCells()) return;
    const uint Slot = SolveSlot[Cell];
    const bool bInterior = VoxelSolveIsInterior(VoxelSolveDecode(Cell));
    if ((Mode & 1u) != 0u)
    {
        SolveWater[Cell] = SolveW[Cell];
        if (Slot != VOXEL_SOLVE_NONE)
            SolveW[Cell] = VOXEL_SOLVE_INF;
        return;
    }
    if ((Mode & 2u) == 0u)
        SolveRec[Cell] = Cell;
    SolveLabel[Cell] = VOXEL_SOLVE_NONE;
    if (!bInterior)
    {
        SolveW[Cell] = VOXEL_SOLVE_INF;
        return;
    }
    if (Slot == VOXEL_SOLVE_NONE)
    {
        SolveW[Cell] = max(SolveH[Cell], 0.0f);
        return;
    }
    SolveW[Cell] = VOXEL_SOLVE_INF;
    SlotArea[Slot] = VoxelSolveCellArea(Cell);
    SlotA[Slot] = SlotArea[Slot];
}

/** S1: the routing fills' start, an upper bound from the solve's last receivers (still in
 *  SolveRec: VoxelSolveRouteInitPass with bit 1). Along them, W = max(h, W_r + the descent): a
 *  surface that drains by construction, so it lies above the least one, and the fill
 *  (Planchon-Darboux from above, VoxelSolveFillTiled) lowers it to that in a few passes where
 *  the tree was the best way out, which is nearly everywhere. (With a descent, the jumps add the
 *  descents in another order than the fill does, so a start can round an ulp under the fill's
 *  level; the fill then keeps it: a surface that still drains by its descents, reproduced
 *  whatever the passes' order, an ulp off the fill from infinity. Without, it is exact.) From no
 *  start (infinity) the
 *  levels had to arrive from the coast, a thousand passes inland. A cell without a receiver
 *  there (not solved, or the routing's no-receiver case) starts at infinity, and so does
 *  everything draining through it. As a record for VoxelSolveTreeFillJumpPass, then
 *  VoxelSolveTreeFillFinishPass writes the levels. */
VOXEL_FUNC void VoxelSolveRouteTreeInitPass(uint Slot, uint NumSlots, float Eps)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Rec = SolveRec[Cell];
    const float H = SolveH[Cell];
    JumpY[Slot] = 0u;
    JumpP[Slot] = VOXEL_SOLVE_NONE;
    if (Rec == Cell || Rec >= VoxelSolveNumCells())
    {
        JumpX[Slot] = VOXEL_SOLVE_INF;
        return;
    }
    const uint Next = SolveSlot[Rec];
    if (Next == VOXEL_SOLVE_NONE)
    {
        const float WR = SolveW[Rec];
        JumpX[Slot] = WR < 0.5f * VOXEL_SOLVE_INF ? max(H, WR + VoxelSolveFillDescentTo(Cell, Rec, Eps)) : VOXEL_SOLVE_INF;
        return;
    }
    JumpX[Slot] = H;
    // The descent as VoxelSolveTreeFillJumpPass reads it (it decodes with SolveEps): a float's
    // bits with the random fill, else a count of SolveEps steps, none without a descent (0 reads
    // as no descent either way).
    JumpY[Slot] = VoxelSolveRandomFill(Eps) ? asuint(VoxelSolveFillDescentTo(Cell, Rec, Eps)) : (Eps > 0.0f ? 1u : 0u);
    JumpP[Slot] = Next;
}

/** A land cell below its lake level (the first fill, without descent) starts a lake label. */
VOXEL_FUNC void VoxelSolveLabelInitPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    SolveLabel[Cell] = SolveWater[Cell] > SolveH[Cell] + VOXEL_SOLVE_LAKE_MIN ? Cell : VOXEL_SOLVE_NONE;
}

/** Lake labels, in place until nothing changes: the lowest cell index among the connected
 *  depression cells of the same level. */
VOXEL_FUNC void VoxelSolveLabelPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Own = SolveLabel[Cell];
    if (Own == VOXEL_SOLVE_NONE) return;
    const float Level = SolveWater[Cell];
    uint Label = Own;
    for (uint c = 0u; c < 8u; c++)
    {
        const uint N = VoxelSolveNeighbour(Cell, c);
        if (N == VOXEL_SOLVE_NONE) continue;
        const uint L = SolveLabel[N];
        if (L != VOXEL_SOLVE_NONE && SolveWater[N] == Level)
            Label = min(Label, L);
    }
    if (Label < Own)
    {
        SolveLabel[Cell] = Label;
        InterlockedOr(SolveFlags[0], 1u);
    }
}

// --- The drainage field's spread (Design/SurfaceLook.md, T1b) --------------------------------
//
// The routing's D8 areas make every cell of a planar slope the head of its own line, so the
// drainage field (the rivers in the water views, the gullies' steering) shows combs of parallel
// lines a cell apart on every flank. The field is instead accumulated as Quinn et al. (1991,
// 1995) do: a hillslope cell (its D8 drainage under SolveSpreadCells cells) spreads its water
// over all its lower neighbours by slope^1.1 (Freeman 1991), a channel cell sends it all to its
// receiver. A slope then carries an even sheet, and lines start where the flow converges.
// The solve, the lakes and the receivers stay D8. After the routing's accumulation, on its
// receivers and fill:
//   float SolveSpreadCells;                     0: the field is the D8 areas
//   SlotAOut                                    the spread areas (m^2; the routing's other area
//                                               buffer, unused there)
//   SlotDist                                    a hillslope slot's 1 / its weights' sum (0 a
//                                               channel; the routing has no use for the
//                                               receivers' distances)

#define VOXEL_SOLVE_SPREAD_EXPONENT 1.1f

/** Whether a slot spreads (its D8 drainage under SolveSpreadCells of its own cell). */
VOXEL_FUNC bool VoxelSolveSpreads(uint Slot)
{
    return SlotA[Slot] < SolveSpreadCells * SlotArea[Slot];
}

/** The spread's weight from cell From (its routing level WFrom) to its neighbour To: the drop's
 *  slope^1.1, 0 unless To is lower. The same expression in both passes, so the fractions sum
 *  to one exactly as computed. */
VOXEL_FUNC float VoxelSolveSpreadWeight(uint From, float WFrom, uint To)
{
    const float Drop = WFrom - SolveW[To];
    if (!(Drop > 0.0f)) return 0.0f;
    const float D = VoxelSolveDistance(VoxelSolveNodeDirection(From), VoxelSolveNodeDirection(To));
    return pow(Drop / max(D, 1.0f), VOXEL_SOLVE_SPREAD_EXPONENT);
}

/** Each slot's own area, and a hillslope slot's normalisation (its weights over every lower
 *  neighbour, the sea's and the outside's included: that water leaves the land). */
VOXEL_FUNC void VoxelSolveSpreadInitPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    SlotAOut[Slot] = SlotArea[Slot];
    float Sum = 0.0f;
    if (VoxelSolveSpreads(Slot))
    {
        const float W = SolveW[Cell];
        for (uint c = 0u; c < 8u; c++)
        {
            const uint N = VoxelSolveNeighbour(Cell, c);
            if (N != VOXEL_SOLVE_NONE)
                Sum += VoxelSolveSpreadWeight(Cell, W, N);
        }
    }
    // No lower neighbour (a fixed cell): it keeps its water, as the D8 routing does.
    SlotDist[Slot] = Sum > 0.0f ? 1.0f / Sum : 0.0f;
}

/** The spread's inflow into a slot: its own area and its spreading neighbours' shares; with
 *  bChannels (a hillslope's, VoxelSolveSpreadPass), its channel donors too, which send all to
 *  their receiver. S1: a channel's spread total comes after the hillslopes' (by the jumps), so
 *  a hillslope takes a channel donor's D8 total, final by then. A receiver drains more than its
 *  donor, so this needs a hillslope below a channel, which the threshold's scaling with the
 *  cell's own area allows only for SolveSpreadCells near 1 / the neighbours' area change (some
 *  hundreds of cells); then it keeps the water, close enough. */
VOXEL_FUNC float VoxelSolveSpreadSum(uint Slot, bool bChannels)
{
    const uint Cell = SlotCell[Slot];
    float A = SlotArea[Slot];
    for (uint c = 0u; c < 8u; c++)
    {
        const uint N = VoxelSolveNeighbour(Cell, c);
        if (N == VOXEL_SOLVE_NONE) continue;
        const uint S = SolveSlot[N];
        if (S == VOXEL_SOLVE_NONE) continue;
        const float Norm = SlotDist[S];
        if (Norm > 0.0f)
            A += SlotAOut[S] * (VoxelSolveSpreadWeight(N, SolveW[N], Cell) * Norm);
        else if (bChannels && SolveRec[N] == Cell)
            A += SlotA[S];
    }
    return A;
}

/** The spread areas in place, until nothing changes (from the slots' own areas, they only
 *  grow toward the fixed point on the routing's acyclic fill, in neighbour order). S1: the
 *  spreading (hillslope) slots only: nothing flows into them from a channel, and their paths are
 *  short (a few dozen cells: the spread stops where the D8 drainage passes SolveSpreadCells), so
 *  this converges in tens of passes where the whole field took one per cell of its longest path;
 *  the channels then sum by pointer jumping (VoxelSolveAccJumpInitPass, Mode 1). */
VOXEL_FUNC void VoxelSolveSpreadPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    if (!(SlotDist[Slot] > 0.0f)) return;
    const float A = VoxelSolveSpreadSum(Slot, true);
    if (A != SlotAOut[Slot])
    {
        SlotAOut[Slot] = A;
        InterlockedOr(SolveFlags[0], 1u);
    }
}

/** The bake's drainage field: log2 of the drainage area (m^2; spread, with SolveSpreadCells), a
 *  cell's own off the land. */
VOXEL_FUNC float VoxelSolveFlowOf(uint Cell)
{
    const uint Slot = SolveSlot[Cell];
    // if/else, not ?: (HLSL evaluates both sides, and SlotA[NONE] is out of range).
    float A;
    if (Slot == VOXEL_SOLVE_NONE)
        A = VoxelSolveCellArea(Cell);
    else if (SolveSpreadCells > 0.0f)
        A = SlotAOut[Slot];
    else
        A = SlotA[Slot];
    return log2(max(A, 1.0f));
}

// --- Exact accumulation by pointer jumping (S1) -------------------------------------------
//
// A tree's upstream sums in 20 rounds of fixed passes, where the in-place iteration took one
// pass per cell of the longest path (a thousand at 1024 cells a face). Round k adds each slot's
// sum over the 2^k nodes above it (its window) into the node 2^k below it: the windows of the
// nodes exactly 2^k above a node tile its next 2^k, so after the rounds every node holds its
// whole upstream. The sums are integers (a 4096th of a cell, 64 bits as two words with the
// carry counted from the low word's atomic add), so the result doesn't depend on the order the
// GPU adds them in. Per slot: JumpY (low) and AccHi (high) with their Out halves, JumpP the
// jump; the solve job swaps them between rounds as the other jumps'.

/** A slot's start: Mode 0, its own area over the receiver tree (the routing's D8 drainage);
 *  Mode 1, the spread's channel slots, their inflow (own area and the hillslopes' shares; their
 *  channel donors come with the sums), over the channels' tree, the spreading slots standing
 *  aside (no channel drains into one: a channel's receiver drains more than it does). */
VOXEL_FUNC void VoxelSolveAccJumpInitPass(uint Slot, uint NumSlots, uint Mode)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint Rec = SolveRec[Cell];
    uint Next = Rec == Cell ? VOXEL_SOLVE_NONE : SolveSlot[Rec];
    float V = SlotArea[Slot];
    if (Mode == 1u)
    {
        if (SlotDist[Slot] > 0.0f)
        {
            V = 0.0f;
            Next = VOXEL_SOLVE_NONE;
        }
        else
        {
            V = VoxelSolveSpreadSum(Slot, false);
        }
    }
    JumpY[Slot] = uint(min(V / SolveAccUnit + 0.5f, 4.2e9f));
    AccHi[Slot] = 0u;
    JumpP[Slot] = Next;
}

/** A round's copy: the sums as they are, and the jumps doubled. */
VOXEL_FUNC void VoxelSolveAccJumpCopyPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    JumpYOut[Slot] = JumpY[Slot];
    AccHiOut[Slot] = AccHi[Slot];
    const uint P = JumpP[Slot];
    JumpPOut[Slot] = P != VOXEL_SOLVE_NONE ? JumpP[P] : VOXEL_SOLVE_NONE;
}

/** A round's adds (after the copy): each slot's window into the node its jump reaches. */
VOXEL_FUNC void VoxelSolveAccJumpAddPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint P = JumpP[Slot];
    if (P == VOXEL_SOLVE_NONE) return;
    const uint Lo = JumpY[Slot];
    uint Before = 0u;
    InterlockedAdd(JumpYOut[P], Lo, Before);
    const uint Hi = AccHi[Slot] + (Before + Lo < Before ? 1u : 0u);
    if (Hi != 0u)
        InterlockedAdd(AccHiOut[P], Hi);
}

/** The sums back to m^2: Mode 0 the D8 drainage (SlotA), Mode 1 the channel slots' spread
 *  drainage (SlotAOut; the spreading slots keep theirs). */
VOXEL_FUNC void VoxelSolveAccJumpFinishPass(uint Slot, uint NumSlots, uint Mode)
{
    if (Slot >= NumSlots) return;
    if (JumpP[Slot] != VOXEL_SOLVE_NONE)
        InterlockedOr(SolveFlags[1], VOXEL_SOLVE_ERROR_JUMP);
    const float V = (float(JumpY[Slot]) + float(AccHi[Slot]) * 4294967296.0f) * SolveAccUnit;
    if (Mode == 0u)
        SlotA[Slot] = V;
    else if (!(SlotDist[Slot] > 0.0f))
        SlotAOut[Slot] = V;
}

// --- Lakes and outputs (the routing's last frame) -----------------------------------------
//
//   RWStructuredBuffer<uint> LakeArea, LakeDepth, LakeOutlet;   per label cell: area (units of
//                                               1e4 m^2), deepest point (float bits), the
//                                               lowest index of a cell draining out of it
//   RWStructuredBuffer<uint> LakeCount, LakeList;   kept lakes: count, and 4 words each (cell,
//                                               level bits, outlet, area units), unordered
//   uint SolveMaxLakes;
//   StructuredBuffer<uint> BakeAttr;            the plate model's attributes
//   RWStructuredBuffer<float> OutHeight, OutWater;  RWStructuredBuffer<uint> OutAttr, OutForm, OutRec;
//   RWStructuredBuffer<uint> OutFlow;           the drainage as halves, two cells a word (cleared
//                                               first; R1b: the bake keeps halves, and the rivers'
//                                               build and the density read these words as they are)
//   float SolveChannelCharacter;                T3h: how far the drainage density pulls the
//                                               landform's character (VoxelSolveFormOf)

/** Every land cell under a lake label adds itself to its lake's area and depth; one draining
 *  out of the lake (its receiver outside it) offers itself as the outlet. */
VOXEL_FUNC void VoxelSolveLakeStatsPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint L = SolveLabel[Cell];
    if (L == VOXEL_SOLVE_NONE) return;
    InterlockedAdd(LakeArea[L], uint(SlotArea[Slot] * 1.0e-4f + 0.5f));
    InterlockedMax(LakeDepth[L], asuint(SolveWater[Cell] - SolveH[Cell]));
    const uint Rec = SolveRec[Cell];
    if (Rec != Cell && SolveLabel[Rec] != L)
        InterlockedMin(LakeOutlet[L], Cell);
}

VOXEL_FUNC bool VoxelSolveLakeKept(uint L)
{
    return float(LakeArea[L]) * 1.0e4f >= SolveMinLakeArea && asfloat(LakeDepth[L]) >= SolveMinLakeDepth;
}

/** A kept lake's cells keep their level in SolveWater (the lake's label cell lists it); the
 *  smaller depressions are filled to the routing's level, which drains them. */
VOXEL_FUNC void VoxelSolveLakeFinishPass(uint Slot, uint NumSlots)
{
    if (Slot >= NumSlots) return;
    const uint Cell = SlotCell[Slot];
    const uint L = SolveLabel[Cell];
    if (L == VOXEL_SOLVE_NONE)
    {
        SolveWater[Cell] = -VOXEL_SOLVE_INF;
        return;
    }
    if (!VoxelSolveLakeKept(L))
    {
        SolveWater[Cell] = -VOXEL_SOLVE_INF;
        SolveH[Cell] = SolveW[Cell];
        return;
    }
    if (L != Cell) return;
    uint Index = 0u;
    InterlockedAdd(LakeCount[0], 1u, Index);
    if (Index >= SolveMaxLakes) return;
    LakeList[Index * 4u] = Cell;
    LakeList[Index * 4u + 1u] = asuint(SolveWater[Cell]);
    LakeList[Index * 4u + 2u] = LakeOutlet[L];
    LakeList[Index * 4u + 3u] = LakeArea[L];
}

/** A cell's lake level, or -VOXEL_SOLVE_INF (off the land, or no kept lake). */
VOXEL_FUNC float VoxelSolveWaterOf(uint Cell)
{
    return SolveSlot[Cell] != VOXEL_SOLVE_NONE ? SolveWater[Cell] : -VOXEL_SOLVE_INF;
}

/** Every padded cell: the bake's fields. Apron cells take the neighbouring face's, at their
 *  own direction (heights and drainage bilinear, the lake level nearest), and keep their own
 *  plate attributes. */
VOXEL_FUNC void VoxelSolveOutputPass(uint Cell)
{
    if (Cell >= VoxelSolveNumCells()) return;
    const FVoxelSolveCell C = VoxelSolveDecode(Cell);
    float Height;
    float Flow;
    float Water;
    if (VoxelSolveIsInterior(C))
    {
        Height = SolveH[Cell];
        Flow = VoxelSolveFlowOf(Cell);
        Water = VoxelSolveWaterOf(Cell);
    }
    else
    {
        const FVoxelSolveLocation L = VoxelSolveLocate(VoxelSolveDirection(C.Face, C.I, C.J));
        const int MaxIndex = int(SolveN) - 1;
        const float FX = floor(L.X);
        const float FY = floor(L.Y);
        const float TX = saturate(L.X - FX);
        const float TY = saturate(L.Y - FY);
        const int I0 = clamp(int(FX), 0, MaxIndex);
        const int J0 = clamp(int(FY), 0, MaxIndex);
        const int I1 = clamp(int(FX) + 1, 0, MaxIndex);
        const int J1 = clamp(int(FY) + 1, 0, MaxIndex);
        const uint C00 = VoxelSolveEncode(L.Face, I0, J0);
        const uint C10 = VoxelSolveEncode(L.Face, I1, J0);
        const uint C01 = VoxelSolveEncode(L.Face, I0, J1);
        const uint C11 = VoxelSolveEncode(L.Face, I1, J1);
        Height = lerp(lerp(SolveH[C00], SolveH[C10], TX), lerp(SolveH[C01], SolveH[C11], TX), TY);
        Flow = lerp(lerp(VoxelSolveFlowOf(C00), VoxelSolveFlowOf(C10), TX), lerp(VoxelSolveFlowOf(C01), VoxelSolveFlowOf(C11), TX), TY);
        Water = VoxelSolveWaterOf(VoxelSolveCellOf(VoxelSolveDirection(C.Face, C.I, C.J)));
    }
    OutHeight[Cell] = Height;
    InterlockedOr(OutFlow[Cell >> 1u], (f32tof16(Flow) & 0xffffu) << ((Cell & 1u) * 16u));
    OutWater[Cell] = Water;
    OutAttr[Cell] = (BakeAttr[Cell] & ~VOXEL_SOLVE_LAKE_BIT) | (Water > -0.5f * VOXEL_SOLVE_INF ? VOXEL_SOLVE_LAKE_BIT : 0u);
    // Every cell at its own direction (the noise is on the sphere, so the aprons agree).
    OutForm[Cell] = VoxelSolveFormOf(Cell);
    // The final routing's receiver (R1, Design/RiversLakes.md: the rivers follow it): for the
    // routed (land) cells, none elsewhere and in the aprons.
    // (A cell without a lower neighbour keeps itself as its receiver in the routing, with the
    // error flag: none here.)
    OutRec[Cell] = VoxelSolveIsInterior(C) && SolveSlot[Cell] != VOXEL_SOLVE_NONE && SolveRec[Cell] != Cell ? SolveRec[Cell] : VOXEL_SOLVE_NONE;
}

#endif // VOXEL_LAND_SOLVE_USH
